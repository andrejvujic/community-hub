<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F1117"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1C1F2A"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#252836"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F0F2F7"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B0B8CC"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#3A4060"/>
