    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1C1F2A"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#3A4060"/>
    <SolidColorBrush x:Key="TabItemHoverBrush" Color="#252836"/>
