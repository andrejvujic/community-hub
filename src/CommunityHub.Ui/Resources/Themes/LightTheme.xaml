<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#EEF1F7"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#3A3A3A"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#C2C8D4"/>
    <SolidColorBrush x:Key="ItemBorderBrush" Color="#8A94A6"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#0055CC"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#003D99"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#D0D6E2"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#8A94A6"/>

    <SolidColorBrush x:Key="SelectedItemBrush" Color="#0055CC"/>
    <SolidColorBrush x:Key="SelectedItemForegroundBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="NavbarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavbarBorderBrush" Color="#C2C8D4"/>

    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#DDEEFF"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#A8CCEE"/>
    <SolidColorBrush x:Key="TabItemHoverBrush" Color="#C8E2F8"/>
    <SolidColorBrush x:Key="TabItemSelectedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabItemSelectedBorderBrush" Color="#0055CC"/>
    <SolidColorBrush x:Key="TabItemForegroundBrush" Color="#1A3A5C"/>
    <SolidColorBrush x:Key="TabItemSelectedForegroundBrush" Color="#0055CC"/>
</ResourceDictionary>