<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#E1E5F2"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1C1E21"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#606770"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#DDDFE2"/>
</ResourceDictionary>