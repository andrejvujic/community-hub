<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Apartments.ApartmentAccessRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Apartments"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      xmlns:query="clr-namespace:CommunityHub.Application.Helpers.Sorting;assembly=CommunityHub.Application"
      mc:Ignorable="d" 
      Title="Zahtjevi"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:StatusToIconCodeConverter x:Key="StatusToIconCodeConverter"/>
        <converters:StatusToStringConverter x:Key="StatusToStringConverter"/>
        <converters:RequestOrderToStringConverter x:Key="RequestOrderToStringConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid x:Name="MainContent" Visibility="{Binding HasRequests, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Moji zahtjevi" FontSize="20"/>

            <Separator Grid.Row="2"/>

            <Border
                Grid.Row="4"
                Padding="8"
                BorderBrush="{StaticResource ResidentBorderBrush}"
                Background="{StaticResource ResidentCardBackgroundBrush}"
                BorderThickness="1">
                <Grid Height="36" Background="Transparent" MouseLeftButtonDown="OpenSortAndFilterMenu_Click"> 
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf160;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Padding="0"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="Uređivanje..."
                        VerticalAlignment="Center"
                        FontSize="18"
                        Padding="0"/>

                    <TextBlock
                        Grid.Column="3"
                        Text="&#xf178;"
                        Margin="0,0,8,0"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Padding="0"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RequestsItemsControl" ItemsSource="{Binding Requests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="8"
                                Margin="0,0,0,8"
                                Background="{StaticResource ResidentCardBackgroundBrush}"
                                BorderBrush="{StaticResource ResidentBorderBrush}"
                                BorderThickness="1">
                                <Grid Background="Transparent"> 
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.InputBindings>
                                        <MouseBinding
                                            Gesture="LeftClick"
                                            Command="{Binding DataContext.OpenRequestDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"/>
                                    </Grid.InputBindings>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="Bold">

                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="Apartment.Building.Address.Street.Name"/>
                                                    <Binding Path="Apartment.Building.Address.StreetNumber"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <Separator Opacity="0" Height="2"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                               Text="&#xf133;"
                                               Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Margin="0,0,8,0"
                                               Padding="0"/>
                                            <TextBlock
                                                Text="{Binding CreationDate, StringFormat='{}{0:d. MMMM yyyy.}', ConverterCulture=sr-Latn-RS}"
                                                Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                                FontSize="14"/>
                                        </StackPanel>

                                        <Separator Opacity="0" Height="2"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                               Text="&#xf52a;"
                                               Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Margin="0,0,8,0"
                                               Padding="0"/>
                                            <TextBlock
                                                Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                                Text="{Binding Apartment.Number, StringFormat='Stan broj {0}'}"
                                                FontSize="14"/>
                                        </StackPanel>

                                        <Separator Opacity="0" Height="2"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                 Text="{Binding Status, Converter={StaticResource StatusToIconCodeConverter}}"
                                                 FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                 VerticalAlignment="Center"
                                                 FontSize="16"
                                                 Margin="0,0,8,0"
                                                 Padding="0"/>
                                            <TextBlock
                                                Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                                FontSize="14"
                                                FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="&#xf178;"
                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Margin="0,0,8,0"
                                        Padding="0"/>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="EmptyContent" Visibility="{Binding HasRequests, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Moji zahtjevi" FontSize="20"/>

                    <Separator Grid.Row="2"/>

                    <Border
                        Grid.Row="4"
                        Padding="8"
                        BorderBrush="{StaticResource ResidentBorderBrush}"
                        Background="{StaticResource ResidentCardBackgroundBrush}"
                        BorderThickness="1">
                        <Grid Height="36" Background="Transparent" MouseLeftButtonDown="OpenSortAndFilterMenu_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="&#xf160;"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Padding="0"/>

                            <TextBlock
                                Grid.Column="2"
                                Text="Uređivanje..."
                                VerticalAlignment="Center"
                                FontSize="18"
                                Padding="0"/>

                            <TextBlock
                                Grid.Column="3"
                                Text="&#xf178;"
                                Margin="0,0,8,0"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Padding="0"/>
                        </Grid>
                    </Border>
                </Grid>
                
                <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Nema zahtjeva" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="Nema zahtjeva za prikazivanje. Provjerite da li ste predali zahtjev ili uklonite filter ukoliko ste ga postavili i pokušajte ponovo."
                        TextWrapping="Wrap" 
                        TextAlignment="Center"
                        FontSize="16"
                        HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <Grid
            x:Name="SortAndFilterOverlay"
            Background="{StaticResource ResidentOverlayBrush}"
            Visibility="Collapsed">
            <Grid
                Background="{StaticResource ResidentCardBackgroundBrush}"
                Margin="16"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="8,8,8,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Text="&#xf0b0;"
                        FontSize="18"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"/>

                    <Separator Width="8" Opacity="0"/>

                    <TextBlock
                        FontSize="18"
                        TextWrapping="Wrap"
                        Text="Filtriranje — Status"/>
                </StackPanel>

                <ComboBox
                    Grid.Row="2"
                    x:Name="StatusComboBox"
                    ItemsSource="{Binding StatusOptions}"
                    SelectedValue="{Binding SelectedStatus, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                    SelectedValuePath="Value"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Height="48"
                    Margin="8,0"
                    FontSize="18"
                    Background="{StaticResource ResidentInputBackgroundBrush}"
                    Foreground="{StaticResource ResidentTextPrimaryBrush}"
                    BorderBrush="{StaticResource ResidentBorderBrush}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="36">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding Text}"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="8,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Text="&#xf0dc;"
                        FontSize="18"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"/>

                    <Separator Width="8" Opacity="0"/>

                    <TextBlock
                        FontSize="18"
                        TextWrapping="Wrap"
                        Text="Sortiranje — Datum"/>
                </StackPanel>

                <ComboBox
                    Grid.Row="6"
                    x:Name="OrderComboBox"
                    ItemsSource="{Binding Source={x:Static query:RequestOrderValues.All}}"
                    SelectedItem="{Binding SelectedOrder, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Height="48"
                    Margin="8,0"
                    FontSize="18"
                    Background="{StaticResource ResidentInputBackgroundBrush}"
                    Foreground="{StaticResource ResidentTextPrimaryBrush}"
                    BorderBrush="{StaticResource ResidentBorderBrush}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="36">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="{Binding Converter={StaticResource RequestOrderToStringConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Separator Grid.Row="7" Margin="8,0"/>

                <Grid Grid.Row="8" Margin="8,0,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Height="48"
                        FontSize="18"
                        Content="Otkaži"
                        Style="{StaticResource ResidentPrimaryActionButtonStyle}"
                        Click="CancelSortAndFilterButton_Click"
                    />

                    <Button
                        Grid.Column="2"
                        Height="48"
                        FontSize="18"
                        Content="Potvrdi"
                        Style="{StaticResource ResidentPrimaryActionButtonStyle}"
                        Click="ApplySortAndFilterButton_Click"
                    />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
