<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Apartments.ApartmentAccessRequestDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Apartments"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Detalji o zahtjevu"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StatusToIconCodeConverter x:Key="StatusToIconCodeConverter"/>
        <converters:StatusToStringConverter x:Key="StatusToStringConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    MouseLeftButtonDown="BackButton_Click"
                    Background="Transparent">
                    <TextBlock
                        Text="&#xf177;"
                        FontSize="24"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    Text="Detalji o zahtjevu"
                    FontSize="20"
                    VerticalAlignment="Center">
                </TextBlock>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

                    <TextBlock FontSize="20" VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="Zahtjev za pridruživanje zgradi"/>
                        <Run FontWeight="Bold">
                            <Run.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="Request.Apartment.Building.Address.Street.Name" Mode="OneWay"/>
                                    <Binding Path="Request.Apartment.Building.Address.StreetNumber" Mode="OneWay"/>
                                </MultiBinding>
                            </Run.Text>
                        </Run>
                    </TextBlock>

                    <Separator Margin="0,8"/>

                    <Border BorderBrush="{StaticResource ResidentBorderBrush}" Background="{StaticResource ResidentCardBackgroundBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="&#xf64f;"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Lokacija" FontSize="14"/>
                                <TextBlock FontSize="18" FontWeight="Bold">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}, {1}">
                                            <Binding Path="Request.Apartment.Building.Address.City.Name"/>
                                            <Binding Path="Request.Apartment.Building.Address.Country.Name"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource ResidentBorderBrush}" Background="{StaticResource ResidentCardBackgroundBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="&#xf3c5;"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Naselje" FontSize="14"/>
                                    <TextBlock
                                        Text="{Binding Request.Apartment.Building.Address.Neighborhood}"
                                        FontSize="18"
                                        FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource ResidentBorderBrush}" Background="{StaticResource ResidentCardBackgroundBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="&#xf52a;"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Stan" FontSize="14"/>
                                <TextBlock
                                    Text="{Binding Request.Apartment.Number}"
                                    FontSize="18"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource ResidentBorderBrush}" Background="{StaticResource ResidentCardBackgroundBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="&#xf133;"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Datum zahtjeva" FontSize="14"/>
                                <TextBlock
                                    Text="{Binding Request.CreationDate, StringFormat='{}{0:d. MMMM yyyy.}', ConverterCulture=sr-Latn-RS}"
                                    FontSize="18"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource ResidentBorderBrush}" Background="{StaticResource ResidentCardBackgroundBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Request.Status, Converter={StaticResource StatusToIconCodeConverter}}"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Status" FontSize="14"/>
                                <TextBlock
                                    Text="{Binding Request.Status, Converter={StaticResource StatusToStringConverter}}"
                                    FontSize="18"
                                    FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Visibility="{Binding Request.HasComment, Converter={StaticResource BooleanToVisibilityConverter}}"
                        BorderBrush="{StaticResource ResidentBorderBrush}"
                        Background="{StaticResource ResidentInputBackgroundBrush}"
                        BorderThickness="1"
                        Padding="8">
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Obrazloženje" FontSize="14"/>
                            <TextBlock
                                    Text="{Binding Request.Comment}"
                                    FontSize="18"
                                    TextWrapping="Wrap"
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Button
            Visibility="{Binding Request.IsPending, Converter={StaticResource BooleanToVisibilityConverter}}"
            Click="CancelRequestButton_Click"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Content="Otkaži zahtjev"
            Background="{StaticResource ResidentDangerBrush}"
            Foreground="{StaticResource ResidentOnPrimaryBrush}"
            BorderBrush="{StaticResource ResidentDangerBrush}"
            FontSize="18"
            Width="192"
            Height="72"
        />
    </Grid>
</navigation:MainNavigationConsumerPage>
