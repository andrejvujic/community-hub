<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Apartments.RequestApartmentAccessPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Apartments"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Podnošenje zahtjeva"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigatorConsumerPage.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </navigation:MainNavigatorConsumerPage.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#dedede">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid
                     Grid.Column="0"
                     MouseLeftButtonDown="BackButton_Click"
                     Background="Transparent">
                    <TextBlock
                         Text="&#xf177;"
                         FontSize="24"
                         FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                </Grid>

                <TextBlock
                     Grid.Column="1"
                     Text="Podnošenje zahtjeva"
                     FontSize="20"
                     VerticalAlignment="Center">
                </TextBlock>
            </Grid>

            <Grid Grid.Row="1" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="20" Padding="4" VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="Zahtjev za pridruživanje zgradi"/>
                    <Run FontWeight="Bold">
                        <Run.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Building.Address.Street.Name" Mode="OneWay"/>
                                <Binding Path="Building.Address.StreetNumber" Mode="OneWay"/>
                            </MultiBinding>
                        </Run.Text>
                    </Run>
                </TextBlock>

                <Separator Grid.Row="2"/>

                <Label Content="Broj stana" FontSize="18" Grid.Row="4"/>
                <TextBox
                    Height="48"
                    FontSize="16"
                    Text="{Binding ApartmentNumberText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center"
                    Padding="4"
                    Grid.Row="5"/>

                <Grid Grid.Row="7">
                    <TextBlock
                        Visibility="{Binding IsApartmentNumberValid, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                        Foreground="#4a4a4a"
                        FontSize="16"
                        TextWrapping="Wrap">
                        <Run Text="&#xf071;" FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"/>
                        <Run Text="Ovo polje je obavezno. Uneseni broj stana nije ispravan. Provjerite Vaš unos i pokušajte ponovo."/>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>

        <Button
            Click="CreateAccessRequestButton_Click"
            IsEnabled="{Binding IsApartmentNumberValid}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Content="Podnesi zahtjev"
            FontSize="18"
            Width="192"
            Height="72"/>
    </Grid>
</navigation:MainNavigatorConsumerPage>
