<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident"
        xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
        mc:Ignorable="d"
        Title="Početna"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource ResidentPageBackgroundBrush}"
        Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <!-- Icons: https://fontawesome.com/search?ip=classic&ic=free-collection -->

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>

            <Label
                Grid.Column="0"
                Content="Community Hub"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Black"
                Padding="16,0,0,0"/>

            <Grid
                Grid.Column="1"
                Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding
                        Gesture="LeftClick"
                        Command="{Binding OpenNotificationsCommand}" />
                </Grid.InputBindings>
                <TextBlock
                    Text="&#xf0f3;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                <Border
                    Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="0,4,8,0"
                    Width="24"
                    Height="24"
                    CornerRadius="12"
                    Background="{StaticResource ResidentDangerBrush}"
                    BorderBrush="{StaticResource ResidentHeaderBackgroundBrush}"
                    BorderThickness="2">
                    <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource ResidentOnPrimaryBrush}"
                        FontWeight="Bold"
                        FontSize="12"
                        Text="{Binding UnreadNotificationCountText}"/>
                </Border>
            </Grid>

            <Grid
                Grid.Column="2"
                Background="Transparent">
                <TextBlock
                    Text="&#xf059;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

        </Grid>

        <Frame Grid.Row="1" x:Name="LocalFrame" NavigationUIVisibility="Hidden"/>

        <Grid Grid.Row="2" Background="{StaticResource ResidentNavigationBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding
                        Gesture="LeftClick"
                        Command="{Binding OpenBuildingsCommand}" />
                </Grid.InputBindings>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label
                        Grid.Row="0"
                        Content="&#xf1ad;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="0,8,0,0"
                        FontSize="24"/>

                <Label
                        Grid.Row="1"
                        Content="Zgrade"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="0,4,0,8"
                        FontSize="14"/>
            </Grid>

            <Grid Grid.Column="1" Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding
                        Gesture="LeftClick"
                        Command="{Binding OpenApartmentAccessRequestsCommand}" />
                </Grid.InputBindings>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label
                        Grid.Row="0"
                        Content="&#xe494;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="0,8,0,0"
                        FontSize="24"/>

                <Label
                        Grid.Row="1"
                        Content="Zahtjevi"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="0,4,0,8"
                        FontSize="14"/>

            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
