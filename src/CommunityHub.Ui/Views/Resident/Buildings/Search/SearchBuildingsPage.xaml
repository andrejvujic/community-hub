<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Search.SearchBuildingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.Search"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Pretraživanje zgrada"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                MouseLeftButtonDown="BackButton_Click"
                Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Column="1">
                <TextBlock
                    Text="Pretraživanje zgrada"
                    FontSize="20"
                    VerticalAlignment="Center"/>
            </Grid>

            <Grid
                Grid.Column="2"
                Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding
                        Gesture="LeftClick"
                        Command="{Binding OpenSearchCriteriaCommand}" />
                </Grid.InputBindings>
                <TextBlock
                    Text="&#xf002;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

        </Grid>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="{Binding SearchResults.Count}" ContentStringFormat="Broj rezultata — {0}"  VerticalContentAlignment="Center" FontSize="18"/>
                        <Button
                            Content="Poništi pretragu"
                            Style="{StaticResource ResidentPrimaryActionButtonStyle}"
                            Visibility="{Binding HasSetSearchParameters, Converter={StaticResource BooleanToVisibilityConverter}}" 
                            Height="48"
                            Padding="8"
                            Grid.Column="2"
                            FontSize="16"
                            Command="{Binding ResetSearchCommand}"
                        />
                    </Grid>
                    
                    <Separator Grid.Row="2"/>
                </Grid>

                <ScrollViewer x:Name="BuildingsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BuildingsItemsControl" ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                     Padding="8"
                                     Margin="0,0,0,8"
                                     Background="{StaticResource ResidentCardBackgroundBrush}"
                                     BorderBrush="{StaticResource ResidentBorderBrush}"
                                     BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- size of cover image: 144 -->                     
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Image
                                            Grid.Row="0"
                                            Source="{Binding CoverImage.Path}"
                                            Height="144"
                                            Stretch="UniformToFill"
                                            Margin="0,0,0,8"
                                            Visibility="{Binding HasImages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        />

                                        <StackPanel Grid.Row="1">
                                            <TextBlock
                                                 FontSize="18"
                                                 FontWeight="Bold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Address.Street.Name"/>
                                                        <Binding Path="Address.StreetNumber"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <Separator Opacity="0" Height="2"/>

                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Text="&#xf64f;"
                                                        Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Margin="0,0,4,0"
                                                        Padding="0"/>

                                                    <TextBlock                                                
                                                         Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                                         FontSize="14">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}, {1}">
                                                                <Binding Path="Address.City.Name"/>
                                                                <Binding Path="Address.Country.Name"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Separator Opacity="0" Width="8"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Text="&#xf3c5;"
                                                        Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Margin="0,0,4,0"
                                                        Padding="0"/>
                                                    <TextBlock
                                                         Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                                         Text="{Binding Address.Neighborhood}"
                                                         FontSize="14"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                Style="{StaticResource ResidentPrimaryActionButtonStyle}"
                                                Height="48"
                                                Padding="8"
                                                Grid.Column="0" 
                                                FontSize="16"
                                                Content="Prikaži detalje"
                                                Command="{Binding DataContext.OpenBuildingDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>

                                            <Button
                                                Style="{StaticResource ResidentPrimaryActionButtonStyle}"
                                                Height="48"
                                                Padding="8"
                                                Grid.Column="2"
                                                FontSize="16"
                                                Content="Pridruži se"
                                                Command="{Binding DataContext.OpenRequestApartmentAccessCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                        </Grid>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding HasSearchResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}"  Margin="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="{Binding SearchResults.Count}" ContentStringFormat="Broj rezultata — {0}"  VerticalContentAlignment="Center" FontSize="18"/>
                                <Button
                                    Content="Poništi pretragu"
                                    Style="{StaticResource ResidentPrimaryActionButtonStyle}"
                                    Visibility="{Binding HasSetSearchParameters, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                    Height="48"
                                    Padding="8"
                                    Grid.Column="2"
                                    FontSize="16"
                                    Command="{Binding ResetSearchCommand}"
                                />
                            </Grid>

                            <Separator Grid.Row="2"/>
                        </Grid>
                    </Grid>

                    <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="Nema rezultata" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock
                             Text="Ne postoji nijedna zgrada koja odgovara zadanom kriterijumu pretrage. Provjerite zadani kriterijum i pokušajte ponovo."
                             TextWrapping="Wrap" 
                             TextAlignment="Center"
                             FontSize="16"
                             HorizontalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
