<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Search.SelectCityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.Search"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Izaberite grad"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                 Grid.Column="0"
                 MouseLeftButtonDown="BackButton_Click"
                 Background="Transparent">
                <TextBlock
                     Text="&#xf177;"
                     FontSize="24"
                     FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Column="1">
                <TextBlock
                     Text="Biranje grada"
                     FontSize="20"
                     VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Pretraži gradove..." FontSize="18"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Height="48"
                        Padding="4"
                        FontSize="16"
                        Text="{Binding SearchText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="CitySearchTextBox_TextChanged"
                        VerticalContentAlignment="Center"
                        Background="{StaticResource ResidentInputBackgroundBrush}"
                        BorderBrush="{StaticResource ResidentBorderBrush}"/>

                    <Grid
                        Grid.Column="1"
                        Background="Transparent">
                        <Grid.InputBindings>
                            <MouseBinding
                                Gesture="LeftClick"
                                Command="{Binding SearchCommand}" />
                        </Grid.InputBindings>
                        <TextBlock
                            Text="&#xf002;"
                            FontSize="24"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>

            <Separator Grid.Row="2"/>

            <Grid Grid.Row="4">
                <ScrollViewer Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CitiesItemsControl" ItemsSource="{Binding SearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8"
                                    Background="{StaticResource ResidentCardBackgroundBrush}"
                                    BorderBrush="{StaticResource ResidentBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,8">
                                    <Grid Height="48" Background="Transparent">
                                        <Grid.InputBindings>
                                            <MouseBinding
                                                Gesture="LeftClick"
                                                Command="{Binding DataContext.SelectCityCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock
                                                Text="&#xf00c;"
                                                FontSize="20"
                                                Margin="0,0,16,0"
                                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                        <Binding />
                                                                        <Binding Path="DataContext.SelectedCity" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Name}" FontSize="18" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="&#xf178;"
                                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                            VerticalAlignment="Center"
                                            FontSize="24">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding />
                                                                    <Binding Path="SelectedCity" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Visibility="{Binding HasSearchResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="8">
                    <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="Nema rezultata" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock
                            Text="Ne postoji nijedan grad koji odgovara zadanom kriterijumu pretrage. Provjerite zadani kriterijum i pokušajte ponovo."
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            FontSize="16"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
