<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Issues.IssueDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Detalji problema"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:IssueStatusToStringConverter x:Key="IssueStatusToStringConverter"/>
        <converters:IssueStatusToIconCodeConverter x:Key="IssueStatusToIconCodeConverter"/>
        <converters:IssuePriorityToStringConverter x:Key="IssuePriorityToStringConverter"/>
        <converters:IssuePriorityToIconCodeConverter x:Key="IssuePriorityToIconCodeConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" MouseLeftButtonDown="BackButton_Click" Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <TextBlock
                Grid.Column="1"
                Text="Detalji problema"
                FontSize="20"
                VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <Border
                    BorderBrush="{StaticResource ResidentBorderBrush}"
                    Background="{StaticResource ResidentCardBackgroundBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Opis" FontSize="14"/>
                        <TextBlock
                            Text="{Binding Issue.Description}"
                            FontSize="18"
                            TextWrapping="Wrap"
                            FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border
                    BorderBrush="{StaticResource ResidentBorderBrush}"
                    Background="{StaticResource ResidentCardBackgroundBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="&#xf133;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Datum prijavljivanja" FontSize="14"/>
                            <TextBlock
                                Text="{Binding Issue.ReportedAt, StringFormat='{}{0:d. MMMM yyyy.}', ConverterCulture=sr-Latn-RS}"
                                FontSize="18"
                                FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    BorderBrush="{StaticResource ResidentBorderBrush}"
                    Background="{StaticResource ResidentCardBackgroundBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding Issue.Priority, Converter={StaticResource IssuePriorityToIconCodeConverter}}"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Prioritet rješavanja" FontSize="14"/>
                            <TextBlock
                                Text="{Binding Issue.Priority, Converter={StaticResource IssuePriorityToStringConverter}}"
                                FontSize="18"
                                FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    BorderBrush="{StaticResource ResidentBorderBrush}"
                    Background="{StaticResource ResidentCardBackgroundBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding Issue.Status, Converter={StaticResource IssueStatusToIconCodeConverter}}"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Status" FontSize="14"/>
                            <TextBlock
                                Text="{Binding Issue.Status, Converter={StaticResource IssueStatusToStringConverter}}"
                                FontSize="18"
                                FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock
                    Visibility="{Binding CanConfirmResolution, Converter={StaticResource BooleanToVisibilityConverter}}"
                    FontSize="16"
                    Foreground="{StaticResource ResidentTextSecondaryBrush}"
                    TextWrapping="Wrap">
                    <Run
                        Text="&#xf05a;"
                        FontSize="14"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        BaselineAlignment="Center"/>
                    <Run Text="Upravnik je označio problem kao riješen. Potvrdite rješenje ukoliko je problem zaista otklonjen."/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Button
            Grid.Row="2"
            Visibility="{Binding CanConfirmResolution, Converter={StaticResource BooleanToVisibilityConverter}}"
            HorizontalAlignment="Center"
            Margin="0,8,0,16"
            Content="Potvrdi rješenje"
            Command="{Binding ConfirmResolutionCommand}"
            Style="{StaticResource ResidentPrimaryActionButtonStyle}"
            FontSize="18"
            Width="208"
            Height="72"/>
    </Grid>
</navigation:MainNavigationConsumerPage>
