<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Issues.SelectIssuePriorityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      xmlns:issues="clr-namespace:CommunityHub.Application.Domain.Issues;assembly=CommunityHub.Application"
      mc:Ignorable="d"
      Title="Biranje prioriteta"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:IssuePriorityToStringConverter x:Key="IssuePriorityToStringConverter"/>
        <converters:IssuePriorityToIconCodeConverter x:Key="IssuePriorityToIconCodeConverter"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" MouseLeftButtonDown="BackButton_Click" Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <TextBlock
                Grid.Column="1"
                Text="Biranje prioriteta"
                FontSize="20"
                VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Odaberite prioritet rješavanja problema klikom na odgovarajuću stavku ispod."
                TextWrapping="Wrap"
                FontSize="20"/>

            <Separator Grid.Row="2"/>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Source={x:Static issues:IssuePriorityValues.All}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="8"
                                Background="{StaticResource ResidentCardBackgroundBrush}"
                                BorderBrush="{StaticResource ResidentBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,8">
                                <Grid Height="48" MouseLeftButtonDown="PriorityItem_Click" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding Converter={StaticResource IssuePriorityToIconCodeConverter}}"
                                        FontSize="20"
                                        Margin="0,0,16,0"
                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Converter={StaticResource IssuePriorityToStringConverter}}"
                                        FontSize="18"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="&#xf00c;"
                                        FontSize="20"
                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                        VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                <Binding/>
                                                                <Binding Path="SelectedPriority" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
