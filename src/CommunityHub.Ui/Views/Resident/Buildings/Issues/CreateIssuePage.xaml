<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Issues.CreateIssuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Prijavljivanje problema"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:IssuePriorityToStringConverter x:Key="IssuePriorityToStringConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" MouseLeftButtonDown="BackButton_Click" Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <TextBlock
                Grid.Column="1"
                Text="Prijavljivanje problema"
                FontSize="20"
                VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <TextBlock
                    Text="Opišite problem i odaberite prioritet njegovog rješavanja."
                    TextWrapping="Wrap"
                    FontSize="20"
                    Margin="0,0,0,8"/>

                <Separator Margin="0,0,0,8"/>

                <Label Content="Opis" FontSize="18"/>
                <TextBox
                    FontSize="18"
                    Height="192"
                    Padding="4"
                    MaxLength="200"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Background="{StaticResource ResidentInputBackgroundBrush}"
                    BorderBrush="{StaticResource ResidentBorderBrush}"
                    Margin="0,0,0,8"/>

                <Label Content="Prioritet rješavanja" FontSize="18"/>
                <Border
                    Background="{StaticResource ResidentInputBackgroundBrush}"
                    BorderBrush="{StaticResource ResidentBorderBrush}"
                    BorderThickness="1">
                    <Grid Height="48" Background="Transparent">
                        <Grid.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenSelectPriorityPageCommand}"/>
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{Binding SelectedPriority, Converter={StaticResource IssuePriorityToStringConverter}, ConverterParameter='Izaberite...'}"
                            FontSize="18"
                            Margin="4"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="&#xf178;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Margin="4,4,8,4"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button
            Grid.Row="2"
            HorizontalAlignment="Center"
            Margin="0,8,0,16"
            IsEnabled="{Binding IsFormValid}"
            Command="{Binding SubmitCommand}"
            Content="Prijavi problem"
            Style="{StaticResource ResidentPrimaryActionButtonStyle}"
            FontSize="18"
            Width="192"
            Height="72"/>
    </Grid>
</navigation:MainNavigationConsumerPage>
