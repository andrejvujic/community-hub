<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.CommonRooms.CommonRoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.CommonRooms"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Zajedničke prostorije"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:RentalTypeToStringConverter x:Key="RentalTypeToStringConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    MouseLeftButtonDown="BackButton_Click"
                    Background="Transparent">
                    <TextBlock
                        Text="&#xf177;"
                        FontSize="24"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    Text="Zajedničke prostorije"
                    FontSize="20"
                    VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="8" Visibility="{Binding HasCommonRooms, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    BorderThickness="1"
                    BorderBrush="{StaticResource ResidentBorderBrush}"
                    Background="{StaticResource ResidentCardBackgroundBrush}"
                    Cursor="Hand"
                    Padding="16">
                    <Grid Background="Transparent">
                        <Grid.InputBindings>
                            <MouseBinding
                                Gesture="LeftClick"
                                Command="{Binding OpenRentalReportCommand}" />
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="&#xe0e3;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            VerticalAlignment="Center"
                            FontSize="20"/>

                        <TextBlock
                            Grid.Column="2"
                            FontSize="18"
                            Text="Izvještaj o zahtjevima"/>

                        <TextBlock
                            Grid.Column="4"
                            Text="&#xf178;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            VerticalAlignment="Center"
                            FontSize="24"/>
                    </Grid>
                </Border>

                <Separator Grid.Row="2"/>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CommonRooms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8"
                                    Margin="0,0,0,8"
                                    Background="{StaticResource ResidentCardBackgroundBrush}"
                                    BorderBrush="{StaticResource ResidentBorderBrush}"
                                    BorderThickness="1">
                                    <Grid Background="Transparent">
                                        <Grid.InputBindings>
                                            <MouseBinding
                                                Gesture="LeftClick"
                                                Command="{Binding DataContext.OpenCommonRoomDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Text="{Binding Name}"/>

                                            <Separator Opacity="0" Height="2"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                   Text="&#xf3c5;"
                                                   Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                                   FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Margin="0,0,8,0"
                                                   Padding="0"/>

                                                <TextBlock
                                                    Text="{Binding FloorNumber, StringFormat='{}{0}. sprat'}"
                                                    Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                                    FontSize="14"/>
                                            </StackPanel>

                                            <Separator Opacity="0" Height="2"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                   Text="&#xf073;"
                                                   Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                                   FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Margin="0,0,8,0"
                                                   Padding="0"/>
                                                <TextBlock
                                                    Foreground="{StaticResource ResidentTextSecondaryBrush}"
                                                    Text="{Binding RentalType, StringFormat='{}{0} iznajmljivanje', Converter={StaticResource RentalTypeToStringConverter}}"
                                                    FontSize="14"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="&#xf178;"
                                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Margin="0,0,8,0"
                                            Padding="0"/>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Visibility="{Binding HasCommonRooms, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Nema zajedničkih prostorija" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock
                    Text="Trenutno ne postoji nijedna zajednička prostorija dostupna za iznajmljivanje u ovoj zgradi."
                    TextWrapping="Wrap" 
                    TextAlignment="Center"
                    FontSize="16"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
