<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.CommonRooms.CommonRoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.CommonRooms"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Zajedničke prostorije"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigatorConsumerPage.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </navigation:MainNavigatorConsumerPage.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#dedede">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    MouseLeftButtonDown="BackButton_Click"
                    Background="Transparent">
                    <TextBlock
                        Text="&#xf177;"
                        FontSize="24"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    Text="Zajedničke prostorije"
                    FontSize="20"
                    VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="8" Visibility="{Binding HasCommonRooms, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    BorderThickness="1"
                    BorderBrush="Gray"
                    Padding="16">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="&#xe0e3;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            VerticalAlignment="Center"
                            FontSize="20"/>

                        <TextBlock
                            Grid.Column="2"
                            FontSize="18"
                            Text="Izvještaj o iznajmljivanju"/>

                        <TextBlock
                            Grid.Column="4"
                            Text="&#xf178;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            VerticalAlignment="Center"
                            FontSize="24"/>
                    </Grid>
                </Border>

                <Separator Grid.Row="2"/>
            </Grid>
        </Grid>

        <Grid Visibility="{Binding HasCommonRooms, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Nema zajedničkih prostorija" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock
                    Text="Trenutno ne postoji nijedna zajednička prostorija dostupna za iznajmljivanje u ovoj zgradi."
                    TextWrapping="Wrap" 
                    TextAlignment="Center"
                    FontSize="16"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</navigation:MainNavigatorConsumerPage>
