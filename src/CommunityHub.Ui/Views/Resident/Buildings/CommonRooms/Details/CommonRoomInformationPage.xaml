<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.CommonRooms.Details.CommonRoomInformationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.CommonRooms.Details"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Informacije o zajedničkoj prostoriji"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigatorConsumerPage.Resources>
        <converters:RentalTypeToStringConverter x:Key="RentalTypeToStringConverter"/>
    </navigation:MainNavigatorConsumerPage.Resources>
    <Grid>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="Lokacija" FontSize="18" Grid.Row="0"/>

            <Border
                Grid.Row="1" 
                Background="#dedede"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="4">
                <Grid Background="#dedede" Height="48">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding CommonRoom.FloorNumber, StringFormat='{}{0}. spart'}"
                        FontSize="18"/>
                </Grid>
            </Border>

            <Label Content="Način iznajmljivanja" FontSize="18" Grid.Row="3"/>

            <Border
                Grid.Row="4" 
                Background="#dedede"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="4">
                <Grid Background="#dedede" Height="48">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding CommonRoom.RentalType, Converter={StaticResource RentalTypeToStringConverter}}"
                        FontSize="18"/>
                </Grid>
            </Border>

            <Label Content="Opis" FontSize="18" Grid.Row="6"/>

            <Border
                Grid.Row="7" 
                Background="#dedede"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="4">
                <TextBlock
                    Grid.Row="7"
                    FontSize="18"
                    Height="120"
                    TextWrapping="Wrap"
                    Text="{Binding CommonRoom.Description}"/>
            </Border>
        </Grid>
    </Grid>
</navigation:MainNavigatorConsumerPage>
