<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.CommonRooms.Details.CommonRoomInformationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.CommonRooms.Details"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Informacije o zajedničkoj prostoriji"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigatorConsumerPage.Resources>
        <converters:RentalTypeToStringConverter x:Key="RentalTypeToStringConverter"/>
    </navigation:MainNavigatorConsumerPage.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8" Orientation="Vertical">
            <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                    Grid.Column="0"
                    Text="&#xf3c5;"
                    FontSize="22"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Lokacija" FontSize="14"/>
                        <TextBlock
                            Text="{Binding CommonRoom.FloorNumber, StringFormat='{}{0}. sprat'}"
                            FontSize="18"
                            FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf073;"
                        FontSize="22"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Način iznajmljivanja" FontSize="14"/>
                        <TextBlock
                        Text="{Binding CommonRoom.RentalType, Converter={StaticResource RentalTypeToStringConverter}}"
                        FontSize="18"
                        FontWeight="Bold"
                        TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="8">
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Opis" FontSize="14"/>
                    <TextBlock
                        Text="{Binding CommonRoom.Description}"
                        FontSize="18"
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</navigation:MainNavigatorConsumerPage>
