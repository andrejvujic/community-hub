<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.CommonRooms.CommonRoomRentalReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.CommonRooms"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Izvještaj o zahtjevima"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}"
      xml:lang="sr-Latn-RS">

    <navigation:MainNavigationConsumerPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Grey"
                    SecondaryColor="LightBlue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Calendar.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </navigation:MainNavigationConsumerPage.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    MouseLeftButtonDown="BackButton_Click"
                    Background="Transparent">
                    <TextBlock
                        Text="&#xf177;"
                        FontSize="24"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    Text="Izvještaj o zahtjevima"
                    FontSize="20"
                    VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontSize="24"
                    FontWeight="Bold"
                    TextWrapping="Wrap"
                    Text="Generisanje izvještaja o zahtjevima za iznajmljivanje zajedničkih prostorija"/>

                <Separator Grid.Row="2"/>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontSize="18"
                        Text="Datum izvještaja"/>

                    <Border
                        Grid.Row="2"
                        Background="{StaticResource ResidentInputBackgroundBrush}"
                        BorderBrush="{StaticResource ResidentBorderBrush}"
                        BorderThickness="1">
                        <Grid Background="{StaticResource ResidentInputBackgroundBrush}" Height="48" MouseLeftButtonDown="ToggleDatePickerButton_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label
                                Grid.Column="0"
                                VerticalContentAlignment="Center"
                                Content="{Binding SelectedDateText}"
                                FontSize="18"
                                Padding="4"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="&#xf178;"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Margin="0,0,8,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <Button
                    Grid.Row="6"
                    Height="48"
                    FontSize="18"
                    HorizontalAlignment="Stretch"
                    Command="{Binding GenerateReportCommand}"
                    Content="Generiši izvještaj"
                    Style="{StaticResource ResidentPrimaryActionButtonStyle}"/>
            </Grid>
        </Grid>

        <Grid
            x:Name="DatePickerOverlay"
            Visibility="Collapsed"
            Background="{StaticResource ResidentOverlayBrush}">
            <Border Background="{StaticResource ResidentInputBackgroundBrush}" Padding="8" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="0" BorderBrush="{StaticResource ResidentBorderBrush}" BorderThickness="1">
                        <Viewbox Stretch="Uniform">
                            <Calendar
                                materialDesign:CalendarAssist.HeaderBackground="{StaticResource ResidentHeaderBackgroundBrush}"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                SelectedDate="{Binding SelectedDate}"
                                Style="{StaticResource MaterialDesignCalendarPortrait}"/>
                        </Viewbox>
                    </Border>

                    <Button
                        Grid.Row="2"
                        Height="48"
                        FontSize="18"
                        HorizontalAlignment="Stretch"
                        Click="ToggleDatePickerButton_Click"
                        Content="Potvrdi"
                        Style="{StaticResource ResidentPrimaryActionButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
