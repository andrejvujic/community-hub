<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Browse.BuildingOptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.Browse"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      mc:Ignorable="d"
      Title="Opcije za zgradu"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                MouseLeftButtonDown="BackButton_Click"
                Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <TextBlock
                Grid.Column="1"
                FontSize="20"
                VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} {1}">
                        <Binding Path="Building.Address.Street.Name"/>
                        <Binding Path="Building.Address.StreetNumber"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="16,24"
                BorderBrush="{StaticResource ResidentBorderBrush}"
                Background="{StaticResource ResidentCardBackgroundBrush}"
                BorderThickness="1">
                <Grid Background="Transparent" MouseLeftButtonDown="OpenBuildingDetailsPageButton_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf1ad;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="Informacije"
                        FontSize="20"/>

                    <TextBlock
                        Grid.Column="3"
                        Text="&#xf178;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Padding="16,24"
                BorderBrush="{StaticResource ResidentBorderBrush}"
                Background="{StaticResource ResidentCardBackgroundBrush}"
                BorderThickness="1">
                <Grid Background="Transparent" MouseLeftButtonDown="OpenNoticeBoardPageButton_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf4d9;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="Oglasna tabla"
                        FontSize="20"/>

                    <TextBlock
                        Grid.Column="3"
                        Text="&#xf178;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>
                </Grid>
            </Border>

            <Border
                Grid.Row="4"
                Padding="16,24"
                BorderBrush="{StaticResource ResidentBorderBrush}"
                Background="{StaticResource ResidentCardBackgroundBrush}"
                BorderThickness="1">
                <Grid Background="Transparent" MouseLeftButtonDown="OpenPersonalAdsPageButton_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf47f;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="Moji oglasi"
                        FontSize="20"/>

                    <TextBlock
                        Grid.Column="3"
                        Text="&#xf178;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>
                </Grid>
            </Border>

            <Border
                Grid.Row="6"
                Padding="16,24"
                BorderBrush="{StaticResource ResidentBorderBrush}"
                Background="{StaticResource ResidentCardBackgroundBrush}"
                BorderThickness="1">
                <Grid Background="Transparent" MouseLeftButtonDown="OpenCommonRoomsPageButton_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf52a;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="Zajedničke prostorije"
                        FontSize="20"/>

                    <TextBlock
                        Grid.Column="3"
                        Text="&#xf178;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>
                </Grid>
            </Border>

            <Border
                Grid.Row="8"
                Padding="16,24"
                BorderBrush="{StaticResource ResidentBorderBrush}"
                Background="{StaticResource ResidentCardBackgroundBrush}"
                BorderThickness="1">
                <Grid Background="Transparent" MouseLeftButtonDown="OpenIssuesPageButton_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xe4d3;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="Problemi"
                        FontSize="20"/>

                    <TextBlock
                        Grid.Column="3"
                        Text="&#xf178;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>
                </Grid>
            </Border>

            <Border
                Grid.Row="10"
                Padding="16,24"
                BorderBrush="{StaticResource ResidentBorderBrush}"
                Background="{StaticResource ResidentCardBackgroundBrush}"
                BorderThickness="1">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xe533;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>

                    <TextBlock
                        Grid.Column="2"
                        Text="Skupština stanara"
                        FontSize="20"/>

                    <TextBlock
                        Grid.Column="3"
                        Text="&#xf178;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        VerticalAlignment="Center"
                        FontSize="24"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
