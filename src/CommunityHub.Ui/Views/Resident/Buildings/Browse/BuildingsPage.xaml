<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Browse.BuildingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.Browse"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Zgrade"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigatorConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </navigation:MainNavigatorConsumerPage.Resources>
    <Grid>
        <Grid x:Name="MainContent" Visibility="{Binding HasMemberships, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Moje zgrade" FontSize="20"/>

                <Separator Grid.Row="2"/>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MembershipGroupsItemsControl" ItemsSource="{Binding MembershipGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8"
                                    Margin="0,0,0,8"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Grid Background="Transparent" MouseLeftButtonDown="OpenBuildingOptionsPageButton_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                FontSize="18"
                                                FontWeight="Bold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Building.Address.Street.Name"/>
                                                        <Binding Path="Building.Address.StreetNumber"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <Separator Height="2" Opacity="0"/>

                                            <ItemsControl ItemsSource="{Binding Memberships}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border 
                                                            Margin="0,0,4,4"
                                                            Padding="8"
                                                            Background="#dedede"
                                                            BorderBrush="Gray"
                                                            BorderThickness="1"
                                                            Width="80">
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center" 
                                                                TextAlignment="Center"         
                                                                FontSize="14">
                                                                    <Run Text="Stan"/>
                                                                    <Run
                                                                        Text="{Binding Apartment.Number, Mode=OneWay}"
                                                                        FontWeight="Bold"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="&#xf178;"
                                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Margin="0,0,8,0"
                                            Padding="0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Grid>

        <Grid x:Name="EmptyContent" Visibility="{Binding HasMemberships, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Moje zgrade" FontSize="20"/>

                    <Separator Grid.Row="2"/>

                </Grid>

                <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Nema zgrada" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="Nema zgrada za prikazivanje. Još uvijek niste član nijedne zgrade. Zahtjev za učlanjenje u zgradu i pristup svom stanu možete podnijeti klikom na dugme ispod."
                        TextWrapping="Wrap" 
                        TextAlignment="Center"
                        FontSize="16"
                        HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <Button
            Content="&#x2b;"
            Foreground="White"
            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
            FontSize="24"
            Margin="16"
            BorderThickness="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Click="CreateAppartmentAccessRequestButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Width="64" Height="64" Fill="Black"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</navigation:MainNavigatorConsumerPage>
