<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Browse.BuildingDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.Browse"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Detalji o zgradi"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                MouseLeftButtonDown="BackButton_Click"
                Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <TextBlock
                Grid.Column="1"
                Text="Detalji o zgradi"
                FontSize="20"
                VerticalAlignment="Center">
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                FontSize="20"
                Padding="4"
                VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} {1}">
                        <Binding Path="Building.Address.Street.Name"/>
                        <Binding Path="Building.Address.StreetNumber"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Separator Grid.Row="2"/>

            <Grid Grid.Row="4" Visibility="{Binding Building.HasImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <Image
                    Grid.Row="0"
                    Source="{Binding CurrentImage.Path}"
                    Height="224"
                    Stretch="UniformToFill"
                />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Height="48"
                        Style="{StaticResource ResidentPrimaryActionButtonStyle}"
                        Command="{Binding GoToPreviousImageCommand}"
                        IsEnabled="{Binding HasPreviousImage}">
                        <TextBlock
                            Text="&#xf060;"
                            FontSize="20"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Button>

                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding Building.Images}"
                        Visibility="{Binding ShouldUseTextIndicator, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Height="10" Width="10" Margin="0,0,4,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource ResidentBorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                <Binding />
                                                                <Binding Path="DataContext.CurrentImage" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Fill" Value="{StaticResource ResidentPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShouldUseTextIndicator, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Text="{Binding CurrentImageText}"
                            FontSize="18"/>
                    </Grid>

                    <Button
                        Grid.Column="2"
                        Height="48"
                        Style="{StaticResource ResidentPrimaryActionButtonStyle}"
                        Command="{Binding GoToNextImageCommand}"
                        IsEnabled="{Binding HasNextImage}">
                        <TextBlock
                            Text="&#xf061;"
                            FontSize="20"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Text="&#xf64f;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Width="24"
                        FontSize="20"/>

                    <Separator Opacity="0" Width="8"/>

                    <TextBlock
                        FontSize="18"
                        VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}, {1}">
                                <Binding Path="Building.Address.City.Name"/>
                                <Binding Path="Building.Address.Country.Name"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <Separator Opacity="0" Height="4"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Text="&#xf3c5;"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Width="24"
                        FontSize="20"/>

                    <Separator Opacity="0" Width="8"/>

                    <TextBlock
                        FontSize="18"
                        VerticalAlignment="Center"
                        Text="{Binding Building.Address.Neighborhood}"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid 
                    Grid.Column="0"
                    Background="{StaticResource ResidentSurfaceBrush}"
                    Height="48">
                    <TextBlock
                        Text="{Binding Building.FloorCount, StringFormat='Broj spratova — {0}'}"     
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="18"/>
                </Grid>

                <Grid 
                    Grid.Column="2"
                    Background="{StaticResource ResidentSurfaceBrush}"
                    Height="48">
                    <TextBlock
                        Text="{Binding Building.ApartmentCount, StringFormat='Broj stanova — {0}'}"     
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="18"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
