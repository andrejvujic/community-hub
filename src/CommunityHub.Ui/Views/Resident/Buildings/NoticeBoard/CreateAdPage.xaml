<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.NoticeBoard.CreateAdPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.NoticeBoard"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Objavljivanje oglasa"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigatorConsumerPage.Resources>
        <converters:AdTypeToStringConverter x:Key="AdTypeToStringConverter" />
        <converters:AdCategoryToStringConverter x:Key="AdCategoryToStringConverter" />
    </navigation:MainNavigatorConsumerPage.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#dedede">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid
                     Grid.Column="0"
                     MouseLeftButtonDown="BackButton_Click"
                     Background="Transparent">
                    <TextBlock
                         Text="&#xf177;"
                         FontSize="24"
                         FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                </Grid>

                <TextBlock
                     Grid.Column="1"
                     Text="Objavljivanje oglasa"
                     FontSize="20"
                     VerticalAlignment="Center">
                </TextBlock>
            </Grid>

            <Grid Margin="8" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Vrsta oglasa" FontSize="18" Grid.Row="0"/>

                <Border
                    Grid.Row="1" 
                    Background="#dedede"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <Grid Background="#dedede" Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Column="0"
                            VerticalContentAlignment="Center"
                            Content="{Binding SelectedType, Converter={StaticResource AdTypeToStringConverter}, ConverterParameter='Izaberite...'}"
                            FontSize="18"
                            Padding="4"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="&#xf178;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Margin="4,4,8,4"
                            Padding="0"/>
                    </Grid>
                </Border>

                <Label Content="Kategorija" FontSize="18" Grid.Row="3"/>

                <Border
                    Grid.Row="4" 
                    Background="#dedede"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <Grid Background="#dedede" Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Column="0"
                            VerticalContentAlignment="Center"
                            Content="{Binding SelectedCategory, Converter={StaticResource AdCategoryToStringConverter}, ConverterParameter='Izaberite...'}"
                            FontSize="18"
                            Padding="4"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="&#xf178;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Margin="4,4,8,4"
                            Padding="0"/>
                    </Grid>
                </Border>

                <Label Content="Opis" FontSize="18" Grid.Row="6"/>

                <TextBox
                    Grid.Row="7"
                    FontSize="18"
                    Height="172"
                    Padding="4"
                    MaxLength="200"
                    TextWrapping="Wrap"
                    Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Opseg datuma" FontSize="18" Grid.Row="9"/>

                <Border
                    Grid.Row="10" 
                    Background="#dedede"
                    BorderBrush="Gray"
                    BorderThickness="1">
                    <Grid Background="#dedede" Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label
                    Grid.Column="0"
                    VerticalContentAlignment="Center"
                    Content="{Binding SelectedDateRangeText}"
                    FontSize="18"
                    Padding="4"/>

                        <TextBlock
                    Grid.Column="1"
                    Text="&#xf178;"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    VerticalAlignment="Center"
                    FontSize="24"
                    Margin="4,4,8,4"
                    Padding="0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Button
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Content="Objavi oglas"
            FontSize="18"
            Width="192"
            Height="72"/>
    </Grid>
</navigation:MainNavigatorConsumerPage>
