<navigation:MainNavigatorConsumerPage
    x:Class="CommunityHub.Ui.Views.Resident.Buildings.NoticeBoard.AdInformationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.NoticeBoard"
    xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
    xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
    mc:Ignorable="d"
    Title="Detaljne informacije o oglasu"
    FontFamily="{StaticResource AppFontFamily}">

    <navigation:MainNavigatorConsumerPage.Resources>
        <converters:AdTypeToStringConverter x:Key="AdTypeToStringConverter" />
        <converters:AdCategoryToStringConverter x:Key="AdCategoryToStringConverter" />
    </navigation:MainNavigatorConsumerPage.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8" Orientation="Vertical">
            <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf007;"
                        FontSize="22"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Autor" FontSize="14"/>
                        <TextBlock FontSize="18" FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="Ad.Author.Name"/>
                                    <Binding Path="Ad.Author.Surname"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf02b;"
                        FontSize="22"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Vrsta oglasa" FontSize="14"/>
                        <TextBlock
                            Text="{Binding Ad.Type, Converter={StaticResource AdTypeToStringConverter}}"
                            FontSize="18"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf022;"
                        FontSize="22"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Kategorija" FontSize="14"/>
                        <TextBlock
                            Text="{Binding Ad.Category, Converter={StaticResource AdCategoryToStringConverter}}"
                            FontSize="18"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf05a;"
                        FontSize="22"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,4,0,0"/>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Opis" FontSize="14"/>
                        <TextBlock
                            Text="{Binding Ad.Description}"
                            FontSize="18"
                            TextWrapping="Wrap"
                            Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>


            <Border BorderBrush="Gray" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="&#xf073;"
                        FontSize="22"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Opseg datuma" FontSize="14"/>
                        <TextBlock FontSize="18" FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:d. MMMM} — {1:d. MMMM}" ConverterCulture="sr-Latn-RS">
                                    <Binding Path="Ad.StartDate"/>
                                    <Binding Path="Ad.EndDate"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</navigation:MainNavigatorConsumerPage>