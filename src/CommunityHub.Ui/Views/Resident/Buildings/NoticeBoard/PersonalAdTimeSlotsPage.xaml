<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.NoticeBoard.PersonalAdTimeSlotsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.NoticeBoard"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Termini oglasa"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigatorConsumerPage.Resources>
        <converters:IEnumerableContainsToBooleanConverter x:Key="IEnumerableContainsToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </navigation:MainNavigatorConsumerPage.Resources>
    <Grid>
        <Grid Visibility="{Binding HasReservableTimeSlots, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Rezervacija termina"
                FontSize="20"
                VerticalAlignment="Center"/>

            <Separator Grid.Row="1"/>

            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Reservations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,16" Background="Transparent" MouseLeftButtonDown="ReservationItem_Click">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="&#xf007;"
                                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                            VerticalAlignment="Center"
                                            FontSize="20"/>

                                        <TextBlock Grid.Column="2" FontSize="20" FontWeight="Bold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="Ad.Author.Name"/>
                                                    <Binding Path="Ad.Author.Surname"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{Binding TimeSlotCount, StringFormat='{}{0} termina'}"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Margin="0,0,4,0"/>
                                    </Grid>

                                    <Border 
                                        Grid.Row="2"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        Padding="8,8,8,0">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding TimeSlotGroups}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,16">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="4"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock
                                                                Grid.Row="0"
                                                                FontSize="20"
                                                                FontWeight="Bold"
                                                                Text="{Binding Day, StringFormat='{}{0:d. MMMM}', ConverterCulture='sr-Latn-RS'}"/>

                                                            <Border
                                                                Grid.Row="2"
                                                                BorderBrush="Gray"
                                                                BorderThickness="1"
                                                                Padding="0,8,8,0">
                                                                <ItemsControl ItemsSource="{Binding TimeSlots}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Columns="2"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>

                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border
                                                                                Grid.Row="2"
                                                                                Background="#dedede"
                                                                                BorderBrush="Gray"
                                                                                BorderThickness="1"
                                                                                Margin="8,0,0,8"
                                                                                Padding="8">
                                                                                <Grid HorizontalAlignment="Center">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="8"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>


                                                                                    <TextBlock
                                                                                        Grid.Column="0"
                                                                                        Text="&#xf017;"
                                                                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="16"/>

                                                                                    <TextBlock Grid.Column="2" FontSize="18" VerticalAlignment="Center">
                                                                                        <TextBlock.Text>
                                                                                            <MultiBinding StringFormat="{}{0:HH.mm} — {1:HH.mm}">
                                                                                                <Binding Path="StartTime"/>
                                                                                                <Binding Path="EndTime"/>
                                                                                            </MultiBinding>
                                                                                        </TextBlock.Text>
                                                                                    </TextBlock>
                                                                                </Grid>

                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </Grid>

                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Separator Margin="0,-4,0,12"/>

                                            <Border
                                                BorderThickness="1"
                                                BorderBrush="Gray"
                                                Background="#dedede"
                                                Padding="16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="18"
                                                        Text="Detalji o oglasu"/>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="&#xf178;"
                                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                        VerticalAlignment="Center"
                                                        FontSize="24"/>
                                                </Grid>
                                            </Border>

                                            <Separator Height="8" Opacity="0"/>
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Visibility="{Binding HasReservations, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="8">

            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="Rezervacija termina"
                        FontSize="20"
                        VerticalAlignment="Center"/>

                    <Separator Grid.Row="1"/>
                </Grid>
            </DockPanel>

            <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Nema rezervacija" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock
                    Text="Još uvijek nijedan stanar nije napravio rezervaciju za neki od termina ovog oglasa. Bićete obaviješteni kada neko od stanara rezerviše termin iz ovog oglasa."
                    TextWrapping="Wrap" 
                    TextAlignment="Center"
                    FontSize="16"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</navigation:MainNavigatorConsumerPage>
