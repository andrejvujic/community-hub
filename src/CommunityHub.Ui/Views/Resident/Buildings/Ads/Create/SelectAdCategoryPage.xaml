<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Ads.Create.SelectAdCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.Ads.Create"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      xmlns:ads="clr-namespace:CommunityHub.Application.Domain.Ads;assembly=CommunityHub.Application"
      mc:Ignorable="d"
      Title="Biranje kategorije oglasa"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:AdCategoryToStringConverter x:Key="AdCategoryToStringConverter"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#dedede">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                 Grid.Column="0"
                 MouseLeftButtonDown="BackButton_Click"
                 Background="Transparent">
                <TextBlock
                     Text="&#xf177;"
                     FontSize="24"
                     FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Column="1">
                <TextBlock
                     Text="Biranje kategorije oglasa"
                     FontSize="20"
                     VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Text="Odaberite kategoriju vašeg oglasa klikom na odgovarajuću stavku ispod."
                TextWrapping="Wrap"
                FontSize="20"/>

            <Separator Grid.Row="2"/>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Source={x:Static ads:AdCategoryValues.All}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="8"
                                Background="#dedede"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                Margin="0,0,0,8">
                                <Grid Height="48" MouseLeftButtonDown="CategoryItem_Click" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock
                                            Text="&#xf00c;"
                                            FontSize="20"
                                            Margin="0,0,16,0"
                                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                            VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding />
                                                                    <Binding Path="SelectedCategory" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock
                                            FontSize="18"
                                            VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <Binding Path="." Converter="{StaticResource AdCategoryToStringConverter}"/> 
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="&#xf178;"
                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                        VerticalAlignment="Center"
                                        FontSize="24">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                <Binding />
                                                                <Binding Path="SelectedCategory" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
