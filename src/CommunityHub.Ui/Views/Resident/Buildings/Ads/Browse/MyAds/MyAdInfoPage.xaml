<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Ads.Browse.MyAds.MyAdInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.Ads.Browse.MyAds"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Detaljne informacije o oglasu"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:AdTypeToStringConverter x:Key="AdTypeToStringConverter" />
        <converters:AdCategoryToStringConverter x:Key="AdCategoryToStringConverter" />
        <converters:AdStatusToStringConverter x:Key="AdStatusToStringConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8" Orientation="Vertical">
                <Border BorderBrush="{StaticResource ResidentBorderBrush}" Background="{StaticResource ResidentCardBackgroundBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="&#xf02b;"
                            FontSize="22"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Vrsta oglasa" FontSize="14"/>
                            <TextBlock
                                Text="{Binding Ad.Type, Converter={StaticResource AdTypeToStringConverter}, StringFormat='{}{0} pomoć'}"
                                FontSize="18"
                                FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="{StaticResource ResidentBorderBrush}" Background="{StaticResource ResidentCardBackgroundBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="&#xf022;"
                            FontSize="22"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Kategorija" FontSize="14"/>
                            <TextBlock
                                Text="{Binding Ad.Category, Converter={StaticResource AdCategoryToStringConverter}}"
                                FontSize="18"
                                FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="{StaticResource ResidentBorderBrush}" Background="{StaticResource ResidentCardBackgroundBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Opis" FontSize="14"/>
                        <TextBlock
                                Text="{Binding Ad.Description}"
                                FontSize="18"
                                TextWrapping="Wrap"
                                FontWeight="Bold"/>
                    </StackPanel>
                </Border>


                <Border BorderBrush="{StaticResource ResidentBorderBrush}" Background="{StaticResource ResidentCardBackgroundBrush}" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="&#xf073;"
                            FontSize="22"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Opseg datuma" FontSize="14"/>
                            <TextBlock FontSize="18" FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:d. MMMM} — {1:d. MMMM}" ConverterCulture="sr-Latn-RS">
                                        <Binding Path="Ad.StartDate"/>
                                        <Binding Path="Ad.EndDate"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
        <Button
            Visibility="{Binding Ad.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Content="Arhiviraj"
            Background="{StaticResource ResidentDangerBrush}"
            Foreground="{StaticResource ResidentOnPrimaryBrush}"
            BorderBrush="{StaticResource ResidentDangerBrush}"
            FontSize="18"
            Width="192"
            Height="72"
            Click="ArchiveAdButton_Click"/>
    </Grid>
</navigation:MainNavigationConsumerPage>
