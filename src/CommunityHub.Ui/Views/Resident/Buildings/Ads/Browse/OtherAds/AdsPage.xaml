<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Ads.Browse.OtherAds.AdsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.Ads.Browse.OtherAds"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Oglasna tabla"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:AdTypeToStringConverter x:Key="AdTypeToStringConverter"/>
        <converters:AdCategoryToStringConverter x:Key="AdCategoryToStringConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        MouseLeftButtonDown="BackButton_Click"
                        Background="Transparent">
                        <TextBlock
                            Text="&#xf177;"
                            FontSize="24"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock
                        Grid.Column="1"
                        Text="Oglasna tabla"
                        FontSize="20"
                        VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid>
                        <Grid Visibility="{Binding HasAds, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl x:Name="AdsItemsControl" ItemsSource="{Binding Ads}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                 Padding="8"
                                                 Margin="0,0,0,8"
                                                 BorderBrush="{StaticResource ResidentBorderBrush}"
                                                 BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource ResidentCardBackgroundBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <Binding Path="IsOffer"/>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Background" Value="{StaticResource ResidentSurfaceBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Background="Transparent">
                                                    <Grid.InputBindings>
                                                        <MouseBinding
                                                            Gesture="LeftClick"
                                                            Command="{Binding DataContext.OpenAdDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}" />
                                                    </Grid.InputBindings>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock FontSize="18" FontWeight="Bold">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} — {1}">
                                                                    <Binding Path="Type" Converter="{StaticResource AdTypeToStringConverter}"/>
                                                                    <Binding Path="Category" Converter="{StaticResource AdCategoryToStringConverter}"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>

                                                        <Separator Height="2" Opacity="0"/>

                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                 Grid.Column="1"
                                                                 Text="&#xf007;"
                                                                 FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                                 VerticalAlignment="Center"
                                                                 FontSize="16"
                                                                 Padding="0"/>

                                                            <Separator Width="8" Opacity="0"/>

                                                            <TextBlock FontSize="14">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                                        <Binding Path="Author.Name"/>
                                                                        <Binding Path="Author.Surname"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <Separator Height="2" Opacity="0"/>

                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                 Grid.Column="1"
                                                                 Text="&#xf073;"
                                                                 FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                                 VerticalAlignment="Center"
                                                                 FontSize="16"
                                                                 Padding="0"/>

                                                            <Separator Width="8" Opacity="0"/>

                                                            <TextBlock FontSize="14">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:d. MMMM} — {1:d. MMMM}" ConverterCulture="sr-Latn-RS">
                                                                        <Binding
                                                                    Path="StartDate"/>
                                                                        <Binding
                                                                    Path="EndDate"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>

                                                    </StackPanel>

                                                    <TextBlock
                                                         Grid.Column="1"
                                                         Text="&#xf178;"
                                                         FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                         VerticalAlignment="Center"
                                                         FontSize="24"
                                                         Margin="0,0,8,0"
                                                         Padding="0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Height="64" Margin="0,8"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid Visibility="{Binding HasAds, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Label Content="Nema oglasa" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock
                             Text="Trenutno nema oglasa na oglasnoj tabli ove zgrade. Svoj prvi oglas možete kreirati klikom na dugme ispod."
                             TextWrapping="Wrap" 
                             TextAlignment="Center"
                             FontSize="16"
                             HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Button
                Content="&#x2b;"
                Foreground="{StaticResource ResidentOnPrimaryBrush}"
                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                FontSize="24"
                Margin="16"
                BorderThickness="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Command="{Binding OpenCreateAdCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="ResidentFloatingBackground" Width="64" Height="64" Fill="{StaticResource ResidentPrimaryBrush}" Stroke="{StaticResource ResidentActionBorderBrush}" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResidentFloatingBackground" Property="Fill" Value="{StaticResource ResidentPrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
