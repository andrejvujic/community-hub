<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Ads.OtherAds.AdTimeSlotsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Buildings.Ads.OtherAds"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Rezervisnje termina oglasa"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:IEnumerableContainsToBooleanConverter x:Key="IEnumerableContainsToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>
    <Grid>
        <Grid Visibility="{Binding HasReservableTimeSlots, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding ReservableTimeSlotGroups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="4"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Text="{Binding Day, StringFormat='{}{0:d. MMMM}', ConverterCulture='sr-Latn-RS'}"/>

                                    <Border
                                        Grid.Row="2"
                                        BorderBrush="Gray"
                                        BorderThickness="1">
                                        <ItemsControl ItemsSource="{Binding TimeSlots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Grid.Row="2"
                                                        Background="#dedede"
                                                        BorderBrush="Gray"
                                                        BorderThickness="1"
                                                        Margin="8"
                                                        Padding="8">
                                                        <Grid Background="Transparent" MouseLeftButtonDown="TimeSlotItem_Click">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <TextBlock
                                                                    Text="&#xf017;"
                                                                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="16"/>

                                                                <Separator Width="8" Opacity="0"/>

                                                                <TextBlock FontSize="18" VerticalAlignment="Center">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="{}{0:HH.mm} — {1:HH.mm}">
                                                                            <Binding Path="StartTime"/>
                                                                            <Binding Path="EndTime"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <Grid Grid.Column="2" Height="36">
                                                                <TextBlock
                                                                        Visibility="{Binding IsReserved, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                        Text="Zauzeto"
                                                                        FontSize="18"
                                                                        VerticalAlignment="Center"/>

                                                                <Border
                                                                        Visibility="{Binding IsReserved, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                                        BorderThickness="1"
                                                                        BorderBrush="Gray"
                                                                        Background="White"
                                                                        Width="36">
                                                                    <TextBlock
                                                                        Text="&#xf00c;"
                                                                        FontSize="24"
                                                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Value="True">
                                                                                        <DataTrigger.Binding>
                                                                                            <MultiBinding Converter="{StaticResource IEnumerableContainsToBooleanConverter}">
                                                                                                <Binding Path="DataContext.SelectedTimeSlots"
                                                                                                    RelativeSource="{RelativeSource AncestorType=Page}"/>
                                                                                                <Binding/>
                                                                                            </MultiBinding>
                                                                                        </DataTrigger.Binding>
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Height="72" Margin="0,8"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding HasReservableTimeSlots, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="8">
            <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label Content="Rezervacija termina nije moguća" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock
                    Text="Rezervacija nije moguća jer nemate odgovarajuće slobodne termine na svom oglasu u ovoj kategoriji. Provjerite da li imate objavljen oglas u ovoj kategoriji i da li na njemu postoje odgovarajuće slobodni termini."
                    TextWrapping="Wrap" 
                    TextAlignment="Center"
                    FontSize="16"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Button
            Visibility="{Binding HasReservableTimeSlots, Converter={StaticResource BooleanToVisibilityConverter}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Content="Rezerviši"
            FontSize="18"
            Width="192"
            Height="72"
            IsEnabled="{Binding HasSelectedTimeSlots}"
            Click="ReserveButton_Click"/>
    </Grid>
</navigation:MainNavigationConsumerPage>
