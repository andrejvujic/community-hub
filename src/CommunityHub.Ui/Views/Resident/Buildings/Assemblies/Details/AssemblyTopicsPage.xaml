<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Assemblies.Details.AssemblyTopicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Teme skupštine"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>

    <Grid>
        <Grid
            Margin="8"
            Visibility="{Binding HasTopics, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Prihvaćene teme" FontSize="20"/>
                    <Separator Margin="0,8"/>

                    <ItemsControl ItemsSource="{Binding TopicGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Text="&#xf007;"
                                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                            FontSize="16"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                        <TextBlock FontSize="18" FontWeight="Bold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="Author.Name"/>
                                                    <Binding Path="Author.Surname"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock
                                            Text=" (upravnik)"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Visibility="{Binding IsEnforcedByManager, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Topics}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Padding="12"
                                                    Margin="0,0,0,8"
                                                    Background="{StaticResource ResidentCardBackgroundBrush}"
                                                    BorderBrush="{StaticResource ResidentBorderBrush}"
                                                    BorderThickness="1">
                                                    <TextBlock
                                                        TextWrapping="Wrap"
                                                        FontSize="16">
                                                        <Run Text="— "/>
                                                        <Run Text="{Binding Description}"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Height="72" Margin="0,16"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding HasTopics, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Label
                    Content="Nema prihvaćenih tema"
                    FontSize="20"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Text="Za ovu skupštinu trenutno nema tema koje je upravnik prihvatio."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    FontSize="16"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Button
            Content="Predloži teme"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,8,0,16"
            Command="{Binding OpenSuggestedTopicsCommand}"
            Style="{StaticResource ResidentPrimaryActionButtonStyle}"
            FontSize="18"
            Width="208"
            Height="72"/>
    </Grid>
</navigation:MainNavigationConsumerPage>
