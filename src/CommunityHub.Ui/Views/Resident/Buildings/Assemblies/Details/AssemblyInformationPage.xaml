<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Assemblies.Details.AssemblyInformationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Informacije o skupštini"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <converters:AssemblyStatusToStringConverter x:Key="AssemblyStatusToStringConverter"/>
        <converters:AssemblyStatusToIconCodeConverter x:Key="AssemblyStatusToIconCodeConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <Border
                    BorderBrush="{StaticResource ResidentBorderBrush}"
                    Background="{StaticResource ResidentCardBackgroundBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="&#xf133;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Datum i vrijeme održavanja" FontSize="14"/>
                            <TextBlock
                                Text="{Binding Assembly.StartsAt, StringFormat='{}{0:d. MMMM yyyy.} — {0:HH.mm}', ConverterCulture=sr-Latn-RS}"
                                FontSize="18"
                                FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    BorderBrush="{StaticResource ResidentBorderBrush}"
                    Background="{StaticResource ResidentCardBackgroundBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding Assembly.Status, Converter={StaticResource AssemblyStatusToIconCodeConverter}}"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Status" FontSize="14"/>
                            <TextBlock
                                Text="{Binding Assembly.Status, Converter={StaticResource AssemblyStatusToStringConverter}}"
                                FontSize="18"
                                FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock
                    FontSize="18"
                    Foreground="{StaticResource ResidentTextSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="{Binding AttendancePercentage, StringFormat='{}{0}% stanova je potvrdilo svoje prisustvo na ovoj skupštini. ', Mode=OneWay}" FontWeight="Bold"
                />

                <StackPanel Visibility="{Binding HasConfirmedAttendance, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Separator Background="{StaticResource ResidentBorderBrush}" Height="16"/>
                    <StackPanel
                    Orientation="Horizontal">
                        <TextBlock
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            Text="&#xf058;"
                            Foreground="{StaticResource ResidentTextSecondaryBrush}"
                            FontWeight="Bold"
                            FontSize="18"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Text="Potvrdili ste svoje prisustvo"
                            Foreground="{StaticResource ResidentTextSecondaryBrush}"
                            FontWeight="Bold"
                            FontSize="18"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button
            Grid.Row="1"
            HorizontalAlignment="Center"
            Margin="0,8,0,16"
            Content="{Binding AttendanceActionText}"
            Command="{Binding ToggleAttendanceCommand}"
            Style="{StaticResource ResidentPrimaryActionButtonStyle}"
            FontSize="18"
            Width="208"
            Height="72"/>
    </Grid>
</navigation:MainNavigationConsumerPage>
