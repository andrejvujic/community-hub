<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Assemblies.Details.SuggestedAssemblyTopicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Moji prijedlozi tema"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:AssemblyTopicStatusToStringConverter x:Key="AssemblyTopicStatusToStringConverter"/>
        <converters:AssemblyTopicStatusToIconCodeConverter x:Key="AssemblyTopicStatusToIconCodeConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                MouseLeftButtonDown="BackButton_Click"
                Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <TextBlock
                Grid.Column="1"
                Text="Moji prijedlozi tema"
                FontSize="20"
                VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <ScrollViewer
                Visibility="{Binding HasTopics, Converter={StaticResource BooleanToVisibilityConverter}}"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Topics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="12"
                                    Margin="0,0,0,8"
                                    Background="{StaticResource ResidentCardBackgroundBrush}"
                                    BorderBrush="{StaticResource ResidentBorderBrush}"
                                    BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap"
                                            FontSize="18"
                                            FontWeight="SemiBold"/>
                                        <Separator Height="8" Opacity="0"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Text="{Binding Status, Converter={StaticResource AssemblyTopicStatusToIconCodeConverter}}"
                                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                FontSize="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource ResidentTextSecondaryBrush}"/>
                                            <TextBlock
                                                Text="{Binding Status, Converter={StaticResource AssemblyTopicStatusToStringConverter}}"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource ResidentTextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Visibility="{Binding HasTopics, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                Margin="32,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Label
                    Content="Nemate predloženih tema"
                    FontSize="20"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Text="Još uvijek niste predložili nijednu temu za ovu skupštinu."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    FontSize="16"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
