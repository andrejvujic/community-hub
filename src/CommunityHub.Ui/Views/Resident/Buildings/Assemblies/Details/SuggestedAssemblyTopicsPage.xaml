<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Assemblies.Details.SuggestedAssemblyTopicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Moji prijedlozi tema"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:AssemblyTopicStatusToStringConverter x:Key="AssemblyTopicStatusToStringConverter"/>
        <converters:AssemblyTopicStatusToIconCodeConverter x:Key="AssemblyTopicStatusToIconCodeConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                MouseLeftButtonDown="BackButton_Click"
                Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <TextBlock
                Grid.Column="1"
                Text="Moji prijedlozi tema"
                FontSize="20"
                VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock
                    Text="Predložite novu temu za skupštinu"
                    FontSize="20"
                    Margin="0,0,0,8"/>
                <TextBox
                    FontSize="18"
                    Height="96"
                    Padding="4"
                    MaxLength="128"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Background="{StaticResource ResidentInputBackgroundBrush}"
                    BorderBrush="{StaticResource ResidentBorderBrush}"
                    Margin="0,0,0,8"/>
                <Button
                    Content="Dodaj temu"
                    IsEnabled="{Binding IsFormValid}"
                    Command="{Binding SuggestTopicCommand}"
                    Style="{StaticResource ResidentPrimaryActionButtonStyle}"
                    FontSize="18"
                    Height="56"
                    Width="192"
                    HorizontalAlignment="Center"/>
            </StackPanel>

            <Separator Grid.Row="1" Margin="0,16"/>

            <TextBlock
                Grid.Row="2"
                Text="Moji prijedlozi"
                FontSize="20"
                Margin="0,0,0,8"/>

            <Grid Grid.Row="3">
                <ScrollViewer
                    Visibility="{Binding HasTopics, Converter={StaticResource BooleanToVisibilityConverter}}"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Topics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="12"
                                    Margin="0,0,0,8"
                                    Background="{StaticResource ResidentCardBackgroundBrush}"
                                    BorderBrush="{StaticResource ResidentBorderBrush}"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <Grid Grid.Row="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Grid.Row="0"
                                                    Text="{Binding Description}"
                                                    TextWrapping="Wrap"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"/>

                                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Text="{Binding Status, Converter={StaticResource AssemblyTopicStatusToIconCodeConverter}}"
                                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                        FontSize="16"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource ResidentTextSecondaryBrush}"/>
                                                    <TextBlock
                                                        Text="{Binding Status, Converter={StaticResource AssemblyTopicStatusToStringConverter}}"
                                                        FontSize="16"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource ResidentTextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <Button
                                            Grid.Column="2"
                                            Height="48"
                                            Width="48"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource ResidentPrimaryActionButtonStyle}"
                                            Command="{Binding DataContext.RemoveTopicCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanBeRemovedByResident, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock
                                                Text="&#xf2ed;"
                                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                FontSize="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel
                    Visibility="{Binding HasTopics, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Margin="32,16"
                    HorizontalAlignment="Center">
                    <Label
                        Content="Nemate predloženih tema"
                        FontSize="20"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="Još uvijek niste predložili nijednu temu za ovu skupštinu."
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        FontSize="16"
                        HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
