<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Buildings.Assemblies.AssembliesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d"
      Title="Skupštine stanara"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">
    <navigation:MainNavigationConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:AssemblyStatusToStringConverter x:Key="AssemblyStatusToStringConverter"/>
        <converters:AssemblyStatusToIconCodeConverter x:Key="AssemblyStatusToIconCodeConverter"/>
    </navigation:MainNavigationConsumerPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                MouseLeftButtonDown="BackButton_Click"
                Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <TextBlock
                Grid.Column="1"
                Text="Skupštine stanara"
                FontSize="20"
                VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <ScrollViewer
                Visibility="{Binding HasAssemblies, Converter={StaticResource BooleanToVisibilityConverter}}"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Visibility="{Binding HasUpcomingAssemblies, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Predstojeće skupštine" FontSize="20"/>
                        <Separator Margin="0,8"/>

                        <ItemsControl ItemsSource="{Binding UpcomingAssemblies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" Margin="0,0,0,8">
                                        <Grid.InputBindings>
                                            <MouseBinding
                                                Gesture="LeftClick"
                                                Command="{Binding DataContext.OpenAssemblyDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>
                                        <Border
                                            Padding="8"
                                            Background="{StaticResource ResidentCardBackgroundBrush}"
                                            BorderBrush="{StaticResource ResidentBorderBrush}"
                                            BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock
                                                        Text="{Binding StartsAt, StringFormat='{}{0:d. MMMM yyyy.} — {0:HH.mm}', ConverterCulture=sr-Latn-RS}"
                                                        FontSize="16"/>
                                                    <Separator Height="2" Opacity="0"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            Text="{Binding Status, Converter={StaticResource AssemblyStatusToIconCodeConverter}}"
                                                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Margin="0,0,8,0"/>
                                                        <TextBlock
                                                            Text="{Binding Status, Converter={StaticResource AssemblyStatusToStringConverter}}"
                                                            FontSize="16"
                                                            FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="&#xf178;"
                                                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                    VerticalAlignment="Center"
                                                    FontSize="24"
                                                    Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>                                    
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasPreviousAssemblies, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Text="Prethodne skupštine"
                            FontSize="20"
                            Margin="0,8,0,0"/>
                        <Separator Margin="0,8"/>

                        <ItemsControl ItemsSource="{Binding PreviousAssemblies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                     <Grid Background="Transparent" Margin="0,0,0,8">
                                        <Grid.InputBindings>
                                            <MouseBinding
                                                Gesture="LeftClick"
                                                Command="{Binding DataContext.OpenAssemblyDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>
                                        <Border
                                            Padding="8"
                                            Margin="0,0,0,8"
                                            Background="{StaticResource ResidentCardBackgroundBrush}"
                                            BorderBrush="{StaticResource ResidentBorderBrush}"
                                            BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock
                                                        Text="{Binding StartsAt, StringFormat='{}{0:d. MMMM yyyy.} — {0:HH.mm}', ConverterCulture=sr-Latn-RS}"
                                                        FontSize="16"/>
                                                    <Separator Height="2" Opacity="0"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            Text="{Binding Status, Converter={StaticResource AssemblyStatusToIconCodeConverter}}"
                                                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Margin="0,0,8,0"/>
                                                        <TextBlock
                                                            Text="{Binding Status, Converter={StaticResource AssemblyStatusToStringConverter}}"
                                                            FontSize="16"
                                                            FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="&#xf178;"
                                                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                    VerticalAlignment="Center"
                                                    FontSize="24"
                                                    Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Visibility="{Binding HasAssemblies, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                Margin="32,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Label
                    Content="Nema skupština stanara"
                    FontSize="20"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Text="Za ovu zgradu trenutno nema skupština za prikazivanje."
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    FontSize="16"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</navigation:MainNavigationConsumerPage>
