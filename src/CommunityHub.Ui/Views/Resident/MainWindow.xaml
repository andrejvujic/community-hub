<navigation:MainNavigatorHostWindow
        x:Class="CommunityHub.Ui.Views.Resident.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident"
        xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
        mc:Ignorable="d"
        Height="750" Width="430"
        Title="Community Hub"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        <Grid
            x:Name="AlertRoot"
            Background="#bb000000"
            Visibility="Collapsed">
            <Grid
                Background="White"
                Margin="16"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="8,8,8,0">
                    <TextBlock
                        x:Name="AlertTypeTextBlock"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"/>

                    <Separator Width="8" Opacity="0"/>

                    <TextBlock
                        x:Name="AlertTitleTextBlock"
                        FontSize="20"
                        FontWeight="Bold"
                        TextWrapping="Wrap">
                    </TextBlock>
                </StackPanel>

                <TextBlock
                    x:Name="AlertMessageTextBlock"
                    Grid.Row="1"
                    FontSize="18"
                    Margin="8,8,8,0"
                    TextWrapping="Wrap">
                </TextBlock>

                <Separator Grid.Row="2" Margin="8, 0" />

                <UniformGrid x:Name="AlertOptionsPanel" Grid.Row="3" Margin="8" Rows="1"/>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigatorHostWindow>
