<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Notifications.Details.AdReservationNotificationDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Notifications.Details"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      mc:Ignorable="d" 
      Title="Detalji o obavještenju"
      FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#dedede">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    MouseLeftButtonDown="BackButton_Click"
                    Background="Transparent">
                    <TextBlock
                        Text="&#xf177;"
                        FontSize="24"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    Text="Detalji o obavještenju"
                    FontSize="20"
                    VerticalAlignment="Center">
                </TextBlock>
            </Grid>

            <Grid Grid.Row="1" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock
                            Width="24"
                            Height="24"
                            Margin="0,0,4,0"
                            FontSize="20"
                            Text="&#xf133;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            VerticalAlignment="Center"/>

                        <Separator Width="2" Opacity="0" />

                        <TextBlock
                            FontSize="18"
                            Text="{Binding Notification.SentAt, StringFormat='{}{0:d. MMMM yyyy.}', ConverterCulture='sr-Latn-RS'}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock
                            Width="24"
                            Height="24"
                            Margin="0,0,4,0"
                            FontSize="20"
                            Text="&#xf017;"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            VerticalAlignment="Center"/>

                        <Separator Width="2" Opacity="0"/>

                        <TextBlock
                            FontSize="18"
                            Text="{Binding Notification.SentAt, StringFormat='{}{0:HH.mm}h'}"/>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1"/>

                <TextBlock Grid.Row="2" FontSize="18" TextWrapping="Wrap">
                    <Run FontWeight="Bold">
                        <Run.Text>
                            <Binding Path="Notification.Title" Mode="OneWay"/>
                        </Run.Text>
                    </Run>
                    <Run Text="—"/>
                    <Run>
                        <Run.Text>
                            <Binding Path="Notification.Message" Mode="OneWay"/> 
                        </Run.Text>
                    </Run>
                </TextBlock>

                <Border
                     Grid.Row="4"
                     BorderThickness="1"
                     BorderBrush="Gray"
                     Background="#dedede"
                     Padding="16">
                    <Grid Background="Transparent" MouseLeftButtonDown="OpenAdButton_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                             Grid.Column="0"
                             FontSize="18"
                             Text="Prikaži oglas"/>

                        <TextBlock
                             Grid.Column="1"
                             Text="&#xf178;"
                             FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                             VerticalAlignment="Center"
                             FontSize="24"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigatorConsumerPage>
