<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Notifications.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.Resident.Notifications"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Obavještenja"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigatorConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NotificationStatusToIconCodeConverter x:Key="NotificationStatusToIconCodeConverter"/>
    </navigation:MainNavigatorConsumerPage.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#dedede">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid
                     Grid.Column="0"
                     MouseLeftButtonDown="BackButton_Click"
                     Background="Transparent">
                    <TextBlock
                         Text="&#xf177;"
                         FontSize="24"
                         FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                </Grid>

                <TextBlock
                     Grid.Column="1"
                     Text="Obavještenja"
                     FontSize="20"
                     VerticalAlignment="Center">
                </TextBlock>
            </Grid>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="8"
                                        BorderBrush="Gray"
                                        BorderThickness="1">
                                        <Grid Background="Transparent" MouseLeftButtonDown="NotificationItem_Click"> 
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="16"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="16"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="16"
                                                    Text="{Binding SentAt, StringFormat='{}{0: d. MMMM yyyy.} — {0: HH.mm}h', ConverterCulture='sr-Latn-RS'}"
                                                    VerticalAlignment="Center"/>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,4,0"
                                                    FontSize="20"
                                                    Text="{Binding Status, Converter={StaticResource NotificationStatusToIconCodeConverter}}"
                                                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                    VerticalAlignment="Center"/>
                                            </Grid>

                                            <Separator Grid.Row="1"/>

                                            <Grid Grid.Row="2">
                                                <Grid.RowDefinitions>
                                                    <!--
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="4"/>
                                                    -->
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!--
                                                <TextBlock
                                                    Grid.Row="0"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Text="{Binding Title}"
                                                />
                                                -->

                                                <TextBlock
                                                    Grid.Row="2"
                                                    FontSize="18"
                                                    Text="{Binding Message}"
                                                    TextWrapping="Wrap"
                                                />
                                            </Grid>

                                            <Separator Grid.Row="3"/>

                                             <Border
                                                Grid.Row="4"
                                                 BorderThickness="1"
                                                 BorderBrush="Gray"
                                                 Background="#dedede"
                                                 Padding="16">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>

                                                     <TextBlock
                                                         Grid.Column="0"
                                                         FontSize="18"
                                                         Text="Detalji o obavještenju"/>

                                                     <TextBlock
                                                         Grid.Column="1"
                                                         Text="&#xf178;"
                                                         FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                         VerticalAlignment="Center"
                                                         FontSize="24"/>
                                                 </Grid>
                                            </Border>
                                        </Grid>

                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding HasNotifications, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="Nema obavještenja" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock
                            Text="Još uvijek niste dobili nijedno obavještenje."
                            TextWrapping="Wrap" 
                            TextAlignment="Center"
                            FontSize="16"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigatorConsumerPage>
