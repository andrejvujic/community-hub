<navigation:MainNavigationConsumerPage x:Class="CommunityHub.Ui.Views.Resident.Tutorials.TutorialsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      mc:Ignorable="d"
      Title="Video tutorijali"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource ResidentPageBackgroundBrush}"
      Foreground="{StaticResource ResidentTextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ResidentHeaderBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                MouseLeftButtonDown="BackButton_Click"
                Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <TextBlock
                Grid.Column="1"
                Text="Video tutorijali"
                FontSize="20"
                VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TutorialVideos}" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16"
                            Margin="0,0,0,8"
                            Background="{StaticResource ResidentCardBackgroundBrush}"
                            BorderBrush="{StaticResource ResidentBorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand">
                            <Grid Background="Transparent">
                                <Grid.InputBindings>
                                    <MouseBinding
                                        Gesture="LeftClick"
                                        Command="{Binding DataContext.OpenVideoPlayerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}" />
                                </Grid.InputBindings>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="&#xf03d;"
                                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                    VerticalAlignment="Center"
                                    FontSize="22"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Title}"
                                    FontSize="18"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="&#xf178;"
                                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                    VerticalAlignment="Center"
                                    FontSize="24"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</navigation:MainNavigationConsumerPage>
