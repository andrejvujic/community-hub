<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages.StatisticsAndMeetingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <conv:MeetingStatusToStringConverter x:Key="MeetingStatusConverter"/>
        <conv:MeetingThemeToStringConverter x:Key="MeetingThemeConverter"/>
    </UserControl.Resources>

    <Grid Background="#F5F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Margin="15" CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,15,15,10">
                    <TextBlock Text="Moji kvartovi" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="NeighborhoodsListBox" 
                     Grid.Row="1" 
                     Margin="10,0,10,10"
                     ItemsSource="{Binding Neighborhoods}"
                     Style="{StaticResource NeighborhoodListBoxStyle}"
                     ItemContainerStyle="{StaticResource NeighborhoodListBoxItemStyle}"
                     ItemTemplate="{StaticResource NeighborhoodListItemTemplate}"
                     SelectionChanged="NeighborhoodsListBox_SelectionChanged">
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="0,15,15,15" Padding="8">
            <Grid x:Name="StatisticsAndMeetingsPanel" Visibility="Collapsed" Margin="0,15,15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" BorderBrush="Black"  BorderThickness="1" Margin="0,0,5,0" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="10">
                            <TextBlock Text="Statistika" FontSize="22" Margin="0,0,0,15"/>

                            <UniformGrid Columns="1">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Ukupan broj građana: " FontSize="15"/>
                                    <TextBlock x:Name="TotalCitizensTxt" FontSize="15" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Broj novih građana: " FontSize="15"/>
                                    <TextBlock x:Name="NewCitizensTxt" FontSize="15" Margin="5,0"/>
                                    <TextBlock x:Name="NewCitizensPercentTxt" FontSize="15"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Broj neaktivnih građana: " FontSize="15"/>
                                    <TextBlock x:Name="InactiveCitizensTxt" FontSize="15" Margin="5,0"/>
                                    <TextBlock x:Name="InactiveCitizensPercentTxt" FontSize="15"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Broj aktivnih građana: " FontSize="15"/>
                                    <TextBlock x:Name="ActiveCitizensTxt" FontSize="15" Margin="5,0"/>
                                    <TextBlock x:Name="ActiveCitizensPercentTxt" FontSize="15"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Broj istaknutih građana: " FontSize="15"/>
                                    <TextBlock x:Name="ProminentCitizensTxt" Text="0" FontSize="15" Margin="5,0"/>
                                    <TextBlock x:Name="ProminentCitizensPercentTxt" Text="(0%)" FontSize="15"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Broj građana od poverenja: " FontSize="15"/>
                                    <TextBlock x:Name="TrustworthyCitizensTxt" Text="0" FontSize="15" Margin="5,0"/>
                                    <TextBlock x:Name="TrustworthyCitizensPercentTxt" Text="(0%)" FontSize="15"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>

                        <Grid Grid.Row="1" x:Name="RecommendationContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" 
                                    BorderBrush="Black" 
                                    BorderThickness="1"
                                    Padding="15" 
                                    Background="White">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="&#xf0eb;"
                                                   FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free" 
                                                   FontSize="18" 
                                                   Foreground="#FFD700"
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="Preporuka sistema" FontSize="18" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock x:Name="WelcomeRecommendationText" TextWrapping="Wrap" FontSize="16" LineHeight="20" Visibility="Collapsed">
                                        <Run Text="U kvartu "/>
                                        <Run x:Name="WelcomeNeighborhoodNameRun" Text="NazivKvarta" FontWeight="Bold"/>
                                        <Run Text=" je primećeno da je najveći broj "/>
                                        <Run Text="novih" FontWeight="Bold"/>
                                        <Run Text=" građana."/>
                                        <LineBreak/> <Run Text="Predlažemo vam da zakažete sastanak "/>
                                        <Run Text="dobrodošlice." FontWeight="Bold"/>
                                    </TextBlock>

                                    <TextBlock x:Name="MotivationRecommendationText" TextWrapping="Wrap" FontSize="16" LineHeight="20" Visibility="Collapsed">
                                        <Run Text="U kvartu "/>
                                        <Run x:Name="MotivationNeighborhoodNameRun" Text="NazivKvarta" FontWeight="Bold"/>
                                        <Run Text=" je primećeno da je najveći broj "/>
                                        <Run Text="neaktivnih" FontWeight="Bold"/>
                                        <Run Text=" građana."/>
                                        <LineBreak/> <Run Text="Predlažemo vam da zakažete sastanak "/>
                                        <Run Text="motivacije." FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Button x:Name="WelcomeMeetingButton" 
                                    Grid.Row="1" 
                                    Margin="0,10,0,0"
                                    Height="40"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="WelcomeMeetingButton_Click">
                                <TextBlock Text="Zakaži sastanak dobrodošlice"/>
                            </Button>

                            <Button x:Name="MotivationMeetingButton" 
                                    Grid.Row="1" 
                                    Margin="0,10,0,0"
                                    Height="40"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="MotivationMeetingButton_Click">
                                <TextBlock Text="Zakaži sastanak motivacije"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Background="White" Margin="5,0,0,0" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="80" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Sastanci" FontSize="22" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Padding="5" Cursor="Hand" Click="ScheduleNewMeetingButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xf067;" 
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Zakaži novi sastanak (Ctrl + N)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <DataGrid x:Name="MeetingsDataGrid"
                                  ItemsSource="{Binding Meetings}"
                                  Grid.Row="1" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserResizeRows="False"
                                  CanUserResizeColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  FontSize="16"
                                  SelectionChanged="MeetingsDataGrid_SelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTied}" Value="True">
                                            <Setter Property="Background" Value="#FFF4CE"/>
                                            <Setter Property="ToolTip" Value="Nerešen broj glasova! Potreban odabir konačnog datuma."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tema" Binding="{Binding Theme, Converter={StaticResource MeetingThemeConverter}}" Width="130"/>
                                <DataGridTextColumn Header="Vreme" Binding="{Binding MeetingTime}" Width="100"/>
                                <DataGridTextColumn Header="Datum-opseg" Binding="{Binding DisplayDate}" Width="1.5*"/>
                                <DataGridTextColumn Header="Stanje" Binding="{Binding Status, Converter={StaticResource MeetingStatusConverter}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="TiedDatesPanel" 
                                        Grid.Row="0"
                                        Orientation="Vertical" 
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0">
                                <TextBlock Text="Odredite konačan termin" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <ComboBox x:Name="TiedDatesComboBox"
                                          SelectionChanged="TiedDatesComboBox_SelectionChanged"
                                          HorizontalAlignment="Center"
                                          Width="150"
                                          FontSize="14"
                                          Height="30"
                                          Margin="0,0,10,0"/>
                            </StackPanel>

                            <Button x:Name="ConfirmTermButton"
                                    Grid.Column="1" 
                                    HorizontalAlignment="Center"
                                    Content="Potvrdite konačan termin" 
                                    VerticalAlignment="Bottom"
                                    Padding="15,8"
                                    Cursor="Hand"
                                    IsEnabled="False"
                                    Click="ConfirmTermButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
