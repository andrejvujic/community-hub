<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages.RequestsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages"
        xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        xmlns:domain="clr-namespace:CommunityHub.Application.Domain;assembly=CommunityHub.Application"
        mc:Ignorable="d">

    <UserControl.Resources>
        <conv:StatusToStringConverter x:Key="StatusToStringConverter" />
        <conv:StatusToIconCodeConverter x:Key="StatusToIconCodeConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zahtevi:" 
                   FontSize="25" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,10" HorizontalAlignment="Right">
            <TextBlock  Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        FontSize="30"
                        Text="&#xf002;"/>
            <ComboBox x:Name="StatusFilterComboBox" 
                      SelectionChanged="StatusFilterComboBox_SelectionChanged"
                      SelectedIndex="0" 
                      Width="140" 
                      FontSize="16">
                <ComboBoxItem Content="Svi" />
                <ComboBoxItem Tag="{x:Static domain:Status.Waiting}" 
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource StatusToStringConverter}}" />
                <ComboBoxItem Tag="{x:Static domain:Status.Accepted}" 
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource StatusToStringConverter}}" />
                <ComboBoxItem Tag="{x:Static domain:Status.Rejected}" 
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource StatusToStringConverter}}" />
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="RequestsDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="RequestsDataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Ime" Binding="{Binding Citizen.Name}" CanUserSort="False" Width="*" />
                <DataGridTextColumn Header="Prezime" Binding="{Binding Citizen.Surname}" CanUserSort="False" Width="*" />
                <DataGridTextColumn Header="Adresa" Width="2*">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1}, {2}">
                            <Binding Path="Citizen.Address.Street.Name" />
                            <Binding Path="Citizen.Address.StreetNumber" />
                            <Binding Path="Citizen.Address.City.Name" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Kvart" Binding="{Binding Neighborhood.Name}" CanUserSort="False" Width="*" />

                <DataGridTextColumn Header="Datum" 
                                    Binding="{Binding CreationDate, StringFormat=\{0:dd.MM.yyyy.\}}"
                                    Width="150"
                                    CanUserSort="True"
                                    SortMemberPath="Datum"/>

                <DataGridTemplateColumn Header="Status" CanUserSort="False" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToIconCodeConverter}}" 
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free" 
                                               Margin="5,0"/>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">

            <Button x:Name="RejectButton"
                    Click="RejectButton_Click"
                    IsEnabled="False"
                    Margin="0,0,10,0" 
                    Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xf00d;"
                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="Odbij zahtev"/>
                </StackPanel>
            </Button>

            <Button x:Name="AcceptButton" 
                    Click="AcceptButton_Click" 
                    IsEnabled="False" 
                    Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xf00c;"
                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="Prihvati zahtev"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
