<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages.FacilityBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages"
        mc:Ignorable="d"
        Title="Potvrda i provera termina"
        Height="420" 
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   FontSize="20" FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="1"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <TextBlock Grid.Row="2" Text="Detalji:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock x:Name="NeighborhoodTextBlock" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock x:Name="FacilityTextBlock" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock x:Name="SlotTextBlock" FontSize="14" Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel x:Name="ComboPanel" Grid.Row="4" Visibility="Collapsed" Margin="0,0,0,16">
            <TextBlock Text="Odaberite termin:" FontSize="14" Margin="0,0,0,6"/>
            <ComboBox x:Name="SlotsComboBox"
                      FontSize="14" Height="35">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Odustani"
                    Height="40" 
                    Margin="0,0,8,0"
                    FontSize="14" 
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="1"
                    Content="Potvrdi rezervaciju"
                    Height="40" Margin="8,0,0,0"
                    FontSize="14" Cursor="Hand"
                    Click="ConfirmButton_Click"/>
        </Grid>
    </Grid>
</Window>
