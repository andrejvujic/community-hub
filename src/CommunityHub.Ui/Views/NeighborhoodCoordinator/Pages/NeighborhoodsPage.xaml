<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages.NeighborhoodsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:ParityToStringConverter x:Key="ParityConverter" />
    </UserControl.Resources>

    <Grid Background="#F5F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Margin="15" CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,15,15,10">
                    <TextBlock Text="Moji kvartovi" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Button HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Background="Transparent" 
                            BorderThickness="0"
                            Cursor="Hand" 
                            Click="RegisterButton_Click">
                        <TextBlock Text="&#xf055;" 
                                   FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                   FontSize="30"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <ListBox x:Name="NeighborhoodsListBox" 
                         Grid.Row="1" 
                         Margin="10,0,10,10"
                         ItemsSource="{Binding Neighborhoods}"
                         SelectionChanged="NeighborhoodsListBox_SelectionChanged"
                         Style="{StaticResource NeighborhoodListBoxStyle}"
                         ItemContainerStyle="{StaticResource NeighborhoodListBoxItemStyle}"
                         ItemTemplate="{StaticResource NeighborhoodListItemTemplate}">
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0,15,15,15">
            <Border Background="White" CornerRadius="12">

                <ScrollViewer x:Name="DetailsScrollViewer" Visibility="Collapsed" Padding="30">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="32" FontWeight="Bold" />

                        <TextBlock FontSize="18" Margin="0,5,0,15">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}, {1}">
                                    <Binding Path="City.Name" />
                                    <Binding Path="Country.Name" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <TextBlock Text="Opis kvarta" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock Text="{Binding Description}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <TextBlock Text="Galerija slika" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,25">
                            <ItemsControl ItemsSource="{Binding Images}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Path}" Height="180" Margin="0,0,15,0" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,250,180" RadiusX="10" RadiusY="10"/>
                                            </Image.Clip>
                                        </Image>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="Spisak ulica" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="StreetsDataGrid" 
                                  AutoGenerateColumns="False" 
                                  CanUserResizeColumns="False"
                                  CanUserSortColumns="False"
                                  IsReadOnly="True"
                                  Margin="0,0,0,25">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naziv ulice" Binding="{Binding Street.Name}" Width="*"/>
                                <DataGridTextColumn Header="Početni broj" Binding="{Binding StartNumber}" Width="120"/>
                                <DataGridTextColumn Header="Krajnji broj" Binding="{Binding EndNumber}" Width="120"/>
                                <DataGridTextColumn Header="Strana" Binding="{Binding Side, Converter={StaticResource ParityConverter}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Spisak članova" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="MembershipsDataGrid" 
                                  AutoGenerateColumns="False" 
                                  CanUserResizeColumns="False"
                                  CanUserSortColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ime" Binding="{Binding Name}" Width="0.9*"/>
                                <DataGridTextColumn Header="Prezime" Binding="{Binding Surname}" Width="0.9*"/>

                                <DataGridTextColumn Header="Adresa" Width="2*">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0} {1}, {2}">
                                            <Binding Path="Address.Street.Name" />
                                            <Binding Path="Address.StreetNumber" />
                                            <Binding Path="Address.City.Name" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Datum pristupa" 
                                                    Binding="{Binding Membership.AcceptanceDate, StringFormat=\{0:dd.MM.yyyy\}}" 
                                                    Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>