<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages.NeighborhoodsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages"
        mc:Ignorable="d">
    <Grid Background="#F5F6FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="Moji kvartovi" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/>

            <Button Content="Registruj novi kvart (Ctrl + N)" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center"
                    Padding="15,8"
                    FontWeight="SemiBold"
                    FontSize="20"
                    Cursor="Hand">
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">

            <ItemsControl x:Name="NeighborhoodsItemsControl" MaxWidth="1100">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                    Margin="0,0,0,8" 
                                    Padding="10">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Grad: " FontSize="18"/>
                                        <TextBlock Text="{Binding City.Name}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Država: " FontSize="18"/>
                                        <TextBlock Text="{Binding Country.Name}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>

                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{Binding Images[0].Path}" 
                                           Width="110" 
                                           Height="110" 
                                           Margin="5"
                                           Stretch="UniformToFill" />

                                    <Image Source="{Binding Images[1].Path}" 
                                           Width="110" 
                                           Height="110" 
                                           Margin="5"
                                           Stretch="UniformToFill" />

                                    <Image Source="{Binding Images[2].Path}" 
                                           Width="110" 
                                           Height="110" 
                                           Margin="5"
                                           Stretch="UniformToFill" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" 
                                                Orientation="Horizontal" 
                                                VerticalAlignment="Center" 
                                                Margin="15,0,5,0">
                                    <Button Content="Informacije" 
                                                Click="InfoButton_Click"
                                                Padding="12,6"
                                                Margin="0,0,8,0"
                                                Width="150"
                                                FontSize="20"
                                                Cursor="Hand"/>

                                    <Button Content="Članstva" 
                                                Click="MembershipsButton_Click"
                                                Padding="12,6"
                                                Width="150"
                                                FontSize="20"
                                                Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
