<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages.ServiceCenterTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <conv:BillingTypeToStringConverter x:Key="BillingConverter" />
    </UserControl.Resources>

    <Grid Background="#F5F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Margin="15" CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,15,15,10">
                    <TextBlock Text="Moji kvartovi" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="NeighborhoodsListBox" 
                         Grid.Row="1" 
                         Margin="10,0,10,10"
                         ItemsSource="{Binding Neighborhoods}"
                         Style="{StaticResource NeighborhoodListBoxStyle}"
                         ItemContainerStyle="{StaticResource NeighborhoodListBoxItemStyle}"
                         ItemTemplate="{StaticResource NeighborhoodListItemTemplate}"
                         SelectionChanged="NeighborhoodsListBox_SelectionChanged">
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="0,15,15,15" Padding="8">
            <Grid x:Name="NeighborhoodServiceDetails" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ServicesTitleTextBlock"
                               Grid.Row="0"
                               FontSize="22" 
                               Margin="0,0,0,15"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderThickness="2" BorderBrush="Black" Margin="0,0,7.5,0" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="JobListingsListBox"
                                         ItemsSource="{Binding JobListings}"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="LightGray" 
                                                    BorderThickness="1" 
                                                    CornerRadius="8" 
                                                    Margin="0,0,0,10" 
                                                    Padding="10" 
                                                    Width="257" 
                                                    Height="115">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="90" Height="90" Margin="0,0,10,0" CornerRadius="5" ClipToBounds="True">
                                                        <Image Source="{Binding WorkSamples[0].Path}" Stretch="UniformToFill" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ServiceName}" FontSize="16"/>

                                                        <TextBlock FontSize="13">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0} {1}">
                                                                    <Binding Path="Provider.Name"/>
                                                                    <Binding Path="Provider.Surname"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding CurrentPriceEntry.Amount, StringFormat='{}{0:N2} RSD'}" FontSize="12"/>
                                                        <TextBlock Text="{Binding BillingType, Converter={StaticResource BillingConverter}}" FontSize="12"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="White" BorderThickness="2" BorderBrush="Black" Margin="7.5,0,0,0" Padding="5">
                            <Grid x:Name="JobDetailsGrid" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.2*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Usluga: Naziv usluge" FontSize="26" Margin="0,0,0,5"/>
                                    <TextBlock Text="Serviser: Naziv servisera" FontSize="18" Margin="0,0,0,15"/>

                                    <TextBlock Text="Opis usluge:" FontSize="16" />
                                    <TextBlock Text="Ovde ce ici opis usluge." 
                                               TextWrapping="Wrap"
                                               FontSize="14" 
                                               Margin="0,5,0,20"/>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Slike:" FontSize="16" Margin="0,0,10,0"/>
                                            <Rectangle Width="120" Height="120" Fill="LightGray" RadiusX="8" RadiusY="8"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,10,0"
                                                    Cursor="Hand">
                                                <TextBlock Text="&#xf30a;" 
                                                           FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                           FontSize="16"/>
                                            </Button>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Margin="0,0,10,0"
                                                    Cursor="Hand">
                                                <TextBlock Text="&#xf30b;" 
                                                           FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                           FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="24" HorizontalAlignment="Left">
                                            <Run Text="Trenutna cena: "/>
                                            <Run Text="3000 RSD" />
                                        </TextBlock>
                                    
                                        <TextBlock Text="Plaćanje po usluzi" 
                                                   FontSize="20" 
                                                   Margin="0,5,0,25"
                                                   HorizontalAlignment="Left"/>

                                        <Button Content="Pronađi prvi slobodan termin" 
                                                FontSize="16" 
                                                Cursor="Hand"
                                                HorizontalAlignment="Center"
                                                Width="250"
                                                Height="50">
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Background="White" Margin="0,15,0,0" >
                    <Grid x:Name="ScheduledServicesGrid" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" x:Name="ScheduledServicesDataGrid" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserResizeRows="False"
                                  CanUserResizeColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  HeadersVisibility="Column"
                                  Margin="0,0,0,15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Usluga" Width="*"/>
                                <DataGridTextColumn Header="Serviser" Width="*"/>
                                <DataGridTextColumn Header="Datum i vreme" Width="200"/>
                                <DataGridTextColumn Header="Cena" Width="150"/>
                                <DataGridTextColumn Header="Status" Width="150"/>
                                <DataGridTextColumn Header="Ocena" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" >
                            <TextBlock Text="Izaberi ocenu:" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Width="70" FontSize="16" Margin="20,0,15,0">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                                <ComboBoxItem Content="5" />
                            </ComboBox>
                            <Button Content="Oceni uslugu"
                                    Width="150"
                                    Margin="0,0,70,0"
                                    FontSize="14"
                                    Cursor="Hand">
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
