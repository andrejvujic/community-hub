<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages.RegisterNeighborhoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages"
        xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        xmlns:domain="clr-namespace:CommunityHub.Application.Domain;assembly=CommunityHub.Application"
        mc:Ignorable="d"
        Title="Registracija kvarta" Height="800" Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ParityToStringConverter x:Key="ParityConverter" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Naziv kvarta:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="NameTextBox" Padding="8" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Opis kvarta:" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBox x:Name="DescriptionTextBox" Padding="5" AcceptsReturn="True" TextWrapping="Wrap" />
            </StackPanel>

            <GroupBox Grid.Row="2" Header="Lokacija" Margin="0,0,0,10" Padding="10">
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="Država:" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CountryComboBox" 
                                  ItemsSource="{Binding Countries}"
                                  DisplayMemberPath="Name"
                                  ToolTipService.ShowOnDisabled="True"
                                  Padding="5"
                                  SelectionChanged="CountryComboBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock Text="Grad:" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CityComboBox" 
                                  ItemsSource="{Binding Cities}"
                                  DisplayMemberPath="Name"
                                  ToolTipService.ShowOnDisabled="True"
                                  IsEnabled="False" 
                                  Padding="5"
                                  SelectionChanged="CityComboBox_SelectionChanged"/>
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Dodavanje ulica" Padding="10">
                <StackPanel>
                    <TextBlock Text="Ulica:" Margin="0,0,0,3"/>
                    <ComboBox x:Name="StreetComboBox" 
                              ItemsSource="{Binding Streets}"
                              DisplayMemberPath="Name"
                              IsEnabled="False" 
                              Padding="5" 
                              Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Od broja:" Margin="0,0,0,3"/>
                            <TextBox x:Name="StartNumberTextBox" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                            <TextBlock Text="Do broja:" Margin="0,0,0,3"/>
                            <TextBox x:Name="EndNumberTextBox" Padding="5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="5,0,5,0">
                            <TextBlock Text="Strana:" Margin="0,0,0,3"/>
                            <ComboBox x:Name="SideComboBox" 
                                      Padding="4"
                                      SelectedIndex="0">
                                <ComboBoxItem Tag="{x:Static domain:ParityType.Both}" 
                                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource ParityConverter}}" />
                                <ComboBoxItem Tag="{x:Static domain:ParityType.Even}" 
                                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource ParityConverter}}" />
                                <ComboBoxItem Tag="{x:Static domain:ParityType.Odd}" 
                                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource ParityConverter}}" />
                            </ComboBox>
                        </StackPanel>
                        <Button Content="Dodaj ulicu" Grid.Column="3" VerticalAlignment="Bottom" Padding="15,7" Margin="5,0,0,0" Cursor="Hand" Click="AddStreetSection_Click"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="Dodate ulice" Margin="0,15,0,0" Padding="5" Height="150">
                <ListBox x:Name="StreetSectionsListBox" 
                         ItemsSource="{Binding AddedStreetSections}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" 
                         Height="110">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="5,0,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}, br. {1} - {2} ({3})">
                                                <Binding Path="Street.Name" />
                                                <Binding Path="StartNumber" />
                                                <Binding Path="EndNumber" />
                                                <Binding Path="Side" Converter="{StaticResource ParityConverter}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Ukloni" Click="RemoveStreetSection_Click" Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GroupBox Grid.Row="5" Header="Slike kvarta" Margin="0,20,0,10" Padding="10">
                <StackPanel>
                    <Button Content="Odaberi slike..." 
                            HorizontalAlignment="Left" 
                            Padding="15,5" 
                            Margin="0,0,0,10" 
                            Click="SelectImages_Click" 
                            Cursor="Hand"/>

                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Background="#F9F9F9">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="5">
                            <ListBox x:Name="ImagesListBox" 
                                     ItemsSource="{Binding SelectedImagePaths}"
                                     BorderThickness="0" 
                                     Background="Transparent"
                                     MinHeight="160">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="8" 
                                                BorderBrush="#BDC3C7" 
                                                BorderThickness="1" 
                                                CornerRadius="5" 
                                                Background="White"
                                                Width="140">
                                            <StackPanel Margin="5">
                                                <Border CornerRadius="3" ClipToBounds="True" Margin="0,0,0,5">
                                                    <Image Source="{Binding}" 
                                                           Width="125" 
                                                           Height="125" 
                                                           Stretch="UniformToFill" />
                                                </Border>

                                                <Button Content="Ukloni" 
                                                        Click="RemoveImage_Click" 
                                                        Tag="{Binding}"
                                                        FontSize="11"
                                                        Padding="0,3"
                                                        Cursor="Hand">
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Odustani" 
                        Click="CancelButton_Click"
                        Margin="0,0,10,0" 
                        Padding="20,10" 
                        Cursor="Hand"/>
                <Button Content="Registruj Kvart" 
                        Click="RegisterButton_Click"
                        Padding="25,10" 
                        FontWeight="Bold" 
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>