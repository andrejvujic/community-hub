<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages.RequestsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages"
        mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zahtevi:" 
                   FontSize="25" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,10" HorizontalAlignment="Right">
            <TextBlock  Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        FontSize="30"
                        Text="&#xf002;"/>
            <ComboBox Width="180">
                <ComboBoxItem Content="Svi" IsSelected="True"/>
                <ComboBoxItem Content="Prihvaćen"/>
                <ComboBoxItem Content="Čeka odobrenje"/>
                <ComboBoxItem Content="Odbijen"/>
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="RequestsDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Ime" Binding="{Binding Ime}" CanUserSort="False" Width="*" />
                <DataGridTextColumn Header="Prezime" Binding="{Binding Prezime}" CanUserSort="False" Width="*" />
                <DataGridTextColumn Header="Adresa" Binding="{Binding Adresa}" CanUserSort="False" Width="2*" />
                <DataGridTextColumn Header="Kvart" Binding="{Binding Kvart}" CanUserSort="False" Width="*" />

                <DataGridTextColumn Header="Datum" 
                                    Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy.\}}"
                                    Width="150"
                                    CanUserSort="True"
                                    SortMemberPath="Datum"/>

                <DataGridTemplateColumn Header="Status" CanUserSort="False" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                <TextBlock Text="{Binding StatusIcon}" 
                                           FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free" 
                                           FontSize="14"
                                           Width="20"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding StatusText}" 
                                           VerticalAlignment="Center"
                                           Margin="5,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">

            <Button Margin="0,0,10,0" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xf00d;"
                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="Odbij zahtev"/>
                </StackPanel>
            </Button>

            <Button Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xf00c;"
                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="Prihvati zahtev"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
