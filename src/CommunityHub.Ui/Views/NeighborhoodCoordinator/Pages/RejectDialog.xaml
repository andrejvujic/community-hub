<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages.RejectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odbijanje zahteva" Height="250" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageLabel" 
                   Grid.Row="0" 
                   TextWrapping="Wrap" 
                   Margin="0,0,0,10" 
                   FontSize="14"/>
        <TextBox x:Name="CommentTextBox" 
                 Grid.Row="1" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Odustani" Click="Cancel_Click" Margin="0,0,10,0" Padding="15,5"/>
            <Button Content="Potvrdi" Click="Confirm_Click" Padding="15,5" />
        </StackPanel>
    </Grid>
</Window>