<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows.BookingConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows"
        mc:Ignorable="d"
        Title="Potvrda rezervacije termina"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock"
                   Grid.Row="0"
                   FontSize="16"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="SlotDateTextBlock"
                       FontSize="14"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="DurationTextBlock"
                       FontSize="14"
                       Visibility="Collapsed"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="HourlyRateTextBlock"
                       FontSize="14"
                       Visibility="Collapsed"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="TotalAmountTextBlock"
                       FontSize="14"
                       Visibility="Collapsed"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="CenaTextBlock"
                       FontSize="14"
                       Visibility="Collapsed"
                       Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel Grid.Row="2" 
                    Margin="0,0,0,12"
                    x:Name="PriceChangePanel"
                    Visibility="Collapsed">
            <TextBlock Text="Važno obaveštenje"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="PriceChangeInfoTextBlock"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
        </StackPanel>

        <TextBlock x:Name="QuestionTextBlock"
                   Grid.Row="3"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"
                   Text="Da li želite da zakažete ovaj termin?"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Odustani"
                    Height="40"
                    Margin="10,0,10,0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="1"
                    Content="Potvrdi"
                    Height="40"
                    Margin="10,0,10,0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="ConfirmButton_Click"/>
        </Grid>
    </Grid>
</Window>
    