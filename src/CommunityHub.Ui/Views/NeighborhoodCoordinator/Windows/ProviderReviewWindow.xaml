<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows.ProviderReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows"
        xmlns:ns="clr-namespace:CommunityHub.Ui.Resources.Localization"
        mc:Ignorable="d"
        Title="{ns:Loc Review_WindowTitle}"
        Height="380"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{ns:Loc Review_Quality}"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Width="265"/>
            <ComboBox Style="{StaticResource ComboBoxStyle}"
                      SelectedIndex="{Binding SelectedQualityIndex}"
                      Width="70" FontSize="14">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="5"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{ns:Loc Review_Communication}"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Width="265"/>
            <ComboBox Style="{StaticResource ComboBoxStyle}"
                      SelectedIndex="{Binding SelectedCommunicationIndex}"
                      Width="70" FontSize="14">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="5"/>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="{ns:Loc Review_Comment}"
                   FontSize="14"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="CommentTextBox"
                 Grid.Row="4"
                 Style="{StaticResource TextBoxStyle}"
                 FontSize="14"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 Margin="0,0,0,16"
                 Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="{ns:Loc Dialog_Cancel}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="40" 
                    Margin="0,0,8,0"
                    FontSize="14"
                    Command="{Binding CancelCommand}"/>
            <Button Grid.Column="1"
                    Content="{ns:Loc Dialog_Confirm}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="40" 
                    Margin="8,0,0,0"
                    FontSize="14"
                    Command="{Binding ConfirmCommand}"/>
        </Grid>
    </Grid>
</Window>
