<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows.RejectRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows"
        Title="Odbijanje zahteva" 
        Height="250" 
        Width="400" 
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="15"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageLabel" 
                   Grid.Row="0" 
                   TextWrapping="Wrap" 
                   Margin="0,0,0,10" 
                   FontSize="14"/>
        <TextBox x:Name="CommentTextBox" 
                 Grid.Row="1" 
                 Style="{StaticResource TextBoxStyle}"
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Odustani"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click"
                    Margin="0,0,10,0"
                    Padding="15,5"/>
            <Button Content="Potvrdi"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Confirm_Click"
                    Padding="15,5"/>
        </StackPanel>
    </Grid>
</Window>