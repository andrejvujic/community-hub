<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows.ScheduleMeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows"
        xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        xmlns:domain="clr-namespace:CommunityHub.Application.Domain.Neighborhoods.NeighborhoodMeetings;assembly=CommunityHub.Application"
        mc:Ignorable="d"
        Title="Zakazivanje sastanka" 
        Height="370" Width="450"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize">
    <Window.Resources>
        <conv:MeetingThemeToStringConverter x:Key="MeetingThemeConverter" />
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Tema sastanka: " FontSize="20" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock x:Name="FixedThemeTxt" FontSize="20" VerticalAlignment="Center" Visibility="Collapsed" />
            <ComboBox x:Name="ThemeComboBox" FontSize="20" Width="200" Height="30" Visibility="Collapsed">
                <ComboBoxItem Tag="{x:Static domain:MeetingTheme.Welcome}" 
                      Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource MeetingThemeConverter}}" />
                <ComboBoxItem Tag="{x:Static domain:MeetingTheme.Motivation}" 
                      Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource MeetingThemeConverter}}" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Vreme održavanja: " FontSize="20" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="HourTxt" FontSize="20" Width="40" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="2" Text="20"/>
            <TextBlock Text=" : " FontSize="20" VerticalAlignment="Center"/>
            <TextBox x:Name="MinuteTxt" FontSize="20" Width="40" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLength="2" Text="00"/>
            <TextBlock Text=" h" FontSize="20" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Datum održavanja u opsegu:" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Od" FontSize="20" Margin="0,0,0,5"/>
                <DatePicker x:Name="FromDatePicker" FontSize="20" Height="35">
                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="IsReadOnly" Value="True"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Do" FontSize="20" Margin="0,0,0,5"/>
                <DatePicker x:Name="ToDatePicker" FontSize="20" Height="35">
                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="IsReadOnly" Value="True"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,25,0,0">
            <Button Content="Odustani" 
                        HorizontalAlignment="Left" 
                        Width="170" 
                        Height="35" 
                        Click="CancelButton_Click"/>
            <Button Content="Pokreni glasanje" 
                        HorizontalAlignment="Right"
                        Width="170" 
                        Height="35" 
                        Click="StartVotingButton_Click"/>
        </Grid>
    </Grid>
</Window>
