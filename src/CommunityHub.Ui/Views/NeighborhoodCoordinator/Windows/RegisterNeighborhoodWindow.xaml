<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows.RegisterNeighborhoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows"
        xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        xmlns:domain="clr-namespace:CommunityHub.Application.Domain.Addresses;assembly=CommunityHub.Application"
        mc:Ignorable="d"
        Title="Registracija kvarta" Height="800" Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <conv:ParityToStringConverter x:Key="ParityConverter" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="25"
              TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="Naziv kvarta:" FontWeight="Bold"/>
                    <TextBlock Text=" *" Foreground="#C43D5A" FontWeight="Bold"/>
                </StackPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource TextBoxStyle}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                    <TextBlock Text="Opis kvarta:" FontWeight="Bold"/>
                    <TextBlock Text=" *" Foreground="#C43D5A" FontWeight="Bold"/>
                </StackPanel>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource TextBoxStyle}"
                         AcceptsReturn="True" 
                         TextWrapping="Wrap"/>
            </StackPanel>

            <GroupBox Grid.Row="2" 
                      Header="Lokacija" 
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Margin="0,0,0,10" 
                      Padding="10">
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Država:"/>
                            <TextBlock Text=" *" Foreground="#C43D5A" FontWeight="Bold"/>
                        </StackPanel>
                        <ComboBox x:Name="CountryComboBox"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding Countries}"
                                  SelectedItem="{Binding SelectedCountry}"
                                  IsEnabled="{Binding IsCountryEnabled}"
                                  ToolTip="{Binding LocationLockTooltip}"
                                  ToolTipService.ShowOnDisabled="True"
                                  Padding="5" />
                    </StackPanel>
                    <StackPanel Margin="5,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Grad:"/>
                            <TextBlock Text=" *" Foreground="#C43D5A" FontWeight="Bold"/>
                        </StackPanel>
                        <ComboBox x:Name="CityComboBox"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding Cities}"
                                  SelectedItem="{Binding SelectedCity}"
                                  IsEnabled="{Binding IsCityEnabled}"
                                  ToolTip="{Binding LocationLockTooltip}"
                                  ToolTipService.ShowOnDisabled="True"
                                  Padding="5" />
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <GroupBox Grid.Row="3" 
                      Header="Dodavanje ulica"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" 
                      Padding="10">
                <StackPanel>
                    <TextBlock Text="Ulica:" Margin="0,0,0,3"/>
                    <ComboBox x:Name="StreetComboBox"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemsSource="{Binding Streets}"
                              SelectedItem="{Binding SelectedStreet}"
                              IsEnabled="{Binding IsStreetEnabled}"
                              Padding="5"
                              Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Od broja:" Margin="0,0,0,3"/>
                            <TextBox x:Name="StartNumberTextBox" 
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding StartNumberInput, UpdateSourceTrigger=PropertyChanged}"
                                     TextAlignment="Right"
                                     Height="35"
                                     Padding="0"
                                     PreviewTextInput="NumberTextBox_PreviewTextInput"
                                     PreviewKeyDown="NumberTextBox_PreviewKeyDown">
                                <TextBox.ContextMenu>
                                    <ContextMenu Visibility="Collapsed"/>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                            <TextBlock Text="Do broja:" Margin="0,0,0,3"/>
                            <TextBox x:Name="EndNumberTextBox" 
                                     Style="{StaticResource TextBoxStyle}"
                                     Text="{Binding EndNumberInput, UpdateSourceTrigger=PropertyChanged}"
                                     TextAlignment="Right"
                                     Height="35"
                                     Padding="0"
                                     PreviewTextInput="NumberTextBox_PreviewTextInput"
                                     PreviewKeyDown="NumberTextBox_PreviewKeyDown">
                                <TextBox.ContextMenu>
                                    <ContextMenu Visibility="Collapsed"/>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="5,0,5,0">
                            <TextBlock Text="Strana:" Margin="0,0,0,3"/>
                            <ComboBox x:Name="SideComboBox" 
                                      Style="{StaticResource ComboBoxStyle}"
                                      SelectedIndex="0">
                                <ComboBoxItem Tag="{x:Static domain:ParityType.Both}" 
                                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource ParityConverter}}" />
                                <ComboBoxItem Tag="{x:Static domain:ParityType.Even}" 
                                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource ParityConverter}}" />
                                <ComboBoxItem Tag="{x:Static domain:ParityType.Odd}" 
                                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource ParityConverter}}" />
                            </ComboBox>
                        </StackPanel>
                        <Button Content="Dodaj ulicu" 
                                Grid.Column="3" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                VerticalAlignment="Bottom" 
                                Margin="5,0,0,0" 
                                Command="{Binding AddStreetSectionCommand}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="4" 
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Margin="0,15,0,0" 
                      Padding="5" 
                      Height="150">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Dodate ulice" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text=" *" Foreground="#C43D5A" FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox.Header>
                <ListBox x:Name="StreetSectionsListBox" 
                         ItemsSource="{Binding AddedStreetSections}"
                         Background="{DynamicResource PanelBackgroundBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         VerticalContentAlignment="Center"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" 
                         Height="110">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="5,0,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}, br. {1} - {2} ({3})">
                                                <Binding Path="Street.Name" />
                                                <Binding Path="StartNumber" />
                                                <Binding Path="EndNumber" />
                                                <Binding Path="Side" Converter="{StaticResource ParityConverter}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Content="Ukloni" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,0"
                                        Command="{Binding DataContext.RemoveStreetSectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GroupBox Grid.Row="5"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Margin="0,20,0,10"
                      Padding="10">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Slike kvarta" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text=" *" Foreground="#C43D5A" FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox.Header>
                <StackPanel>
                    <Button Content="Odaberi slike..."
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="15,5"
                            Margin="0,0,0,10"
                            Command="{Binding SelectImagesCommand}"/>

                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{DynamicResource SurfaceBackgroundBrush}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Disabled" 
                                      Padding="5">
                            <ListBox x:Name="ImagesListBox" 
                                     ItemsSource="{Binding SelectedImagePaths}"
                                     BorderThickness="0" 
                                     Background="Transparent"
                                     MinHeight="160">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="8" 
                                                BorderBrush="{DynamicResource ItemBorderBrush}"
                                                BorderThickness="1" 
                                                CornerRadius="5" 
                                                Background="{DynamicResource PanelBackgroundBrush}"
                                                Width="140">
                                            <StackPanel Margin="5">
                                                <Border CornerRadius="3" ClipToBounds="True" Margin="0,0,0,5">
                                                    <Image Source="{Binding}" 
                                                           Width="125" 
                                                           Height="125" 
                                                           Stretch="UniformToFill" />
                                                </Border>
                                                <Button Content="Ukloni"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Tag="{Binding}"
                                                        FontSize="11"
                                                        Padding="0,3"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Odustani"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,10,0"
                        Padding="20,10"/>
                <Button Content="Registruj Kvart"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RegisterCommand}"
                        Padding="25,10"
                        FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>