<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows.ServiceBookingConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Windows"
        mc:Ignorable="d"
        Title="Potvrda rezervacije termina"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Header}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding SlotDateText}"
                       FontSize="14"
                       Margin="0,0,0,4"/>
            <TextBlock Text="{Binding DurationText}"
                       FontSize="14" 
                       Margin="0,0,0,4"
                       Visibility="{Binding PerHourVisibility}"/>
            <TextBlock Text="{Binding HourlyRateText}"
                       FontSize="14" 
                       Margin="0,0,0,4"
                       Visibility="{Binding PerHourVisibility}"/>
            <TextBlock Text="{Binding TotalAmountText}"
                       FontSize="14" 
                       Margin="0,0,0,4"
                       Visibility="{Binding PerHourVisibility}"/>
            <TextBlock Text="{Binding PerJobPriceText}"
                       FontSize="14" 
                       Margin="0,0,0,4"
                       Visibility="{Binding PerJobVisibility}"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,12"
                    Visibility="{Binding PriceChangeVisibility}">
            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Važno obaveštenje"
                               FontSize="18" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding PriceChangeInfo}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,6"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Text="{Binding QuestionText}"
                   Grid.Row="3"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Odustani"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="40" 
                    Margin="10,0,10,0"
                    FontSize="14"
                    Command="{Binding CancelCommand}"/>
            <Button Grid.Column="1"
                    Content="Potvrdi"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="40"
                    Margin="10,0,10,0"
                    FontSize="14"
                    Command="{Binding ConfirmCommand}"/>
        </Grid>
    </Grid>
</Window>
    