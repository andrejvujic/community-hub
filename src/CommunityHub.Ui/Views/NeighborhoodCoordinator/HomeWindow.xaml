<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator"
        xmlns:pages="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Pages"
        mc:Ignorable="d"
        Title="Neighborhood Coordinator App"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>
        <!-- Icons: https://fontawesome.com/search?ip=classic&ic=free-collection -->
        
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F5F5F5"   
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock  Margin="10,0,10,0"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="40"
                                Text="&#xf2bd;"/>
                    <TextBlock x:Name="UserInfoTextBlock"
                               Margin="10,0,10,0"
                               Foreground="Black"
                               FontSize="30"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>    
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">

                    <Label Content="Jezik: (Ctrl + L)" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="20"/>

                    <ComboBox x:Name="LanguageComboBox"
                              Width="70"
                              Height="30"
                              SelectedIndex="0"
                              SelectionChanged="LanguageComboBox_SelectionChanged"
                              Margin="0,0,15,0"
                              FontSize="20">    
                        <ComboBoxItem Content="SRP" Tag="sr"/>
                        <ComboBoxItem Content="ENG" Tag="en"/>
                    </ComboBox>

                    <Label Content="Tema: (Ctrl + T)" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="20"/>

                    <ComboBox x:Name="ThemeComboBox"
                              Width="85"
                              Height="30"
                              SelectedIndex="0"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              FontSize="20"
                              Margin="0,0,20,0">
                        <ComboBoxItem Content="Svetla"/>
                        <ComboBoxItem Content="Tamna"/>
                    </ComboBox>

                    <Button Content="Odjavi se (Ctrl + Q)"
                            Click="LogoutButton_Click"
                            Margin="20,0,20,0"
                            Height="30"
                            Width="200"
                            FontSize="20"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" 
                    TabStripPlacement="Left"
                    Margin="10" 
                    Background="Transparent" 
                    BorderThickness="4"
                    FontSize="20">

            <TabItem Header="Početna (F1)">
            </TabItem>

            <TabItem Header="Kvartovi i članstva (F2)">
                <pages:NeighborhoodsPage x:Name="NeighborhoodsTab" />
            </TabItem>

            <TabItem Header="Zahtevi za pristup (F3)">
                <pages:RequestsPage x:Name="RequestsTab" />
            </TabItem>

            <TabItem Header="Statistika i sastanci (F4)">
                <pages:StatisticsAndMeetingsTab x:Name="StatisticsAndMeetingsTab" />
            </TabItem>

            <TabItem Header="Servisni centar (F5)">
                <pages:ServiceCenterTab x:Name="ServiceCenterTab" />
            </TabItem>

            <TabItem Header="Gradski objekti (F6)">
                <pages:CityFacilitiesTab x:Name="CityFacilitiesTab" />
            </TabItem>

            <TabItem Header="Budžet (F7)">
            </TabItem>

            <TabItem Header="Profil (F8)">
            </TabItem>

        </TabControl>

    </Grid>
</Window>
