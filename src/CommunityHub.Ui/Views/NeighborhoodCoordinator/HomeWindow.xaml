<Window x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator"
        xmlns:tabs="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs"
        xmlns:ns="clr-namespace:CommunityHub.Ui.Resources.Localization"
        mc:Ignorable="d"
        Title="{ns:Loc Home_WindowTitle}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Icons: https://fontawesome.com/search?ip=classic&ic=free-collection -->

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Margin="10,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                               FontSize="40"
                               Foreground="{DynamicResource TabItemForegroundBrush}"
                               Text="&#xf2bd;"/>
                    <TextBlock x:Name="UserInfoTextBlock"
                               Margin="10,0,10,0"
                               FontSize="30"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TabItemForegroundBrush}"
                               HorizontalAlignment="Left"
                               Text="{Binding UserDisplayName}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">

                    <TextBlock Text="{ns:Loc Home_LanguageLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontSize="20"
                               Foreground="{DynamicResource TabItemForegroundBrush}"/>

                    <ComboBox x:Name="LanguageComboBox"
                              Width="80"
                              Height="40"
                              Style="{StaticResource ComboBoxStyle}"
                              SelectedIndex="{Binding SelectedLanguageIndex}"
                              Margin="0,0,15,0"
                              FontSize="16">
                        <ComboBoxItem Content="SRP" Tag="sr"/>
                        <ComboBoxItem Content="ENG" Tag="en"/>
                    </ComboBox>

                    <TextBlock Text="{ns:Loc Home_ThemeLabel}"
                               VerticalAlignment="Center"
                               Margin="20,0,10,0"
                               FontSize="20"
                               Foreground="{DynamicResource TabItemForegroundBrush}"/>

                    <ComboBox x:Name="ThemeComboBox"
                              Width="110"
                              Height="40"
                              Style="{StaticResource ComboBoxStyle}"
                              SelectedIndex="{Binding SelectedThemeIndex}"
                              FontSize="16"
                              Margin="0,0,20,0">
                        <ComboBoxItem Content="{ns:Loc Home_ThemeLight}"/>
                        <ComboBoxItem Content="{ns:Loc Home_ThemeDark}"/>
                    </ComboBox>

                    <Button Content="{ns:Loc Home_LogoutButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LogoutCommand}"
                            Margin="20,0,20,0"
                            Height="40"
                            Width="200"
                            Padding="0"
                            FontSize="20"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" 
                    x:Name="MainTabControl"
                    Style="{StaticResource SidebarTabControlStyle}"
                    FontSize="18">

            <TabItem Header="{ns:Loc Home_Tab_Dashboard}"
                     Style="{StaticResource SidebarTabItemStyle}">
                <tabs:DashboardTab x:Name="DashboardTab" />
            </TabItem>

            <TabItem Header="{ns:Loc Home_Tab_Neighborhoods}"
                     Style="{StaticResource SidebarTabItemStyle}">
                <tabs:NeighborhoodsTab x:Name="NeighborhoodsTab" />
            </TabItem>

            <TabItem Header="{ns:Loc Home_Tab_Requests}"
                     Style="{StaticResource SidebarTabItemStyle}">
                <tabs:RequestsTab x:Name="RequestsTab" />
            </TabItem>

            <TabItem Header="{ns:Loc Home_Tab_StatisticsAndMeetings}"
                     Style="{StaticResource SidebarTabItemStyle}">
                <tabs:StatisticsAndMeetingsTab x:Name="StatisticsAndMeetingsTab" />
            </TabItem>

            <TabItem Header="{ns:Loc Home_Tab_ServiceCenter}"
                     Style="{StaticResource SidebarTabItemStyle}">
                <tabs:ServiceCenterTab x:Name="ServiceCenterTab" />
            </TabItem>

            <TabItem Header="{ns:Loc Home_Tab_CityFacilities}"
                     Style="{StaticResource SidebarTabItemStyle}">
                <tabs:CityFacilitiesTab x:Name="CityFacilitiesTab" />
            </TabItem>

            <TabItem Header="{ns:Loc Home_Tab_Budget}"
                     Style="{StaticResource SidebarTabItemStyle}">
                <tabs:NeighborhoodBudgetTab x:Name="NeighborhoodBudgetTab" />
            </TabItem>

            <TabItem Header="{ns:Loc Home_Tab_Profile}"
                     Style="{StaticResource SidebarTabItemStyle}">
                <tabs:ProfileTab x:Name="ProfileTab"/>
            </TabItem>

        </TabControl>

    </Grid>
</Window>
