<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs.NeighborhoodsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
             xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:ParityToStringConverter x:Key="ParityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
          Cursor="Arrow">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Margin="15"
                CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,15,15,10">
                    <TextBlock Text="Moji kvartovi" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"/>

                    <Button Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="RegisterButton_Click">
                        <TextBlock Text="&#xf055;" 
                                   FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                   FontSize="30"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Button>
                </Grid>

                <ListBox x:Name="NeighborhoodsListBox" 
                         Grid.Row="1" 
                         Margin="10,0,10,10"
                         ItemsSource="{Binding Neighborhoods}"
                         SelectedItem="{Binding SelectedNeighborhood}"
                         SelectionChanged="NeighborhoodsListBox_SelectionChanged"
                         Style="{StaticResource NeighborhoodListBoxStyle}"
                         ItemContainerStyle="{StaticResource NeighborhoodListBoxItemStyle}"
                         ItemTemplate="{StaticResource NeighborhoodListItemTemplate}">
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0,15,15,15">
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <ScrollViewer x:Name="DetailsScrollViewer"
                              Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}"
                              Padding="30">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedNeighborhood.Name}" 
                                   FontSize="32" 
                                   FontWeight="Bold" />

                        <TextBlock FontSize="18"
                                   Margin="0,5,0,15"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}, {1}">
                                    <Binding Path="SelectedNeighborhood.City.Name" />
                                    <Binding Path="SelectedNeighborhood.Country.Name" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <TextBlock Text="Opis kvarta"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,5"/>
                        <TextBlock Text="{Binding SelectedNeighborhood.Description}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Galerija slika"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Disabled" 
                                      Margin="0,0,0,25">
                            <ItemsControl ItemsSource="{Binding SelectedNeighborhood.Images}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Path}" Height="180" Margin="0,0,15,0" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,250,180" RadiusX="10" RadiusY="10"/>
                                            </Image.Clip>
                                        </Image>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="Spisak ulica"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding NeighborhoodStreetSections}"
                                  Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  Margin="0,0,0,25">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Naziv ulice" Binding="{Binding Street.Name}" Width="*"/>
                                <DataGridTextColumn Header="Početni broj" Binding="{Binding StartNumber}" Width="120"/>
                                <DataGridTextColumn Header="Krajnji broj" Binding="{Binding EndNumber}" Width="120"/>
                                <DataGridTextColumn Header="Strana" Binding="{Binding Side, Converter={StaticResource ParityConverter}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Spisak članova"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding NeighborhoodMembers}"
                                  Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ime" Binding="{Binding Name}" Width="0.9*"/>
                                <DataGridTextColumn Header="Prezime" Binding="{Binding Surname}" Width="0.9*"/>

                                <DataGridTextColumn Header="Adresa" Width="2*">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0} {1}, {2}">
                                            <Binding Path="Address.Street.Name" />
                                            <Binding Path="Address.StreetNumber" />
                                            <Binding Path="Address.City.Name" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Datum pristupa" 
                                                    Binding="{Binding Membership.AcceptanceDate, StringFormat=\{0:dd.MM.yyyy\}}" 
                                                    Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>