<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs.DashboardTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="NotificationFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ItemBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
          Cursor="Hand">

        <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="15">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Dobrodošli nazad u aplikaciju!"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="20,20,20,15"/>

                <Grid Grid.Row="1" Margin="20,0,20,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource ItemBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="15,12"
                            Margin="0,0,10,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PendingRequestsText}"
                                       FontSize="17"
                                       Margin="0,0,0,10"/>
                            <Button Content="Pregledaj zahteve (Ctrl+2)"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    FontSize="15"
                                    Padding="0"
                                    Height="40"
                                    Command="{Binding ViewRequestsCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource ItemBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel VerticalAlignment="Center">
                            <Button Content="Registruj novi kvart (Ctrl+N)"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Padding="0"
                                    Height="40"
                                    Command="{Binding RegisterNeighborhoodCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource ItemBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="Od:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker SelectedDate="{Binding ReportFrom}"
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="140" Margin="0,0,8,0"/>
                                <TextBlock Text="Do:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker SelectedDate="{Binding ReportTo}" 
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="140"/>
                            </StackPanel>
                            <Button Content="Generiši izveštaj o rezervacijama  (Ctrl+I)"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    FontSize="15"
                                    Padding="0"
                                    Height="40"
                                    Command="{Binding GenerateReportCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="20,0,20,20"
                        Padding="10">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <ToggleButton Content="Servisi (Ctrl+S)" 
                                              IsChecked="{Binding ShowServiceFilter, Mode=TwoWay}" 
                                              Style="{StaticResource NotificationFilterToggleStyle}" 
                                              Checked="FilterToggle_Changed" Unchecked="FilterToggle_Changed" 
                                              Margin="5,0,5,0"/>
                                <ToggleButton Content="Sastanci (Ctrl+M)" 
                                              IsChecked="{Binding ShowMeetingsFilter, Mode=TwoWay}" 
                                              Style="{StaticResource NotificationFilterToggleStyle}" 
                                              Checked="FilterToggle_Changed" Unchecked="FilterToggle_Changed" 
                                              Margin="5,0,5,0"/>
                                <ToggleButton Content="Donacije (Ctrl+D)" 
                                              IsChecked="{Binding ShowDonationsFilter, Mode=TwoWay}" 
                                              Style="{StaticResource NotificationFilterToggleStyle}" 
                                              Checked="FilterToggle_Changed" Unchecked="FilterToggle_Changed" 
                                              Margin="5,0,5,0"/>
                            </UniformGrid>

                            <ListBox ItemsSource="{Binding Notifications}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Cursor="Arrow">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        BorderBrush="{DynamicResource ItemBorderBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource PanelBackgroundBrush}"
                                                        Padding="15,12">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Icon}"
                                                           FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                           FontSize="17"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DateText}"
                                                           FontSize="15"
                                                           VerticalAlignment="Center"
                                                           Margin="16,0,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="15"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="{Binding ActionLabel}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="160"
                                                FontSize="15"
                                                Padding="16,10"
                                                VerticalAlignment="Center"
                                                Margin="20,0,0,0"
                                                Cursor="Hand"
                                                Command="{Binding ActionCommand}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
