<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs.RequestsTab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs"
        xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        xmlns:neighborhoods="clr-namespace:CommunityHub.Application.Domain.Neighborhoods;assembly=CommunityHub.Application"
        mc:Ignorable="d">

    <UserControl.Resources>
        <conv:NeighborhoodAccessRequestStatusToStringConverter x:Key="NeighborhoodAccessRequestStatusToStringConverter" />
        <conv:NeighborhoodAccessRequestStatusToIconCodeConverter x:Key="NeighborhoodAccessRequestStatusToIconCodeConverter" />
    </UserControl.Resources>

    <Grid Margin="20"
          Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
          Cursor="Arrow">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zahtevi:" 
                   FontSize="25" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,10" HorizontalAlignment="Right">
            <TextBlock  Margin="10,0,10,0"
                        VerticalAlignment="Center"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        FontSize="30"
                        Text="&#xf002;"/>
            <ComboBox x:Name="StatusFilterComboBox" 
                      Style="{StaticResource ComboBoxStyle}"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedStatusFilter}"
                      SelectedIndex="0" 
                      Width="165" 
                      FontSize="16">
                <ComboBoxItem Content="Svi" />
                <ComboBoxItem Tag="{x:Static neighborhoods:NeighborhoodAccessRequestStatus.Waiting}" 
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource NeighborhoodAccessRequestStatusToStringConverter}}" />
                <ComboBoxItem Tag="{x:Static neighborhoods:NeighborhoodAccessRequestStatus.Accepted}" 
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource NeighborhoodAccessRequestStatusToStringConverter}}" />
                <ComboBoxItem Tag="{x:Static neighborhoods:NeighborhoodAccessRequestStatus.Rejected}" 
                              Content="{Binding RelativeSource={RelativeSource Self}, Path=Tag, Converter={StaticResource NeighborhoodAccessRequestStatusToStringConverter}}" />
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="RequestsDataGrid"
                  ItemsSource="{Binding Requests}"
                  SelectedItem="{Binding SelectedRequest}"
                  Grid.Row="1"
                  Style="{StaticResource DataGridStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  CellStyle="{StaticResource DataGridCellStyle}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Ime" Binding="{Binding Citizen.Name}" CanUserSort="False" Width="*" />
                <DataGridTextColumn Header="Prezime" Binding="{Binding Citizen.Surname}" CanUserSort="False" Width="*" />
                <DataGridTextColumn Header="Adresa" CanUserSort="False" Width="2*">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1}, {2}">
                            <Binding Path="Citizen.Address.Street.Name" />
                            <Binding Path="Citizen.Address.StreetNumber" />
                            <Binding Path="Citizen.Address.City.Name" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Kvart" Binding="{Binding Neighborhood.Name}" CanUserSort="False" Width="*" />

                <DataGridTextColumn Header="Datum" 
                                    Binding="{Binding CreationDate, StringFormat=\{0:dd.MM.yyyy.\}}"
                                    Width="150"
                                    SortMemberPath="CreationDate"
                                    CanUserSort="True"/>

                <DataGridTemplateColumn Header="Status" CanUserSort="False" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Status, Converter={StaticResource NeighborhoodAccessRequestStatusToIconCodeConverter}}" 
                                           FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free" 
                                           VerticalAlignment="Center"
                                           Margin="5,0"/>
                                <TextBlock Text="{Binding Status, Converter={StaticResource NeighborhoodAccessRequestStatusToStringConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button IsEnabled="{Binding CanActOnRequest}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding RejectCommand}"
                    Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xf00d;"
                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="Odbij zahtev"/>
                </StackPanel>
            </Button>

            <Button IsEnabled="{Binding CanActOnRequest}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding AcceptCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xf00c;"
                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="Prihvati zahtev"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
