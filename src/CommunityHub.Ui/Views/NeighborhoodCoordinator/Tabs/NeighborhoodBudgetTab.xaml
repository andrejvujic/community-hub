<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs.NeighborhoodBudgetTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
          Cursor="Arrow">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Margin="15"
                CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,15,15,10">
                    <TextBlock Text="Moji kvartovi" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="NeighborhoodsListBox" 
                         Grid.Row="1" 
                         Margin="10,0,10,10"
                         ItemsSource="{Binding Neighborhoods}"
                         SelectedItem="{Binding SelectedNeighborhood}"
                         Style="{StaticResource NeighborhoodListBoxStyle}"
                         ItemContainerStyle="{StaticResource NeighborhoodListBoxItemStyle}"
                         ItemTemplate="{StaticResource NeighborhoodListItemTemplate}">
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,15,15,15"
                Padding="8">
            <Grid x:Name="BudgetPanel" Margin="10" Visibility="{Binding BudgetPanelVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="1.8*" />
                    <RowDefinition Height="1.2*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="BudgetTitleTextBlock" Text="{Binding BudgetTitleText}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                    <DataGrid x:Name="BudgetCategoriesDataGrid"
                              ItemsSource="{Binding BudgetCategories}"
                              SelectedItem="{Binding SelectedCategoryBalance}"
                              Style="{StaticResource DataGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              Height="210">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kategorija" Binding="{Binding Category.Name}" CanUserSort="False" Width="*" />
                            <DataGridTextColumn Header="Ukupne donacije" Binding="{Binding TotalDonationsDisplay}" CanUserSort="False" Width="*" />
                            <DataGridTextColumn Header="Potrošeno" Binding="{Binding TotalExpensesDisplay}" CanUserSort="False" Width="*" />
                            <DataGridTextColumn Header="Raspoloživo" Binding="{Binding AvailableDisplay}" CanUserSort="False" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <Grid x:Name="CategoryDetailsPanel" Grid.Row="1" Margin="0,0,0,10" Visibility="{Binding CategoryDetailsPanelVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock x:Name="DonationsTitleTextBlock" Text="{Binding DonationsTitleText}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DataGrid x:Name="DonationsDataGrid"
                                  ItemsSource="{Binding Donations}"
                                  Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  Height="190"
                                  FontSize="16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Iznos" Binding="{Binding AmountDisplay}" CanUserSort="False" Width="*" />
                                <DataGridTextColumn Header="Datum" Binding="{Binding DateDisplay}" CanUserSort="False" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock x:Name="ExpensesTitleTextBlock" Text="{Binding ExpensesTitleText}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DataGrid x:Name="ExpensesDataGrid"
                                  ItemsSource="{Binding Expenses}"
                                  Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  Height="190"
                                  FontSize="16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" CanUserSort="False" Width="*" />
                                <DataGridTextColumn Header="Iznos" Binding="{Binding AmountDisplay}" CanUserSort="False" Width="140" />
                                <DataGridTextColumn Header="Datum" Binding="{Binding DateDisplay}" CanUserSort="False" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,20,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Evidencija novog troška" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opis:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="DescriptionTextBox"
                                         Grid.Column="1"
                                         Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}"
                                         Height="25"
                                         FontSize="14"
                                         Padding="0"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Iznos (RSD):" VerticalAlignment="Center"/>
                                <TextBox x:Name="AmountTextBox"
                                         Grid.Column="0"
                                         Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}"
                                         Margin="110,0,10,0"
                                         Height="25"
                                         FontSize="14"
                                         Padding="0"/>

                                <TextBlock Grid.Column="1" Text="Datum:" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                <DatePicker x:Name="ExpenseDatePicker"
                                            Grid.Column="2"
                                            Style="{StaticResource DatePickerStyle}"
                                            VerticalAlignment="Center"
                                            Focusable="False"
                                            IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>

                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="50"
                                VerticalAlignment="Center"
                                Padding="15,5"
                                Margin="20,0,10,0"
                                Command="{Binding RegisterExpenseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xf067;" 
                                           FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free" 
                                           VerticalAlignment="Center" />
                                <TextBlock Text=" Evidentiraj trošak" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        
    </Grid>
</UserControl>
