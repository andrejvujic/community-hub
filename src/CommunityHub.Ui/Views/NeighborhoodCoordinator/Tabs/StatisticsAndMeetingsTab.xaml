<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs.StatisticsAndMeetingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <conv:MeetingStatusToStringConverter x:Key="MeetingStatusConverter"/>
        <conv:MeetingThemeToStringConverter x:Key="MeetingThemeConverter"/>
        <conv:MeetingStatusToIconCodeConverter x:Key="MeetingStatusIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
          Cursor="Arrow">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Margin="15" 
                CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,15,15,10">
                    <TextBlock Text="Moji kvartovi" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="NeighborhoodsListBox" 
                     Grid.Row="1" 
                     Margin="10,0,10,10"
                     ItemsSource="{Binding Neighborhoods}"
                     SelectedItem="{Binding SelectedNeighborhood}"
                     Style="{StaticResource NeighborhoodListBoxStyle}"
                     ItemContainerStyle="{StaticResource NeighborhoodListBoxItemStyle}"
                     ItemTemplate="{StaticResource NeighborhoodListItemTemplate}">
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,15,15,15"
                Padding="8">
            <Grid Margin="0,15,15,15"
                  Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,5,0"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="10">
                            <TextBlock Text="Statistika" FontSize="22" Margin="0,0,0,15" FontWeight="Bold"/>

                            <UniformGrid Columns="1">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Ukupan broj građana: " FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalCitizensText}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Broj novih građana: " FontSize="15"/>
                                    <TextBlock Text="{Binding NewCountText}" FontSize="15" Margin="5,0"/>
                                    <TextBlock Text="{Binding NewPercentText}" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Broj neaktivnih građana: " FontSize="15"/>
                                    <TextBlock Text="{Binding InactiveCountText}" FontSize="15" Margin="5,0"/>
                                    <TextBlock Text="{Binding InactivePercentText}" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Broj aktivnih građana: " FontSize="15"/>
                                    <TextBlock Text="{Binding ActiveCountText}" FontSize="15" Margin="5,0"/>
                                    <TextBlock Text="{Binding ActivePercentText}" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Broj istaknutih građana: " FontSize="15"/>
                                    <TextBlock Text="{Binding ProminentCountText}" FontSize="15" Margin="5,0"/>
                                    <TextBlock Text="{Binding ProminentPercentText}" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Broj građana od poverenja: " FontSize="15"/>
                                    <TextBlock Text="{Binding TrustworthyCountText}" FontSize="15" Margin="5,0"/>
                                    <TextBlock Text="{Binding TrustworthyPercentText}" FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Visibility="{Binding ShowAnyRecommendation, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="&#xf0eb;"
                                                   FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free" 
                                                   FontSize="18" 
                                                   Foreground="#FFD700"
                                                   VerticalAlignment="Center" 
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="Preporuka sistema" FontSize="18" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding WelcomeRecommendationText}"
                                               TextWrapping="Wrap"
                                               FontSize="16"
                                               LineHeight="20"
                                               Visibility="{Binding ShowWelcomeRecommendation, Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Text="{Binding MotivationRecommendationText}"
                                               TextWrapping="Wrap"
                                               FontSize="16"
                                               LineHeight="20"
                                               Visibility="{Binding ShowMotivationRecommendation, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="WelcomeMeetingButton"
                                    Grid.Row="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,10,0,0"
                                    Height="40"
                                    Padding="0"
                                    Visibility="{Binding ShowWelcomeRecommendation, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding ScheduleWelcomeCommand}">
                                <TextBlock Text="Zakaži sastanak dobrodošlice"/>
                            </Button>

                            <Button x:Name="MotivationMeetingButton"
                                    Grid.Row="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,10,0,0"
                                    Height="40"
                                    Padding="0"
                                    Visibility="{Binding ShowMotivationRecommendation, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding ScheduleMotivationCommand}">
                                <TextBlock Text="Zakaži sastanak motivacije"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="5,0,0,0"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="80" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Sastanci" FontSize="22" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" 
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="5" 
                                    Command="{Binding ScheduleMeetingCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xf067;" 
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Zakaži novi sastanak (Ctrl + N)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <DataGrid x:Name="MeetingsDataGrid"
                                  ItemsSource="{Binding Meetings}"
                                  SelectedItem="{Binding SelectedMeeting}"
                                  Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  Grid.Row="1" 
                                  FontSize="16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tema" Binding="{Binding Theme, Converter={StaticResource MeetingThemeConverter}}" Width="130"/>
                                <DataGridTextColumn Header="Vreme" Binding="{Binding MeetingTimeDisplay}" Width="100"/>
                                <DataGridTextColumn Header="Datum-opseg" Binding="{Binding DisplayDate}" Width="1.5*"/>
                                <DataGridTextColumn Header="Stanje" Binding="{Binding Status, Converter={StaticResource MeetingStatusConverter}}" Width="120"/>
                                <DataGridTemplateColumn Width="35">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="&#xf071;"
                                                           FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                           FontSize="14"
                                                           Foreground="#F0A500"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           ToolTip="Nerešen broj glasova! Potreban odabir konačnog datuma."
                                                           Visibility="{Binding IsTied, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding Status, Converter={StaticResource MeetingStatusIconConverter}}"
                                                           FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsTied}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="TiedDatesPanel" 
                                        Grid.Row="0"
                                        Orientation="Vertical"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding HasTiedDates, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Odredite konačan termin" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <ComboBox Style="{StaticResource ComboBoxStyle}"
                                          ItemsSource="{Binding TiedDateOptions}"
                                          SelectedItem="{Binding SelectedTiedDateOption}"
                                          HorizontalAlignment="Center"
                                          Width="150"
                                          FontSize="14"
                                          Height="30"
                                          Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Button x:Name="ConfirmTermButton"
                                    Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Content="Potvrdite konačan termin"
                                    VerticalAlignment="Center"
                                    Padding="15,8"
                                    IsEnabled="{Binding CanConfirmTiedDate}"
                                    Command="{Binding ConfirmTiedDateCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
