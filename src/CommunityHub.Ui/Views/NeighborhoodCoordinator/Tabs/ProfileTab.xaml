<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs.ProfileTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs"
             mc:Ignorable="d" 
             xmlns:ns="clr-namespace:CommunityHub.Ui.Resources.Localization"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <ns:LocalizedDecimalConverter x:Key="DecimalConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource WindowBackgroundBrush}"
                  Cursor="Arrow">
        <StackPanel Margin="16">

            <TextBlock Text="{ns:Loc Profile_Welcome}"
                       FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,24"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Height="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="{ns:Loc Profile_PersonalInfo}"
                                               FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="&#xf2bb;"
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                               FontSize="32"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"/>
                                </Grid>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FirstName}"
                                               FontSize="24"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding LastName}"
                                               FontSize="24"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16" Height="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="{ns:Loc Profile_Job}"
                                               FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="&#xf508;"
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                               FontSize="32"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{ns:Loc Profile_CoordinatorRole}"
                                           FontSize="24"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Height="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="{ns:Loc Profile_CitizenCount}"
                                               FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,40,0"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="&#xf0c0;"
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                               FontSize="32"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding CitizenCount}"
                                           FontSize="64" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16" Height="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="{ns:Loc Profile_NeighborhoodCount}"
                                               FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="&#xf64f;"
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                               FontSize="32"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding NeighborhoodCount}"
                                           FontSize="64" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Height="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="{ns:Loc Profile_RequestCount}"
                                               FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="&#xf234;"
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                               FontSize="32"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           FontSize="24"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}">
                                    <Run Text="{ns:Loc Profile_Accepted}"/>
                                    <Run Text="{Binding AcceptedRequestCount, Mode=OneWay}"/>
                                    <LineBreak/>
                                    <Run Text="{ns:Loc Profile_Rejected}"/>
                                    <Run Text="{Binding RejectedRequestCount, Mode=OneWay}"/>
                                    <LineBreak/>
                                    <Run Text="{ns:Loc Profile_Pending}"/>
                                    <Run Text="{Binding PendingRequestCount, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16" Height="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="{ns:Loc Profile_AverageRating}"
                                               FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,40,0"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="&#xf005;"
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                               FontSize="32"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding AverageRating, StringFormat={}{0:F2}}"
                                           FontSize="64" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>

                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16" Height="625" VerticalAlignment="Top">
                    <StackPanel>

                        <TextBlock Text="{ns:Loc Profile_Reviews}"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{ns:Loc Profile_Rating}"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="2" Text="{ns:Loc Profile_Comment}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,6"/>

                        <ScrollViewer Height="450" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Reviews}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                                    Height="64">
                                                <TextBlock Text="{Binding Rating}"
                                                           FontSize="26" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </Border>

                                            <Border Grid.Column="2"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                                    Padding="10,8"
                                                    Height="64"
                                                    Margin="0,0,4,0">
                                                <ScrollViewer MaxHeight="52"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <TextBlock Text="{Binding Comment}"
                                                               FontSize="13"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,10"/>

                        <TextBlock FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="{ns:Loc Profile_TotalAverageRating}"/>
                            <Run Text="{Binding AverageRating, Converter={StaticResource DecimalConverter}, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="16"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,2,0,0">
                            <Run Text="{ns:Loc Profile_AverageRatingLastYear}"/>
                            <Run Text="{Binding AverageRatingLastYear, Converter={StaticResource DecimalConverter}, Mode=OneWay}"/>
                        </TextBlock>

                    </StackPanel>
                </Border>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>