<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs.CityFacilitiesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs"
             xmlns:ns="clr-namespace:CommunityHub.Ui.Resources.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ns:LocalizedDateConverter x:Key="LocalizedDateConverter"/>
        <ns:LocalizedTimeConverter x:Key="LocalizedTimeConverter"/>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
          Cursor="Arrow">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Margin="15"
                CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,15,15,10">
                    <TextBlock Text="{ns:Loc Neighborhoods_MyNeighborhoods}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="NeighborhoodsListBox"
                         Grid.Row="1"
                         Margin="10,0,10,10"
                         ItemsSource="{Binding Neighborhoods}"
                         SelectedItem="{Binding SelectedNeighborhood}"
                         Style="{StaticResource NeighborhoodListBoxStyle}"
                         ItemContainerStyle="{StaticResource NeighborhoodListBoxItemStyle}"
                         ItemTemplate="{StaticResource NeighborhoodListItemTemplate}">
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,15,15,15"
                Padding="8">
            <Grid x:Name="FacilitiesPanel" 
                  Visibility="{Binding IsNeighborhoodSelected, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="10"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="{ns:Loc Facilities_ReservationFor}" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock x:Name="NeighborhoodNameTextBlock"
                                   Text="{Binding SelectedNeighborhood.Name}"
                                   FontSize="32" Margin="0,5,0,50" HorizontalAlignment="Center"/>

                        <TextBlock Text="{ns:Loc Facilities_SelectFacility}" FontSize="24" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                        <ComboBox x:Name="FacilitiesComboBox"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Height="50"
                                  Width="300"
                                  FontSize="18"
                                  Margin="0,0,0,40"
                                  HorizontalAlignment="Center"
                                  ItemsSource="{Binding Facilities}"
                                  SelectedItem="{Binding SelectedFacility}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                <Binding Path="Name"/>
                                                <Binding Path="VoteCount"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Margin="0,0,0,20" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{ns:Loc Facilities_Duration}" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="DurationTextBox"
                                     Text="{Binding DurationInput, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Column="1"
                                     Style="{StaticResource TextBoxStyle}"
                                     Height="35"
                                     Width="50"
                                     FontSize="24"
                                     Padding="5,0"
                                     HorizontalContentAlignment="Right"
                                     PreviewTextInput="NumberTextBox_PreviewTextInput"
                                     PreviewKeyDown="NumberTextBox_PreviewKeyDown"/>
                        </Grid>

                        <TextBlock Text="{ns:Loc Facilities_DateRange}" FontSize="24" Margin="0,30,0,10" HorizontalAlignment="Center"/>
                        <Grid Margin="0,10,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{ns:Loc Dashboard_DateFrom}" FontSize="24" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                <DatePicker x:Name="StartDatePicker"
                                            SelectedDate="{Binding ReservationStartDate, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DatePickerStyle}"
                                            DisplayDateStart="{Binding ReservationMinDate, Mode=OneWay}"
                                            Height="35"
                                            FontSize="22"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{ns:Loc Dashboard_DateTo}" FontSize="24" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                <DatePicker x:Name="EndDatePicker"
                                            SelectedDate="{Binding ReservationEndDate, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DatePickerStyle}"
                                            DisplayDateStart="{Binding ReservationMinDate, Mode=OneWay}"
                                            Height="35"
                                            FontSize="22"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="ReserveButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{ns:Loc Facilities_CheckAndReserve}"
                                Height="60"
                                Width="320"
                                FontSize="20"
                                Margin="5,25,5,0"
                                HorizontalAlignment="Center"
                                Command="{Binding ReserveCommand}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2.5*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontSize="20" Margin="0,0,0,15">
                                <Run Text="{ns:Loc Facilities_ReservationList}"/>
                                <Run Text="{Binding SelectedNeighborhood.Name}"/>
                            </TextBlock>

                            <DataGrid x:Name="ReservationsDataGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding Reservations}"
                                      Style="{StaticResource DataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                      RowStyle="{StaticResource DataGridRowStyle}"
                                      CellStyle="{StaticResource DataGridCellStyle}"
                                      FontSize="16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ns:Loc Facilities_ColFacility}" Binding="{Binding Facility.Name}" CanUserSort="False" Width="*"/>
                                    <DataGridTextColumn Header="{ns:Loc Facilities_ColDate}" 
                                                        Binding="{Binding StartDatetime, Converter={StaticResource LocalizedDateConverter}, Mode=OneWay}" 
                                                        CanUserSort="False" Width="90"/>
                                    <DataGridTextColumn Header="{ns:Loc Facilities_ColStart}" 
                                                        Binding="{Binding StartDatetime, Converter={StaticResource LocalizedTimeConverter}, Mode=OneWay}" 
                                                        CanUserSort="False" Width="80"/>
                                    <DataGridTextColumn Header="{ns:Loc Facilities_ColEnd}" 
                                                        Binding="{Binding EndDatetime, Converter={StaticResource LocalizedTimeConverter}, Mode=OneWay}" 
                                                        CanUserSort="False" Width="80"/>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,10,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{ns:Loc Facilities_ReportTitle}" FontSize="30" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                            <TextBlock Text="{ns:Loc Facilities_ReportSubtitle}" FontSize="16" Margin="0,0,0,15" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                            <Grid Margin="0,0,0,15" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{ns:Loc Dashboard_DateFrom}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker Grid.Column="1" 
                                            SelectedDate="{Binding ReportStartDate, UpdateSourceTrigger=PropertyChanged}" 
                                            Style="{StaticResource DatePickerStyle}" 
                                            FontSize="20" Width="160" Height="30" Margin="0,0,15,0"/>

                                <TextBlock Grid.Column="2" Text="{ns:Loc Dashboard_DateTo}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker Grid.Column="3" 
                                            SelectedDate="{Binding ReportEndDate, UpdateSourceTrigger=PropertyChanged}" 
                                            Style="{StaticResource DatePickerStyle}" 
                                            FontSize="20" Width="160" Height="30"/>
                            </Grid>

                            <Button x:Name="GenerateReportButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{ns:Loc Facilities_GenerateReport}"
                                    Height="35"
                                    Width="250"
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    Padding="0"
                                    Command="{Binding GenerateReportCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
