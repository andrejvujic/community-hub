<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs.CityFacilitiesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
          Cursor="Arrow">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Margin="15"
                CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,15,15,10">
                    <TextBlock Text="Moji kvartovi" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="NeighborhoodsListBox"
                         Grid.Row="1"
                         Margin="10,0,10,10"
                         ItemsSource="{Binding Neighborhoods}"
                         SelectedItem="{Binding SelectedNeighborhood, Mode=TwoWay}"
                         Style="{StaticResource NeighborhoodListBoxStyle}"
                         ItemContainerStyle="{StaticResource NeighborhoodListBoxItemStyle}"
                         ItemTemplate="{StaticResource NeighborhoodListItemTemplate}"
                         SelectionChanged="NeighborhoodsListBox_SelectionChanged">
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,15,15,15"
                Padding="8">
            <Grid x:Name="FacilitiesPanel" 
                  Visibility="{Binding IsNeighborhoodSelected, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="10"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="Rezervacija za kvart:" FontSize="32" HorizontalAlignment="Center" />
                        <TextBlock x:Name="NeighborhoodNameTextBlock"
                                   Text="{Binding SelectedNeighborhood.Name}"
                                   FontSize="32" Margin="0,5,0,50" HorizontalAlignment="Center"/>

                        <TextBlock Text="Izaberite objekat:" FontSize="24" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                        <ComboBox x:Name="FacilitiesComboBox"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Height="50"
                                  Width="300"
                                  FontSize="18"
                                  Margin="0,0,0,40"
                                  HorizontalAlignment="Center"
                                  ItemsSource="{Binding Facilities}"
                                  SelectedItem="{Binding SelectedFacility}"
                                  SelectionChanged="FacilitiesComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                <Binding Path="Name"/>
                                                <Binding Path="VoteCount"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Margin="0,0,0,20" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Trajanje posete (h):" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="DurationTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource TextBoxStyle}"
                                     Height="35"
                                     Width="50"
                                     FontSize="24"
                                     Padding="5,0"
                                     HorizontalContentAlignment="Right"
                                     PreviewTextInput="NumberTextBox_PreviewTextInput"
                                     PreviewKeyDown="NumberTextBox_PreviewKeyDown"/>
                        </Grid>

                        <TextBlock Text="Opseg datuma:" FontSize="24" Margin="0,30,0,10" HorizontalAlignment="Center"/>
                        <Grid Margin="0,10,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Od:" FontSize="24" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                <DatePicker x:Name="StartDatePicker"
                                            Style="{StaticResource DatePickerStyle}"
                                            Height="35"
                                            FontSize="22"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Do:" FontSize="24" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                                <DatePicker x:Name="EndDatePicker"
                                            Style="{StaticResource DatePickerStyle}"
                                            Height="35"
                                            FontSize="22"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="ReserveButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Proveri dostupnost i rezerviši"
                                Height="60"
                                Width="320"
                                FontSize="20"
                                Margin="5,25,5,0"
                                HorizontalAlignment="Center"
                                Click="ReserveButton_Click"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2.5*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" FontSize="20" Margin="0,0,0,15">
                                <Run Text="Spisak rezervacija kvarta "/>
                                <Run Text="{Binding SelectedNeighborhood.Name}"/>
                            </TextBlock>

                            <DataGrid x:Name="ReservationsDataGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding Reservations}"
                                      Style="{StaticResource DataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                      RowStyle="{StaticResource DataGridRowStyle}"
                                      CellStyle="{StaticResource DataGridCellStyle}"
                                      FontSize="18">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Objekat" Binding="{Binding Facility.Name}" CanUserSort="False" Width="*"/>
                                    <DataGridTextColumn Header="Datum" Binding="{Binding StartDatetime, StringFormat='{}{0:dd.MM.yyyy.}'}" CanUserSort="False" Width="100"/>
                                    <DataGridTextColumn Header="Početak" Binding="{Binding StartDatetime, StringFormat='{}{0:HH:mm}'}" CanUserSort="False" Width="80"/>
                                    <DataGridTextColumn Header="Kraj" Binding="{Binding EndDatetime, StringFormat='{}{0:HH:mm}'}" CanUserSort="False" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            Margin="0,10,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Generisanje izveštaja" FontSize="30" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                            <TextBlock Text="Generiši izveštaj o svim rezervacijama gradskih objekata" FontSize="16" Margin="0,0,0,15" TextWrapping="Wrap" HorizontalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                <TextBlock Text="od:" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <DatePicker x:Name="ReportStartDatePicker"
                                            Style="{StaticResource DatePickerStyle}"
                                            FontSize="20" 
                                            Width="160" 
                                            Height="30" 
                                            Margin="0,0,15,0"/>

                                <TextBlock Text="do:" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <DatePicker x:Name="ReportEndDatePicker"
                                            Style="{StaticResource DatePickerStyle}"
                                            FontSize="20" 
                                            Width="160" 
                                            Height="30"/>
                            </StackPanel>

                            <Button x:Name="GenerateReportButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Generiši izveštaj"
                                    Height="35"
                                    Width="250"
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    Padding="0"
                                    Command="{Binding GenerateReportCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
