<UserControl x:Class="CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs.ServiceCenterTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CommunityHub.Ui.Views.NeighborhoodCoordinator.Tabs"
             xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
             xmlns:ns="clr-namespace:CommunityHub.Ui.Resources.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ns:EnumLocalizationConverter x:Key="EnumLocalizationConverter" />
        <conv:BookedJobStatusConverter x:Key="StatusConverter" />
        <ns:LocalizedDecimalConverter x:Key="DecimalConverter" />

        <Style x:Key="JobListingItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                            BorderBrush="{DynamicResource ItemBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            Padding="10"
                            Width="270"
                            Height="115">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>



    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          TextElement.Foreground="{DynamicResource PrimaryTextBrush}"
          Cursor="Arrow">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Margin="15"
                CornerRadius="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,15,15,10">
                    <TextBlock Text="{ns:Loc Neighborhoods_MyNeighborhoods}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="NeighborhoodsListBox" 
                         Grid.Row="1" 
                         Margin="10,0,10,10"
                         ItemsSource="{Binding Neighborhoods}"
                         SelectedItem="{Binding SelectedNeighborhood}"
                         Style="{StaticResource NeighborhoodListBoxStyle}"
                         ItemContainerStyle="{StaticResource NeighborhoodListBoxItemStyle}"
                         ItemTemplate="{StaticResource NeighborhoodListItemTemplate}">
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,15,15,15"
                Padding="8">
            <Grid Visibility="{Binding NeighborhoodDetailsVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding ServicesTitle}"
                               Grid.Row="0"
                               FontSize="22" 
                               Margin="0,0,0,15"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource SurfaceBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,7,0"
                                Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="JobListingsListBox"
                                         ItemsSource="{Binding JobListings}"
                                         SelectedItem="{Binding SelectedListing}"
                                         ItemContainerStyle="{StaticResource JobListingItemStyle}"
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="90" Height="90" Margin="0,0,10,0" CornerRadius="5" ClipToBounds="True">
                                                    <Image Source="{Binding WorkSamples[0].Path}" Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ServiceName}" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} {1}">
                                                                <Binding Path="Provider.Name"/>
                                                                <Binding Path="Provider.Surname"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding CurrentPriceEntry.Amount, StringFormat='{}{0:N2} RSD'}"
                                                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding BillingType, Converter={StaticResource EnumLocalizationConverter}}"
                                                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="7,0,0,0"
                                Padding="8">
                            <Grid Visibility="{Binding JobDetailsVisibility}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.2*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="{Binding SelectedListing.ServiceName}"
                                               FontSize="20"
                                               Margin="0,0,0,5"/>
                                    <TextBlock FontSize="18" Margin="0,0,0,15"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="SelectedListing.Provider.Name"/>
                                                <Binding Path="SelectedListing.Provider.Surname"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <TextBlock Text="{ns:Loc Service_Description}" FontSize="16" />
                                    <TextBlock Text="{Binding SelectedListing.Description}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Margin="0,5,0,20"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0"
                                                HorizontalAlignment="Center">
                                        <Border Width="150" Height="150" CornerRadius="8" ClipToBounds="True"
                                                HorizontalAlignment="Center">
                                            <Image Source="{Binding CurrentImage}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                            <Button x:Name="PrevImageButton"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Margin="0,0,10,0"
                                                    Command="{Binding PrevImageCommand}">
                                                <TextBlock Text="&#xf30a;"
                                                           FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Button>
                                            <Button x:Name="NextImageButton"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding NextImageCommand}">
                                                <TextBlock Text="&#xf30b;"
                                                           FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding PriceText}"
                                                   FontSize="20"
                                                   HorizontalAlignment="Left"/>

                                        <TextBlock Text="{Binding BillingTypeText}"
                                                   FontSize="20"
                                                   Margin="0,5,0,5"
                                                   HorizontalAlignment="Left"/>

                                        <StackPanel Orientation="Horizontal"  
                                                    Visibility="{Binding DurationPanelVisibility}" 
                                                    Margin="0,0,0,10">
                                            <TextBlock Text="{ns:Loc Service_Duration}"
                                                       FontSize="20" 
                                                       VerticalAlignment="Center" 
                                                       Margin="0,0,8,0"/>
                                            <TextBox x:Name="DurationHoursTextBox"
                                                     Style="{StaticResource TextBoxStyle}"
                                                     Width="60"
                                                     FontSize="20"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding DurationHoursInput, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalContentAlignment="Right"
                                                     PreviewTextInput="NumberTextBox_PreviewTextInput"
                                                     PreviewKeyDown="NumberTextBox_PreviewKeyDown"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="FindSlotButton"
                                            Grid.Column="1"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{ns:Loc Service_FindSlot}"
                                            FontSize="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Width="260"
                                            Height="50"
                                            Margin="0,0,0,10"
                                            Command="{Binding FindSlotCommand}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,12,0,0"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="ScheduledServicesDataGrid"
                                  Grid.Row="0"
                                  ItemsSource="{Binding ScheduledServices}"
                                  SelectedItem="{Binding SelectedScheduledService}"
                                  Style="{StaticResource DataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource DataGridRowStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  FontSize="14"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{ns:Loc Service_ColService}" Binding="{Binding Listing.ServiceName}" CanUserSort="False" Width="*"/>
                                <DataGridTextColumn Header="{ns:Loc Service_ColProvider}" Binding="{Binding ProviderName}" CanUserSort="False" Width="*"/>
                                <DataGridTemplateColumn Header="{ns:Loc Service_ColDateTime}" CanUserSort="False" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding>
                                                        <MultiBinding.Converter>
                                                            <conv:BookedJobDateTimeConverter/>
                                                        </MultiBinding.Converter>
                                                        <Binding Path="ScheduledDate"/>
                                                        <Binding Path="ScheduledTime"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{ns:Loc Service_ColPrice}" Binding="{Binding TotalPriceView}" CanUserSort="False" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,15,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{ns:Loc Service_ColStatus}" 
                                                    Binding="{Binding Status, Converter={StaticResource StatusConverter}}" 
                                                    CanUserSort="False" Width="100" />
                                <DataGridTemplateColumn Header="{ns:Loc Service_ColRating}" CanUserSort="False" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right" Padding="0,0,15,0">
                                                <Run Text="{Binding Review.AverageRating, Converter={StaticResource DecimalConverter}, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{ns:Loc Service_EditReview}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="150"
                                    Margin="0,0,10,0"
                                    FontSize="14"
                                    Command="{Binding EditReviewCommand}"/>
                            <Button Content="{ns:Loc Service_Rate}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="150"
                                    Margin="0,0,10,0"
                                    FontSize="14"
                                    Command="{Binding ReviewCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
