<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.RegistrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="RegistrationPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource InterFontFamily}"
    Loaded="RegistrationPage_Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/MaterialDesignTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DropShadowEffect x:Key="DepthShadow" BlurRadius="4" Opacity="0.2" ShadowDepth="2" />

            <Style x:Key="GroupBoxHeaderStyle" TargetType="GroupBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border
                                BorderBrush="Black"
                                BorderThickness="2"
                                CornerRadius="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Padding="10,5,10,5"
                                        Background="{StaticResource NavBarDefaultBackgroundBrush}">
                                        <TextBlock
                                            FontSize="{TemplateBinding FontSize}"
                                            Foreground="White"
                                            Text="{TemplateBinding Header}" />
                                    </Border>
                                    <Border Grid.Row="1" Background="White">
                                        <ContentPresenter Margin="0" />
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FloorGroupBoxStyle" TargetType="GroupBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border
                                BorderBrush="Black"
                                BorderThickness="2"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Padding="10,5,10,5"
                                        Background="{StaticResource NavBarDefaultBackgroundBrush}">
                                        <TextBlock
                                            FontSize="{TemplateBinding FontSize}"
                                            Foreground="White"
                                            Text="{TemplateBinding Header}" />
                                    </Border>
                                    <Border Grid.Row="1" Background="White">
                                        <ContentPresenter />
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>

            <!--  Icons: https://fontawesome.com/search?ip=classic&ic=free-collection  -->

            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock
                    Margin="15,15,0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="32"
                    Foreground="{StaticResource PageTitleBrush}"
                    Text="Registracija nove zgrade" />
            </Grid>

            <Grid Grid.Row="1">
                <Border
                    Margin="0,5,450,0"
                    BorderBrush="#8E8A80"
                    BorderThickness="0,2,0,0" />
            </Grid>

            <Grid
                Grid.Row="2"
                Margin="0,15,0,0"
                HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock
                        Margin="40,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        FontSize="28"
                        Text="&#xe4eb;" />
                </Grid>

                <Grid Grid.Column="1">
                    <TextBlock
                        Margin="15,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="22"
                        Text="Uneti podatke vezane za zgradu - svako polje je obavezno uneti!" />
                </Grid>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="983" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" Margin="0,15,0,15">
                    <GroupBox
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="2"
                        FontSize="22"
                        Header="Podaci"
                        Style="{StaticResource GroupBoxHeaderStyle}">

                        <Grid Margin="25,20,10,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="450" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        Text="Država:" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        Foreground="Black"
                                        Text="Grad:" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="450" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <ComboBox
                                        x:Name="countryComboBox"
                                        Width="320"
                                        HorizontalAlignment="Left"
                                        DisplayMemberPath="Name"
                                        IsEnabled="True"
                                        ItemsSource="{Binding Countries}"
                                        SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                        SelectedValuePath="Id" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <ComboBox
                                        x:Name="cityComboBox"
                                        Width="300"
                                        HorizontalAlignment="Left"
                                        DisplayMemberPath="Name"
                                        IsEnabled="{Binding IsCityEnabled}"
                                        ItemsSource="{Binding Cities}"
                                        SelectedItem="{Binding SelectedCity, Mode=TwoWay}"
                                        SelectedValuePath="Id" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="450" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        Text="Ulica i broj:" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="22"
                                        Foreground="Black"
                                        Text="Naselje:"
                                        TextAlignment="Center" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="450" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <ComboBox
                                                x:Name="streetComboBox"
                                                Width="320"
                                                HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left"
                                                VerticalContentAlignment="Center"
                                                DisplayMemberPath="Name"
                                                IsEnabled="{Binding IsStreetEnabled}"
                                                ItemsSource="{Binding Streets}"
                                                SelectedItem="{Binding SelectedStreet, Mode=TwoWay}"
                                                SelectedValuePath="Id" />
                                        </Grid>

                                        <Grid Grid.Column="1">
                                            <TextBox
                                                x:Name="streetNumberTextBox"
                                                Width="60"
                                                Margin="20,0,0,0"
                                                VerticalContentAlignment="Center"
                                                IsEnabled="{Binding IsStreetNumberEnabled}"
                                                Text="{Binding StreetNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TextAlignment="Center" />
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <TextBlock
                                            Padding="0,10,0,0"
                                            FontSize="22"
                                            Foreground="{StaticResource ErrorMessageBrush}"
                                            Text="{Binding ErrorMessage}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Column="1">
                                    <TextBox
                                        x:Name="neighborhoodTextBox"
                                        Width="250"
                                        Height="30"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Text="{Binding Neighborhood, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,40,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        Text="Broj spratova:" />
                                </Grid>

                                <Grid Grid.Column="1" HorizontalAlignment="Left">
                                    <xctk:IntegerUpDown
                                        x:Name="floorsUpDown"
                                        Width="70"
                                        Increment="1"
                                        Maximum="20"
                                        Minimum="1"
                                        TextAlignment="Center"
                                        ValueChanged="FloorsUpDown_ValueChanged"
                                        Value="1" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="5" Margin="0,20,0,0">
                                <Border
                                    Background="#F5F5F5"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Effect="{StaticResource DepthShadow}">
                                    <ScrollViewer Height="280" VerticalScrollBarVisibility="Visible">
                                        <StackPanel x:Name="floorsStackPanel" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <Grid
                                Grid.Row="6"
                                Margin="0,30,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                        FontSize="22"
                                        Foreground="#0F5AA6"
                                        Text="&#xf0c6;" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Button
                                        Width="220"
                                        Background="#0F5AA6"
                                        BorderBrush="#0F5AA6"
                                        Click="ChooseImage_Click"
                                        Content="Odaberite sliku"
                                        Cursor="Hand"
                                        FontWeight="SemiBold"
                                        Foreground="White" />
                                </Grid>

                                <Grid
                                    Grid.Column="2"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="22"
                                        Foreground="{StaticResource ErrorMessageBrush}"
                                        Text="{Binding ImageErrorMessage}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>

                            <Border
                                Grid.Row="7"
                                Margin="0,25,0,20"
                                HorizontalAlignment="Left"
                                Background="#F5F5F5"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="3"
                                Effect="{StaticResource DepthShadow}">
                                <ScrollViewer
                                    Width="600"
                                    HorizontalScrollBarVisibility="Visible"
                                    VerticalScrollBarVisibility="Disabled">
                                    <Grid Grid.Row="7" Height="200">
                                        <ItemsControl ItemsSource="{Binding SelectedImagePaths}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Margin="10,10,10,10" Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid
                                                        Width="90"
                                                        Height="90"
                                                        Margin="0,0,10,0">
                                                        <Border
                                                            Background="White"
                                                            BorderBrush="Gray"
                                                            BorderThickness="1">
                                                            <Image Source="{Binding}" Stretch="UniformToFill" />
                                                        </Border>

                                                        <Button
                                                            Width="22"
                                                            Height="22"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="White"
                                                            BorderBrush="Black"
                                                            Click="RemoveImage_Click"
                                                            Cursor="Hand"
                                                            Style="{x:Null}"
                                                            Tag="{Binding}">
                                                            <TextBlock
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                Text="X" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <Grid
                                Grid.Row="8"
                                Margin="0,30,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        x:Name="cancelButton"
                                        Width="100"
                                        Margin="0,0,15,0"
                                        Background="#0F5AA6"
                                        BorderBrush="#0F5AA6"
                                        Click="CancelButton_Click"
                                        Cursor="Hand"
                                        Foreground="White">
                                        Otkaži
                                    </Button>
                                    <Button
                                        x:Name="confirmButton"
                                        Width="100"
                                        Margin="0,0,15,0"
                                        Background="#0F5AA6"
                                        BorderBrush="#0F5AA6"
                                        Click="ConfirmButton_Click"
                                        Cursor="Hand"
                                        Foreground="White"
                                        IsEnabled="{Binding CanConfirm}">
                                        Potvrdi
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>