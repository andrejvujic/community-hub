<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.AssemblyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AssemblyPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:AssemblyStatusToStringConverter x:Key="AssemblyStatusToStringConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/MaterialDesignTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="65" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock
                Margin="15,15,0,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="32"
                Foreground="{StaticResource PageTitleBrush}"
                Text="Spisak skupština stanara" />
        </Grid>

        <Grid Grid.Row="1">
            <Border
                Margin="0,5,450,0"
                BorderBrush="#8E8A80"
                BorderThickness="0,2,0,0" />
        </Grid>

        <Grid Grid.Row="2" Margin="50,0,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="25" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <DataGrid
                    Height="500"
                    Margin="0,35,0,0"
                    VerticalAlignment="Top"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="False"
                    FontSize="16"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Assemblies}"
                    RowHeight="44"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedAssembly, Mode=TwoWay}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F0F2F5" />
                            <Setter Property="Foreground" Value="#1C1E21" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Padding" Value="12,8,12,8" />
                            <Setter Property="BorderBrush" Value="#DDDFE2" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="12,0,12,0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#000000" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FontSize" Value="15" />

                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="Foreground" Value="#1C1E21" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#DCE8D8" />
                                    <Setter Property="Foreground" Value="#123B63" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#DCE8D8" />
                                    <Setter Property="Foreground" Value="#123B63" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Building}"
                            CanUserSort="False"
                            Header="Zgrada">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Left" />
                                    <Setter Property="Margin" Value="12,0,0,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#1C1E21" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                            <Setter Property="Foreground" Value="#123B63" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding StartsAt, StringFormat='{}{0:d. MMMM yyyy.} - {0:HH.mm}', ConverterCulture=sr-Latn-RS}"
                            CanUserSort="False"
                            Header="Datum i vreme">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#1C1E21" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                            <Setter Property="Foreground" Value="#123B63" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding TopicCount}"
                            CanUserSort="False"
                            Header="Broj tema">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#1C1E21" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                            <Setter Property="Foreground" Value="#123B63" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Status, Converter={StaticResource AssemblyStatusToStringConverter}}"
                            CanUserSort="False"
                            Header="Status">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="#1C1E21" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                            <Setter Property="Foreground" Value="#123B63" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>

            <ScrollViewer
                Grid.Column="2"
                Height="500"
                Margin="0,35,0,0"
                VerticalScrollBarVisibility="Auto">
                <Border
                    Background="#fff"
                    BorderBrush="black"
                    BorderThickness="2"
                    CornerRadius="7"
                    Visibility="{Binding IsAssemblySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock
                                Margin="30,10,0,19"
                                HorizontalAlignment="Left"
                                FontSize="25"
                                Text="{Binding SelectedAssembly.Building}" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock
                                Margin="10,0,0,5"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="Teme:" />
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="10,0,0,0">
                            <ItemsControl ItemsSource="{Binding Topics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock Text="• " />
                                            <TextBlock
                                                FontSize="14"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid Grid.Row="3">
                            <TextBlock
                                Margin="10,16,0,10"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="Prisustvo stanova:" />
                        </Grid>

                        <Border
                            Grid.Row="4"
                            Margin="10,0,10,10"
                            Padding="6"
                            Background="#E3E3E3"
                            BorderBrush="#B0B0B0"
                            BorderThickness="1"
                            CornerRadius="4">
                            <ScrollViewer
                                Height="150"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Apartments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,8,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Width="36"
                                                    Height="28"
                                                    Background="White"
                                                    BorderBrush="Black"
                                                    BorderThickness="1">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Text="{Binding Apartment.Number}" />
                                                </Border>

                                                <Border
                                                    Grid.Column="1"
                                                    Width="36"
                                                    Height="28"
                                                    Background="White"
                                                    BorderBrush="Black"
                                                    BorderThickness="1">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="#1E8E3E"
                                                        Kind="CheckCircle"
                                                        Visibility="{Binding HasAttendance, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="5">
                            <TextBlock
                                Margin="10,16,0,10"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="Predložene teme:" />
                        </Grid>

                        <Grid Grid.Row="6">
                            <TextBlock
                                Margin="10,0,10,10"
                                FontSize="14"
                                Foreground="Black"
                                Text="Nema predloženih tema.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SuggestedTopics.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border
                                Margin="10,0,10,10"
                                Background="#E3E3E3"
                                BorderBrush="#B0B0B0"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SuggestedTopics.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>


                                    <ItemsControl Grid.Row="0" ItemsSource="{Binding SuggestedTopics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    Content="{Binding Description}"
                                                    FontSize="14"
                                                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                    IsEnabled="{Binding DataContext.CanEditSuggestedTopics, RelativeSource={RelativeSource AncestorType=Page}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button
                                        Grid.Row="1"
                                        Margin="8"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ConfirmCommand}"
                                        Content="Potvrdi"
                                        Foreground="White"
                                        IsEnabled="{Binding CanEditSuggestedTopics}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>