<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.MyBuildingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MyBuildingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/MaterialDesignTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadBuildingsCommand}" CommandParameter="{x:Null}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
        <Grid Background="{StaticResource AppBackgroundBrush}">

            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock
                        Margin="15,15,0,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="32"
                        Foreground="{StaticResource PageTitleBrush}"
                        Text="Moje zgrade" />
                </Grid>

                <Grid Grid.Column="1">
                    <Button
                        Margin="0,0,20,0"
                        Padding="14,6,14,6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#0F5AA6"
                        BorderBrush="#0F5AA6"
                        Command="{Binding GenerateReportCommand}"
                        Content="Generiši izveštaj"
                        Cursor="Hand"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Border
                    Margin="0,5,450,0"
                    BorderBrush="#8E8A80"
                    BorderThickness="0,2,0,0" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1">
                    <ItemsControl ItemsSource="{Binding Buildings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="520"
                                    Height="150"
                                    Margin="10"
                                    Background="#FCFBF7"
                                    BorderBrush="#D6D1C4"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="12">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Image
                                            Grid.Column="0"
                                            Height="150"
                                            VerticalAlignment="Center"
                                            Source="{Binding CoverImage.Path}"
                                            Stretch="UniformToFill"
                                            Visibility="{Binding HasImages, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <Grid Grid.Column="1" Margin="15,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <StackPanel
                                                Grid.Row="0"
                                                Margin="0,12,0,0"
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Text="🏢" />
                                                <TextBlock
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Foreground="#1F1F1F">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}, {2}">
                                                            <Binding Path="Address.Street.Name" />
                                                            <Binding Path="Address.StreetNumber" />
                                                            <Binding Path="Address.Neighborhood" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,10,0,0"
                                                FontSize="14"
                                                Foreground="#444444">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}, {1}">
                                                        <Binding Path="Address.City.Name" />
                                                        <Binding Path="Address.Country.Name" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock
                                                Grid.Row="2"
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                Foreground="#666666">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}Spratova: {0} | Stanova: {1}">
                                                        <Binding Path="FloorCount" />
                                                        <Binding Path="ApartmentCount" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock
                                                Grid.Row="3"
                                                Margin="0,0,15,15"
                                                Padding="10,6,10,6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Cursor="Hand"
                                                FontSize="15"
                                                Text="Detalji  →">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding
                                                        Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Gesture="LeftClick" />
                                                </TextBlock.InputBindings>

                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#0F5AA6" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#E8F1FB" />
                                                                <Setter Property="Foreground" Value="#0A3F78" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>