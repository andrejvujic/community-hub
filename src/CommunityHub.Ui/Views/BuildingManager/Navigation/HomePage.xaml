<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="HomePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource InterFontFamily}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/MaterialDesignTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer>
        <Grid Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="65" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock
                    Margin="15,15,0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="32"
                    Foreground="{StaticResource PageTitleBrush}"
                    Text="Dobro došli nazad!" />
            </Grid>

            <Grid Grid.Row="1">
                <Border
                    Margin="0,5,450,0"
                    BorderBrush="#8E8A80"
                    BorderThickness="0,2,0,0" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="1"
                    Height="230"
                    Margin="0,20,0,0"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="28"
                                Text="&#xf1ad;" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Text="MOJE ZGRADE" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <TextBlock
                                Margin="0,40,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="40"
                                FontWeight="Bold"
                                Text="{Binding BuildingsCount}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="3"
                    Height="230"
                    Margin="0,20,0,0"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="28"
                                Text="&#xe533;" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Text="UKUPNO STANARA" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <TextBlock
                                Margin="0,40,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="40"
                                FontWeight="Bold"
                                Text="{Binding ResidentsCount}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="5"
                    Height="230"
                    Margin="0,20,0,0"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="28"
                                Text="&#xf66f;" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Text="SLEDEĆA SKUPŠTINA" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <TextBlock
                                Margin="0,38,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="{Binding NextAssemblyDisplay}"
                                TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="7"
                    Height="230"
                    Margin="0,20,0,0"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="28"
                                Text="&#xf06a;" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Text="NEREŠENI PROBLEMI" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <TextBlock
                                Margin="0,40,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="40"
                                FontWeight="Bold"
                                Text="{Binding OpenIssuesCount}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>


            <lvc:CartesianChart
                Grid.Row="3"
                Width="1000"
                Height="500"
                Margin="0,30,0,100"
                Series="{Binding OpenIssuesSeries}"
                TooltipPosition="Hidden"
                XAxes="{Binding XAxes}"
                YAxes="{Binding YAxes}" />
        </Grid>
    </ScrollViewer>
</Page>