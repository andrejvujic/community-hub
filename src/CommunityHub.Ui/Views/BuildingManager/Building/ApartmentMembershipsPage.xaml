<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.ApartmentMembershipsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ApartmentMembershipsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource AppFontFamily}"
    Loaded="ApartmentMembershipsPage_Loaded"
    mc:Ignorable="d">

    <Grid Margin="10,25,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBlock
                    Margin="10,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    FontSize="28"
                    MouseLeftButtonDown="LeftArrow_Click"
                    Text="&#xf060;" />
            </Grid>

            <Grid Grid.Column="1">
                <TextBlock
                    x:Name="streetInfo"
                    Margin="15,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="21" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="50,0,40,0">
            <DataGrid
                x:Name="membershipsDataGrid"
                MaxHeight="400"
                Margin="0,15,0,0"
                VerticalAlignment="Top"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                FontSize="20"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding ApartmentMemberships}"
                RowHeight="40"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="Single"
                SelectionUnit="FullRow">

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Resident.Name}"
                        Header="Ime stanara" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Resident.Surname}"
                        Header="Prezime stanara" />
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding Apartment.FloorNumber}"
                        Header="Broj sprata">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="Auto"
                        Binding="{Binding Apartment.Number}"
                        Header="Broj stana">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding AcceptanceDate, StringFormat='dd.MM.yyyy.'}"
                        Header="Datum učlanjenja">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>