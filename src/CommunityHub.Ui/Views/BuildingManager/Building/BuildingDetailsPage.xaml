<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BuildingDetailsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource AppFontFamily}"
    mc:Ignorable="d">
    <Grid>

        <!--  Icons: https://fontawesome.com/search?ip=classic&ic=free-collection  -->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border BorderBrush="Gray" BorderThickness="0,0,2,0">
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarInfoItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="SideBarItem_Click"
                        Tag="Info">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf05a;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Opšte informacije" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarApartmentAccessRequestItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="SideBarItem_Click"
                        Tag="ApartmentAccessRequest">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf15b;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Zahtevi za pristup zgradi" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="2"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarApartmentMembershipItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="SideBarItem_Click"
                        Tag="ApartmentMembership">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf0c0;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Članstvo u zgradi" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="3"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarCommonRoomItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="SideBarItem_Click"
                        Tag="CommonRoom">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf4b8;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Zajedničke prostorije" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="4"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarRentingRoomItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="SideBarItem_Click"
                        Tag="RentingRoom">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf084;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Iznajmljivanje prostorija" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="5"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarNoticeBoardItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="SideBarItem_Click"
                        Tag="NoticeBoard">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf0a1;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Oglasna tabla" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="6"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarSchedulingAssemblyItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="SideBarItem_Click"
                        Tag="SchedulingAssembly">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf66f;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Zakazivanje skupštine" />
                        </Grid>
                    </Grid>
                </Border>


                <Border
                    Grid.Row="7"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarProblemOverviewItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="SideBarItem_Click"
                        Tag="ProblemOverview">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf7d9;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Pregled problema" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Frame
                x:Name="BuildingFrame"
                Grid.Row="1"
                NavigationUIVisibility="Hidden" />
        </Grid>

    </Grid>
</Page>
