<Window
    x:Class="CommunityHub.Ui.Views.BuildingManager.HomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Building Manager"
    Margin="0,0,0,0"
    FontFamily="{StaticResource AppFontFamily}"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Grid>
        <!--  Icons: https://fontawesome.com/search?ip=classic&ic=free-collection  -->

        <Grid.RowDefinitions>
            <RowDefinition Height="75" />
            <RowDefinition Height="*" />
            <RowDefinition Height="55" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            BorderBrush="Gray"
            BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        Cursor="Hand"
                        MouseLeftButtonDown="NavBarItem_Click"
                        Tag="Home">
                        <TextBlock
                            Margin="40,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="28"
                            Text="&#xe4da;" />
                    </Grid>
                    <Grid
                        Grid.Column="1"
                        Cursor="Hand"
                        MouseLeftButtonDown="NavBarItem_Click"
                        Tag="Home">
                        <TextBlock
                            Margin="16,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontStyle="Italic"
                            Text="UpravnikApp" />
                    </Grid>
                </Grid>

                <Border
                    Grid.Column="1"
                    BorderBrush="Gray"
                    BorderThickness="0,0,2,0">
                    <Grid
                        x:Name="NavBar_HomeItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="NavBarItem_Click"
                        Tag="Home">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="28"
                                Text="&#xf015;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Text="Početna" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    BorderBrush="Gray"
                    BorderThickness="0,0,2,0">
                    <Grid
                        x:Name="NavBar_AssemblyItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="NavBarItem_Click"
                        Tag="Assembly">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="30,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="28"
                                Text="&#xf66f;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Text="Skupština" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="3"
                    BorderBrush="Gray"
                    BorderThickness="0,0,2,0">
                    <Grid
                        x:Name="NavBar_MyBuildingsItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="NavBarItem_Click"
                        Tag="MyBuildings">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="25,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="28"
                                Text="&#xf1ad;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Text="Moje zgrade" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="4"
                    BorderBrush="Gray"
                    BorderThickness="0,0,2,0">
                    <Grid
                        x:Name="NavBar_RegistrationItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="NavBarItem_Click"
                        Tag="Registration">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="25,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="28"
                                Text="&#xf055;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Text="Registracija" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="5"
                    BorderBrush="Gray"
                    BorderThickness="0,0,2,0">
                    <Grid
                        x:Name="NavBar_HelpItem"
                        Cursor="Hand"
                        MouseLeftButtonDown="NavBarItem_Click"
                        Tag="Help">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="20,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="28"
                                Text="&#xf059;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,20,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="24"
                                Text="Pomoć" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid
                    x:Name="NavBar_LogOutItem"
                    Grid.Column="6"
                    Cursor="Hand"
                    MouseLeftButtonDown="NavBarItem_Click"
                    Tag="LogOut">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="LightGray" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBlock
                            Margin="25,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="28"
                            Text="&#xf08b;" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <TextBlock
                            Margin="16,0,16,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            FontSize="24"
                            Text="Odjavi se" />
                    </Grid>
                </Grid>

                <Grid Grid.Column="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="34"
                            Text="&#xf2bd;" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock
                            Margin="0,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="Korisnik" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Frame
            x:Name="HomeFrame"
            Grid.Row="1"
            NavigationUIVisibility="Hidden" />

        <Border
            Grid.Row="2"
            BorderBrush="Gray"
            BorderThickness="0,2,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock
                        Margin="25,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        FontSize="26"
                        Text="&#xf1f9;" />
                </Grid>
                <Grid Grid.Column="1">
                    <TextBlock
                        Margin="20,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="2026 UpravnikApp v1.0" />
                </Grid>
            </Grid>
        </Border>

    </Grid>

</Window>