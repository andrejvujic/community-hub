<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BuildingDetailsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource InterFontFamily}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/MaterialDesignTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>

        <!--  Icons: https://fontawesome.com/search?ip=classic&ic=free-collection  -->

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border BorderBrush="Gray" BorderThickness="0,0,2,0">
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarInfoItem"
                        Cursor="Hand"
                        Tag="Info">

                        <Grid.InputBindings>
                            <MouseBinding
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Info"
                                Gesture="LeftClick" />
                        </Grid.InputBindings>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{StaticResource SideBarDefaultBackgroundBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarDefaultForegroundBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="Info">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf05a;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Opšte informacije" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarApartmentAccessRequestItem"
                        Cursor="Hand"
                        Tag="ApartmentAccessRequest">

                        <Grid.InputBindings>
                            <MouseBinding
                                Command="{Binding NavigateCommand}"
                                CommandParameter="ApartmentAccessRequest"
                                Gesture="LeftClick" />
                        </Grid.InputBindings>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{StaticResource SideBarDefaultBackgroundBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarDefaultForegroundBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="ApartmentAccessRequest">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf15b;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Zahtevi za pristup zgradi" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="2"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarApartmentMembershipItem"
                        Cursor="Hand"
                        Tag="ApartmentMembership">

                        <Grid.InputBindings>
                            <MouseBinding
                                Command="{Binding NavigateCommand}"
                                CommandParameter="ApartmentMembership"
                                Gesture="LeftClick" />
                        </Grid.InputBindings>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{StaticResource SideBarDefaultBackgroundBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarDefaultForegroundBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="ApartmentMembership">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf0c0;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Članstvo u zgradi" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="3"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarCommonRoomItem"
                        Cursor="Hand"
                        Tag="CommonRoom">

                        <Grid.InputBindings>
                            <MouseBinding
                                Command="{Binding NavigateCommand}"
                                CommandParameter="CommonRoom"
                                Gesture="LeftClick" />
                        </Grid.InputBindings>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{StaticResource SideBarDefaultBackgroundBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarDefaultForegroundBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="CommonRoom">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf4b8;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Zajedničke prostorije" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="4"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarCommonRoomRentalRequestItem"
                        Cursor="Hand"
                        Tag="CommonRoomRentalRequest">

                        <Grid.InputBindings>
                            <MouseBinding
                                Command="{Binding NavigateCommand}"
                                CommandParameter="CommonRoomRentalRequest"
                                Gesture="LeftClick" />
                        </Grid.InputBindings>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{StaticResource SideBarDefaultBackgroundBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarDefaultForegroundBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="CommonRoomRentalRequest">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf084;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Iznajmljivanje prostorija" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="5"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarNoticeBoardItem"
                        Cursor="Hand"
                        Tag="NoticeBoard">

                        <Grid.InputBindings>
                            <MouseBinding
                                Command="{Binding NavigateCommand}"
                                CommandParameter="NoticeBoard"
                                Gesture="LeftClick" />
                        </Grid.InputBindings>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{StaticResource SideBarDefaultBackgroundBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarDefaultForegroundBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="NoticeBoard">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf0a1;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Oglasna tabla" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="6"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarSchedulingAssemblyItem"
                        Cursor="Hand"
                        Tag="SchedulingAssembly">

                        <Grid.InputBindings>
                            <MouseBinding
                                Command="{Binding NavigateCommand}"
                                CommandParameter="SchedulingAssembly"
                                Gesture="LeftClick" />
                        </Grid.InputBindings>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{StaticResource SideBarDefaultBackgroundBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarDefaultForegroundBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="SchedulingAssembly">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf66f;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Zakazivanje skupštine" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="7"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,2">
                    <Grid
                        x:Name="sideBarReportedIssueItem"
                        Cursor="Hand"
                        Tag="ReportedIssue">

                        <Grid.InputBindings>
                            <MouseBinding
                                Command="{Binding NavigateCommand}"
                                CommandParameter="ReportedIssue"
                                Gesture="LeftClick" />
                        </Grid.InputBindings>

                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{StaticResource SideBarDefaultBackgroundBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarDefaultForegroundBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding SelectedSection}" Value="ReportedIssue">
                                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                Margin="40,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                FontSize="25"
                                Text="&#xf7d9;" />
                        </Grid>
                        <Grid Grid.Column="1">
                            <TextBlock
                                Margin="16,0,16,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="21"
                                Text="Pregled problema" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Frame
                x:Name="BuildingFrame"
                Grid.Row="1"
                Content="{Binding CurrentPage}"
                NavigationUIVisibility="Hidden" />
        </Grid>

    </Grid>
</Page>
