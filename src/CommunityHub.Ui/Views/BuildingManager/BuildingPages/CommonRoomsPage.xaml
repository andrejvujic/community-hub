<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingPages.CommonRoomsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager.BuildingPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="CommonRoomsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource AppFontFamily}"
    Loaded="CommonRoomsPage_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:RentalTypeToStringConverter x:Key="RentalTypeToStringConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="10,25,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBlock
                    Margin="10,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    FontSize="28"
                    MouseLeftButtonDown="LeftArrow_Click"
                    Text="&#xf060;" />
            </Grid>

            <Grid Grid.Column="1">
                <TextBlock
                    x:Name="streetInfo"
                    Margin="15,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="21"
                    Text="{Binding StreetInfo}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="20,25,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock FontSize="25" Text="Kreiraj zajedničku prostoriju" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="28"
                            Text="&#xe4eb;" />
                    </Grid>

                    <Grid Grid.Column="1">
                        <TextBlock
                            Margin="15,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            xml:space="preserve"
                            FontSize="18"
                            Text="Uneti podatke vezane za kreiranje zajedničke prostorije.&#10;Svako polje je obavezno uneti!"
                            TextWrapping="Wrap" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <GroupBox
                        Margin="0,20,20,0"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="2"
                        FontSize="19"
                        Header="Podaci">
                        <Grid Margin="15,25,15,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock Text="Naziv prostorije:" />
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBox
                                    x:Name="nameTextBox"
                                    Width="400"
                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid
                                Grid.Row="2"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="Red"
                                    Text="{Binding NameError}"
                                    Visibility="{Binding IsNameErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <Grid
                                Grid.Row="3"
                                Margin="0,15,0,8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock Text="Opis prostorije:" />
                            </Grid>

                            <Grid
                                Grid.Row="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBox
                                    x:Name="descriptionTextBox"
                                    Width="400"
                                    Height="60"
                                    AcceptsReturn="True"
                                    FontSize="15"
                                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                            </Grid>

                            <Grid
                                Grid.Row="5"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    Foreground="Red"
                                    Text="{Binding DescriptionError}"
                                    Visibility="{Binding IsDescriptionErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <Grid
                                Grid.Row="6"
                                Margin="0,15,0,8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock Text="Sprat:" />
                            </Grid>

                            <Grid
                                Grid.Row="7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <xctk:IntegerUpDown
                                    x:Name="floorsUpDown"
                                    Width="70"
                                    Increment="1"
                                    Maximum="{Binding FloorMaximum}"
                                    Minimum="1"
                                    TextAlignment="Center"
                                    Value="{Binding SelectedFloor, Mode=TwoWay}" />
                            </Grid>

                            <Grid
                                Grid.Row="8"
                                Margin="0,15,0,8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <TextBlock Text="Način iznajmljivanja:" />
                            </Grid>

                            <Grid
                                Grid.Row="9"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                <ComboBox
                                    x:Name="rentalTypeComboBox"
                                    Padding="10,4,10,4"
                                    Cursor="Hand"
                                    SelectedIndex="{Binding SelectedRentalTypeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="jedan dan" IsSelected="True" />
                                    <ComboBoxItem Content="više dana" />
                                </ComboBox>
                            </Grid>

                            <Grid
                                Grid.Row="11"
                                Margin="0,30,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        x:Name="cancelButton"
                                        Width="100"
                                        Margin="0,0,15,0"
                                        Padding="0,8,0,8"
                                        Click="CancelButton_Click"
                                        Cursor="Hand">
                                        Otkaži
                                    </Button>
                                    <Button
                                        x:Name="confirmButton"
                                        Width="100"
                                        Margin="0,0,15,0"
                                        Padding="0,8,0,8"
                                        Click="ConfirmButton_Click"
                                        Cursor="Hand"
                                        IsEnabled="True">
                                        Potvrdi
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>

            <Border
                Grid.Column="1"
                BorderBrush="Black"
                BorderThickness="1" />

            <Grid Grid.Column="2" Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock FontSize="25" Text="Pregled zajedničkih prostorija" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,20,0,20">
                    <DataGrid
                        x:Name="commonRoomsDataGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        FontSize="14"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding CommonRooms}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="CommonRoomsDataGrid_SelectionChanged"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="Naziv prostorije" />

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding FloorNumber}"
                                Header="Sprat" />

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding RentalType, Converter={StaticResource RentalTypeToStringConverter}}"
                                Header="Način iznajmljivanja" />

                            <DataGridTemplateColumn Width="*" Header="Akcija">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                            FontSize="25"
                                            Text="&#xf133;" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,0">
                    <Viewbox>
                        <Calendar
                            x:Name="calendar"
                            DisplayMode="Month"
                            IsEnabled="True"
                            SelectedDatesChanged="Calendar_SelectedDatesChanged"
                            SelectionMode="MultipleRange"
                            Visibility="Hidden" />
                    </Viewbox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>