<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingPages.CommonRoomsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager.BuildingPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="CommonRoomsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource InterFontFamily}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/MaterialDesignTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:RentalTypeToStringConverter x:Key="RentalTypeToStringConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="GroupBoxHeaderStyle" TargetType="GroupBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border
                                Background="White"
                                BorderBrush="Black"
                                BorderThickness="2"
                                CornerRadius="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Padding="10,5,10,5"
                                        Background="{StaticResource NavBarDefaultBackgroundBrush}">
                                        <TextBlock
                                            FontSize="{TemplateBinding FontSize}"
                                            Foreground="White"
                                            Text="{TemplateBinding Header}" />
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <ContentPresenter Margin="0,0,0,0" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="10,25,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock
                x:Name="streetInfo"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource InterFontFamily}"
                FontSize="22"
                FontWeight="Normal"
                Foreground="#1C1E21"
                Text="{Binding StreetInfo}" />
        </Grid>

        <Grid Grid.Row="1" Margin="20,25,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock FontSize="25" Text="Kreiraj zajedničku prostoriju" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="28"
                            Text="&#xe4eb;" />
                    </Grid>

                    <Grid Grid.Column="1">
                        <TextBlock
                            Margin="15,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            xml:space="preserve"
                            FontSize="18"
                            Text="Uneti podatke vezane za kreiranje zajedničke prostorije.&#10;Svako polje je obavezno uneti!"
                            TextWrapping="Wrap" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <GroupBox
                        Margin="0,20,20,0"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="2"
                        FontSize="19"
                        Header="Podaci"
                        Style="{StaticResource GroupBoxHeaderStyle}">
                        <DockPanel>
                            <StackPanel
                                Margin="0,0,10,10"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Bottom"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="cancelButton"
                                    Width="100"
                                    Margin="0,0,15,0"
                                    Padding="0,8,0,8"
                                    Background="#0F5AA6"
                                    BorderBrush="#0F5AA6"
                                    Command="{Binding CancelCommand}"
                                    Cursor="Hand"
                                    FontSize="16"
                                    Foreground="White">
                                    Otkaži
                                </Button>
                                <Button
                                    x:Name="confirmButton"
                                    Width="100"
                                    Margin="0,0,15,0"
                                    Padding="0,8,0,8"
                                    Background="#0F5AA6"
                                    BorderBrush="#0F5AA6"
                                    Command="{Binding ConfirmCommand}"
                                    Cursor="Hand"
                                    FontSize="16"
                                    Foreground="White">
                                    Potvrdi
                                </Button>
                            </StackPanel>
                            <Grid Margin="15,15,15,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid
                                    Grid.Row="0"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="Naziv prostorije:" />
                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBox
                                        x:Name="nameTextBox"
                                        Width="400"
                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid
                                    Grid.Row="2"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource ErrorMessageBrush}"
                                        Text="{Binding NameError}"
                                        Visibility="{Binding IsNameErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>

                                <Grid
                                    Grid.Row="3"
                                    Margin="0,15,0,8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="Opis prostorije:" />
                                </Grid>

                                <Grid
                                    Grid.Row="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <Border
                                        Width="400"
                                        Height="70"
                                        BorderBrush="#DDDFE2"
                                        BorderThickness="2">
                                        <TextBox
                                            x:Name="descriptionTextBox"
                                            Padding="8,6,8,6"
                                            AcceptsReturn="True"
                                            Background="White"
                                            BorderThickness="0"
                                            FontSize="15"
                                            Foreground="#1C1E21"
                                            Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />
                                    </Border>
                                </Grid>

                                <Grid
                                    Grid.Row="5"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{StaticResource ErrorMessageBrush}"
                                        Text="{Binding DescriptionError}"
                                        Visibility="{Binding IsDescriptionErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>

                                <Grid
                                    Grid.Row="6"
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock FontSize="17" Text="Sprat:" />
                                </Grid>

                                <Grid
                                    Grid.Row="7"
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <xctk:IntegerUpDown
                                        x:Name="floorsUpDown"
                                        Width="70"
                                        FontSize="15"
                                        Increment="1"
                                        Maximum="{Binding FloorMaximum}"
                                        Minimum="1"
                                        TextAlignment="Center"
                                        Value="{Binding SelectedFloor, Mode=TwoWay}" />
                                </Grid>

                                <Grid
                                    Grid.Row="8"
                                    Margin="0,5,0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock FontSize="17" Text="Način iznajmljivanja:" />
                                </Grid>

                                <Grid
                                    Grid.Row="9"
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <ComboBox
                                        x:Name="rentalTypeComboBox"
                                        Width="170"
                                        Padding="8,4,8,4"
                                        Cursor="Hand"
                                        FontSize="15"
                                        SelectedIndex="{Binding SelectedRentalTypeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="jedan dan" IsSelected="True" />
                                        <ComboBoxItem Content="više dana" />
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </Grid>

            <Border
                Grid.Column="1"
                BorderBrush="Black"
                BorderThickness="1" />

            <Grid Grid.Column="2" Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock FontSize="25" Text="Pregled zajedničkih prostorija" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,20,0,20">
                    <DataGrid
                        x:Name="commonRoomsDataGrid"
                        MaxHeight="200"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        FontSize="16"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding CommonRooms}"
                        RowHeight="40"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedCommonRoom, Mode=TwoWay}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F0F2F5" />
                                <Setter Property="Foreground" Value="#1C1E21" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="Padding" Value="12,8,12,8" />
                                <Setter Property="BorderBrush" Value="#DDDFE2" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="12,0,12,0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#000000" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#1C1E21" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#DCE8D8" />
                                        <Setter Property="Foreground" Value="#123B63" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Background" Value="#DCE8D8" />
                                        <Setter Property="Foreground" Value="#123B63" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                CanUserSort="False"
                                Header="Naziv prostorije">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Left" />
                                        <Setter Property="Margin" Value="12,0,0,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="#1C1E21" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Foreground" Value="#123B63" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding FloorNumber}"
                                CanUserSort="False"
                                Header="Sprat">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="#1C1E21" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Foreground" Value="#123B63" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding RentalType, Converter={StaticResource RentalTypeToStringConverter}}"
                                CanUserSort="False"
                                Header="Način iznajmljivanja">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Left" />
                                        <Setter Property="Margin" Value="12,0,0,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="#1C1E21" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                <Setter Property="Foreground" Value="#123B63" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,0">
                    <Viewbox>
                        <Calendar
                            x:Name="calendar"
                            DisplayMode="Month"
                            IsEnabled="True"
                            SelectedDatesChanged="Calendar_SelectedDatesChanged"
                            SelectionMode="MultipleRange"
                            Visibility="{Binding IsCalendarVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Viewbox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>