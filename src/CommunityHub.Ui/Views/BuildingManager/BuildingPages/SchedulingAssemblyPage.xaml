<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingPages.SchedulingAssemblyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager.BuildingPages"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SchedulingAssemblyPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource InterFontFamily}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/MaterialDesignTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="GroupBoxHeaderStyle" TargetType="GroupBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border
                                BorderBrush="Black"
                                BorderThickness="2"
                                CornerRadius="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        Padding="10,5,10,5"
                                        Background="{StaticResource NavBarDefaultBackgroundBrush}">
                                        <TextBlock
                                            FontSize="{TemplateBinding FontSize}"
                                            Foreground="White"
                                            Text="{TemplateBinding Header}" />
                                    </Border>
                                    <Border Grid.Row="1" Background="White">
                                        <ContentPresenter Margin="0" />
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10,25,40,20" Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock
                    x:Name="streetInfo"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource InterFontFamily}"
                    FontSize="22"
                    FontWeight="Normal"
                    Foreground="#1C1E21"
                    Text="{Binding StreetInfo}" />
            </Grid>

            <Grid Grid.Row="1">
                <TextBlock
                    Margin="0,20,0,20"
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="Zakaži skupštinu stanara" />
            </Grid>

            <Grid
                Grid.Row="2"
                Margin="0,0,0,30"
                HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                        FontSize="18"
                        Text="&#xe4eb;" />
                </Grid>

                <Grid Grid.Column="1">
                    <TextBlock
                        Margin="15,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        xml:space="preserve"
                        FontSize="16"
                        Text="Uneti podatke vezane za kreiranje skupštine stanara.&#10;Svako polje je obavezno uneti!"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>

            <GroupBox
                Grid.Row="3"
                Width="600"
                Height="420"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                FontSize="18"
                Header="Zakazivanje skupštine"
                Style="{StaticResource GroupBoxHeaderStyle}">
                <Grid Margin="18" Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0" Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="14"
                                    Text="Datum" />
                                <DatePicker Width="220" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="14"
                                    Text="Vreme" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="140" Text="{Binding SelectedTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="10,6,0,0"
                                        FontSize="12"
                                        Foreground="#6B7280"
                                        Text="HH:mm" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="14"
                            Foreground="{StaticResource ErrorMessageBrush}"
                            Text="{Binding DateTimeErrorMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Margin="0,20,0,0"
                        Padding="10"
                        Background="#E5E5E5"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="14"
                                Text="Teme" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Topics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                                                <TextBox
                                                    Width="360"
                                                    FontSize="16"
                                                    Style="{x:Null}"
                                                    Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap" />
                                                <Button
                                                    Width="60"
                                                    Height="28"
                                                    Margin="10,0,0,0"
                                                    Background="#0F5AA6"
                                                    BorderBrush="#0F5AA6"
                                                    Command="{Binding DataContext.RemoveTopicCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Ukloni"
                                                    Cursor="Hand"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    IsEnabled="{Binding CanRemove}">
                                                    <Button.Style>
                                                        <Style BasedOn="{x:Null}" TargetType="Button">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock
                                Grid.Row="2"
                                Margin="0,8,0,0"
                                FontSize="14"
                                Foreground="{StaticResource ErrorMessageBrush}"
                                Text="{Binding TopicsErrorMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,50,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Width="110"
                            Height="32"
                            HorizontalAlignment="Left"
                            Background="#0F5AA6"
                            BorderBrush="#0F5AA6"
                            Command="{Binding AddTopicCommand}"
                            Content="Dodaj temu"
                            Foreground="White" />
                        <Button
                            Grid.Column="2"
                            Width="90"
                            Height="30"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            Background="#0F5AA6"
                            BorderBrush="#0F5AA6"
                            Command="{Binding CancelCommand}"
                            Content="Otkaži"
                            Foreground="White" />
                        <Button
                            Grid.Column="3"
                            Width="90"
                            Height="30"
                            HorizontalAlignment="Right"
                            Background="#0F5AA6"
                            BorderBrush="#0F5AA6"
                            Command="{Binding ConfirmCommand}"
                            Content="Potvrdi"
                            Foreground="White"
                            IsEnabled="{Binding CanConfirm}" />
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Page>
