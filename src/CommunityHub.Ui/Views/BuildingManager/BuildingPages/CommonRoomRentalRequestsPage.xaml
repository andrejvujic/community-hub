<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingPages.CommonRoomRentalRequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager.BuildingPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="CommonRoomRentalRequestsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource InterFontFamily}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/MaterialDesignTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:RentalTypeToStringConverter x:Key="RentalTypeConverter" />
            <conv:RentalRequestStatusToStringConverter x:Key="RentalStatusConverter" />

            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#0F5AA6" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#0F5AA6" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="10,8,10,8" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource NavBarHoverBackgroundBrush}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource NavBarHoverBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource NavBarHoverForegroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#0F3E7D" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0F3E7D" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#CCCCCC" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#CCCCCC" />
                                    <Setter Property="Foreground" Value="#666666" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="10,25,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock
                x:Name="streetInfo"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource InterFontFamily}"
                FontSize="22"
                FontWeight="Normal"
                Foreground="#1C1E21"
                Text="{Binding StreetInfo}" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="35,30,45,30"
            Background="White"
            BorderBrush="Black"
            BorderThickness="2">
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="700" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="0,0,2,0">

                    <ListBox
                        Background="White"
                        BorderThickness="0"
                        ItemsSource="{Binding RentalRequests}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Visible"
                        SelectedItem="{Binding SelectedRentalRequest, Mode=TwoWay}">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="Transparent" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="Transparent" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="600"
                                    MinHeight="160"
                                    Margin="20,15,20,15"
                                    HorizontalAlignment="Center"
                                    BorderBrush="Black"
                                    BorderThickness="2"
                                    CornerRadius="3"
                                    Cursor="Hand">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F0F0F0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid Margin="20,14,20,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <TextBlock FontSize="20">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="Black" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}Prostorija: {0}">
                                                        <Binding Path="CommonRoom.Name" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <TextBlock FontSize="17">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="Black" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}Stanar: {0} {1}">
                                                            <Binding Path="Resident.Name" />
                                                            <Binding Path="Resident.Surname" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Grid.Column="1">
                                                <TextBlock FontSize="17">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding RequestedStartDate, StringFormat='Početni datum: {0:dd.MM.yyyy.}'}" />
                                                            <Setter Property="Foreground" Value="Black" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding CommonRoom.RentalType}" Value="MultiDay" />
                                                                        <Condition Binding="{Binding Status}" Value="WaitingDateChange" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Text" Value="{Binding ProposedStartDate, StringFormat='Predloženi početak: {0:dd.MM.yyyy.}'}" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>

                                        <Grid Grid.Row="2" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <TextBlock FontSize="17">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding CommonRoom.RentalType, Converter={StaticResource RentalTypeConverter}, StringFormat='Način iznajmljivanja: {0}'}" />
                                                            <Setter Property="Foreground" Value="Black" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Grid.Column="1">
                                                <TextBlock FontSize="17">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding RequestedEndDate, StringFormat='Krajnji datum: {0:dd.MM.yyyy.}'}" />
                                                            <Setter Property="Foreground" Value="Black" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding CommonRoom.RentalType}" Value="MultiDay" />
                                                                        <Condition Binding="{Binding Status}" Value="WaitingDateChange" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Text" Value="{Binding ProposedEndDate, StringFormat='Predloženi kraj: {0:dd.MM.yyyy.}'}" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>

                                        <Grid Grid.Row="3" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="1">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon
                                                        Grid.Column="0"
                                                        Width="18"
                                                        Height="18"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="ClockOutline" />
                                                                <Setter Property="Foreground" Value="#C69200" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                        <Setter Property="Kind" Value="CheckCircle" />
                                                                        <Setter Property="Foreground" Value="#1B8A2F" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                        <Setter Property="Kind" Value="CloseCircle" />
                                                                        <Setter Property="Foreground" Value="#C0392B" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Waiting">
                                                                        <Setter Property="Kind" Value="ClockOutline" />
                                                                        <Setter Property="Foreground" Value="#C69200" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="WaitingDateChange">
                                                                        <Setter Property="Kind" Value="CalendarClock" />
                                                                        <Setter Property="Foreground" Value="#C69200" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock Grid.Column="1" FontSize="16" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Status, Converter={StaticResource RentalStatusConverter}, StringFormat='Status: {0}'}" />
                                                                <Setter Property="Foreground" Value="Black" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SideBarHoverForegroundBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,20,0,20">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="29"
                            Text="Postupanje po zahtevu" />
                    </Grid>

                    <Grid Grid.Row="1" Background="White">
                        <TextBlock
                            x:Name="defaultActionText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Foreground="Black"
                            Text="Morate odabrati prostoriju da bi se prikazale funkcionalnosti!"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding DefaultActionTextVisibility}" />

                        <TextBlock
                            x:Name="approvedActionText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Foreground="Black"
                            Text="Prostorija je slobodna u datom opsegu. Zahtev je automatski odobren!"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding ApprovedActionTextVisibility}" />

                        <TextBlock
                            x:Name="rejectedActionText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Foreground="Black"
                            Text="U zadatom opsegu ne postoji slobodan dan. Zahtev je automatski odbijen!"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding RejectedActionTextVisibility}" />

                        <TextBlock
                            x:Name="waitingDateChangeActionText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Foreground="Black"
                            Text="Akcija je već odrađena, zahtev je u stanju promene termina!"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding WaitingDateChangeActionTextVisibility}" />

                        <StackPanel Margin="15,0,15,0" Visibility="{Binding OneDayPanelVisibility}">

                            <TextBlock
                                Margin="0,0,0,25"
                                HorizontalAlignment="Center"
                                FontSize="22"
                                Text="U nastavku su prikazani slobodni dani za iznajmljivanje prostorije:"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SuggestedOneDayDates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Margin="0,6,0,6"
                                                Padding="10,6,10,6"
                                                Command="{Binding DataContext.ApproveOneDaySuggestionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                FontSize="15"
                                                Style="{StaticResource ActionButtonStyle}">
                                                <TextBlock Text="{Binding StringFormat={}{0:dd.MM.yyyy.}}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                Text="Odaberite neki od datuma klikom na dugme sa željenim datumom."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="15,0,15,0" Visibility="{Binding MultiDayPanelVisibility}">

                            <TextBlock
                                Margin="0,0,0,25"
                                HorizontalAlignment="Center"
                                FontSize="22"
                                Text="Izabrani opseg nije slobodan, predlažemo Vam neki od ovih opsega:"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SuggestedMultiDayRanges}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Margin="0,6,0,6"
                                                Padding="10,6,10,6"
                                                Command="{Binding DataContext.AcceptMultiDaySuggestionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding DisplayText}"
                                                FontSize="15"
                                                Style="{StaticResource ActionButtonStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                Text="Odaberite neki od opsega klikom na dugme sa željenim datumom."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
