<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingPages.CommonRoomRentalRequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager.BuildingPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CommonRoomRentalRequestsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource AppFontFamily}"
    Loaded="CommonRoomRentalRequestsPage_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:RentalTypeToStringConverter x:Key="RentalTypeConverter" />
        <conv:RentalStatusToStringConverter x:Key="RentalStatusConverter" />
    </Page.Resources>

    <Grid Margin="10,25,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBlock
                    Margin="10,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    FontSize="28"
                    MouseLeftButtonDown="LeftArrow_Click"
                    Text="&#xf060;" />
            </Grid>

            <Grid Grid.Column="1">
                <TextBlock
                    x:Name="streetInfo"
                    Margin="15,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="21" />
            </Grid>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="35,30,45,30"
            BorderBrush="Black"
            BorderThickness="2">
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="700" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    BorderBrush="Black"
                    BorderThickness="0,0,2,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
                        <ItemsControl ItemsSource="{Binding RentalRequests}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="600"
                                        Height="160"
                                        Margin="20,15,20,15"
                                        HorizontalAlignment="Center"
                                        BorderBrush="Black"
                                        BorderThickness="2"
                                        CornerRadius="3"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="RentalRequestCard_Click">

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="LightGray" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>




                                        <Grid Margin="20,14,20,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <TextBlock FontSize="20">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}Prostorija: {0}">
                                                            <Binding Path="CommonRoom.Name" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0">
                                                    <TextBlock FontSize="17">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}Stanar: {0} {1}">
                                                                <Binding Path="Resident.Name" />
                                                                <Binding Path="Resident.Surname" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>

                                                <Grid Grid.Column="1">
                                                    <TextBlock FontSize="17" Text="{Binding StartDate, StringFormat='Početni datum: {0:dd.MM.yyyy.}'}" />
                                                </Grid>
                                            </Grid>

                                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0">
                                                    <TextBlock FontSize="17" Text="{Binding CommonRoom.Type, Converter={StaticResource RentalTypeConverter}, StringFormat='Način iznajmljivanja: {0}'}" />
                                                </Grid>

                                                <Grid Grid.Column="1">
                                                    <TextBlock FontSize="17" Text="{Binding EndDate, StringFormat='Krajnji datum: {0:dd.MM.yyyy.}'}" />
                                                </Grid>
                                            </Grid>

                                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="1">
                                                    <TextBlock FontSize="16" Text="{Binding Status, Converter={StaticResource RentalStatusConverter}, StringFormat='Status: {0}'}" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,20,0,20">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="26"
                            Text="Akcija upravnika" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
