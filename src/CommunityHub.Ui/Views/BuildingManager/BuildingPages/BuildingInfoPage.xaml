<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="BuildingInfoPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource InterFontFamily}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/MaterialDesignTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="10,25,40,0" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="28"
                            Text="&#x3c;">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding PreviousImageCommand}" Gesture="LeftClick" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Image
                            x:Name="displayedImage"
                            Source="{Binding CurrentImage}"
                            Stretch="Uniform" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="28"
                            Text="&#x3e;">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding NextImageCommand}" Gesture="LeftClick" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock
                        x:Name="counterTextBlock"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="{Binding ImageCounterText}" />
                </Grid>
            </Grid>
        </Grid>


        <Grid Grid.Row="1" Margin="0,50,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                FontSize="20"
                                FontStyle="Italic"
                                Text="Ulica i broj:" />
                        </Grid>

                        <Grid Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock FontSize="20">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="BuildingDto.Address.Street.Name" />
                                        <Binding Path="BuildingDto.Address.StreetNumber" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,10,0,10"
                        BorderBrush="Black"
                        BorderThickness="1" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="20"
                                FontStyle="Italic"
                                Text="Naselje:" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                Text="{Binding BuildingDto.Address.Neighborhood}" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Margin="0,10,0,10"
                        BorderBrush="Black"
                        BorderThickness="1" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="20"
                                FontStyle="Italic"
                                Text="Grad:" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                Text="{Binding BuildingDto.Address.City.Name}" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="5"
                        Margin="0,10,0,0"
                        BorderBrush="Black"
                        BorderThickness="1" />
                </Grid>

                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="20"
                                FontStyle="Italic"
                                Text="Država:" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                Text="{Binding BuildingDto.Address.Country.Name}" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,10,0,10"
                        BorderBrush="Black"
                        BorderThickness="1" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="20"
                                FontStyle="Italic"
                                Text="Broj spratova:" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                Text="{Binding BuildingDto.FloorCount}" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Margin="0,10,0,10"
                        BorderBrush="Black"
                        BorderThickness="1" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="20"
                                FontStyle="Italic"
                                Text="Broj stanova:" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                Text="{Binding BuildingDto.ApartmentCount}" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="5"
                        Margin="0,10,0,0"
                        BorderBrush="Black"
                        BorderThickness="1" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>