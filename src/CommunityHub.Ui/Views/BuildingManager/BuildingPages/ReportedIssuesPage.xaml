<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingPages.ReportedIssuesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager.BuildingPages"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ReportedIssuesPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource InterFontFamily}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/MaterialDesignTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:IssuePriorityToStringConverter x:Key="ReportedIssuePriorityToStringConverter" />
            <conv:IssueStatusToStringConverter x:Key="ReportedIssueStatusToStringConverter" />

            <Style x:Key="IssueItemStyle" TargetType="Border">
                <Setter Property="Background" Value="#FCFBF7" />
                <Setter Property="BorderBrush" Value="#A8A39B" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource SideBarHoverBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="#0F1F35" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer>
        <Grid Margin="10,25,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock
                    x:Name="streetInfo"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource InterFontFamily}"
                    FontSize="22"
                    FontWeight="Normal"
                    Foreground="#1C1E21"
                    Text="{Binding StreetInfo}" />
            </Grid>

            <Grid Grid.Row="1" Margin="30,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1000" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding ReportedIssues}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Width="480"
                                    Height="200"
                                    Margin="0,20,15,0"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="12"
                                    Style="{StaticResource IssueItemStyle}">
                                    <Grid Margin="15,15,15,15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <TextBlock FontSize="20">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}">
                                                            <Binding Path="Resident.Name" />
                                                            <Binding Path="Resident.Surname" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>

                                            </Grid>

                                            <Grid
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                                <TextBlock FontSize="18" Text="{Binding ReportedAt, StringFormat={}{0:dd.MM.yyyy.}}" />
                                            </Grid>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <TextBlock FontSize="17" Text="{Binding Status, Converter={StaticResource ReportedIssueStatusToStringConverter}, StringFormat='Status: {0}'}" />
                                        </Grid>

                                        <Grid Grid.Row="2" Margin="0,13,0,0">
                                            <TextBlock
                                                FontSize="14"
                                                Text="{Binding Description, StringFormat='Opis: {0}'}"
                                                TextWrapping="Wrap" />
                                        </Grid>

                                        <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <materialDesign:PackIcon
                                                        Width="18"
                                                        Height="18"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="CheckCircleOutline" />
                                                                <Setter Property="Foreground" Value="#1B8A2F" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="ShouldBeResolvedSoon">
                                                                        <Setter Property="Kind" Value="ClockOutline" />
                                                                        <Setter Property="Foreground" Value="#C69200" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                                                        <Setter Property="Kind" Value="AlertCircle" />
                                                                        <Setter Property="Foreground" Value="#C0392B" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="CanWait">
                                                                        <Setter Property="Kind" Value="CheckCircleOutline" />
                                                                        <Setter Property="Foreground" Value="#1B8A2F" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock FontSize="17" Text="{Binding Priority, Converter={StaticResource ReportedIssuePriorityToStringConverter}, StringFormat='Prioritet: {0}'}" />
                                                </StackPanel>
                                            </Grid>

                                            <Button
                                                Grid.Column="1"
                                                Padding="6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.SolveIssueCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand">

                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Foreground" Value="Black" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Open">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FFFFFF" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>

                                                <TextBlock FontSize="17">
                                                    <Run FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free" Text="&#xf0ad;" />
                                                    <Run Text=" Popravi" />
                                                </TextBlock>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
