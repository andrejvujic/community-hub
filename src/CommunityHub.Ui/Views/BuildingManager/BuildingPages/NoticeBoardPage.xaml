<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingPages.NoticeBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager.BuildingPages"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NoticeBoardPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource AppFontFamily}"
    Loaded="NoticeBoardPage_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:AdCategoryToStringConverter x:Key="AdCategoryToStringConverter" />
        <conv:AdStatusToStringConverter x:Key="AdStatusToStringConverter" />
        <conv:AdTypeToStringConverter x:Key="AdTypeToStringConverter" />
    </Page.Resources>

    <ScrollViewer>
        <Grid Margin="10,25,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    FontSize="28"
                    MouseLeftButtonDown="LeftArrow_Click"
                    Text="&#xf060;" />

                <TextBlock
                    x:Name="streetInfo"
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="21" />
            </Grid>

            <Grid Grid.Row="1" Margin="60,15,40,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="10,15,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="28"
                    Text="Statistika" />

                <Grid Grid.Row="1" Margin="10,35,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,15,0"
                        FontSize="22"
                        Text="Godina:" />

                    <ComboBox
                        x:Name="yearComboBox"
                        Grid.Column="1"
                        Width="180"
                        Margin="0,0,15,0"
                        Cursor="Hand"
                        FontSize="18"
                        SelectionChanged="YearComboBox_SelectionChanged">
                        <ComboBoxItem Content="2026" IsSelected="True" />
                        <ComboBoxItem Content="2025" />
                        <ComboBoxItem Content="2024" />
                    </ComboBox>

                    <TextBlock
                        Grid.Column="2"
                        Margin="0,0,15,0"
                        FontSize="22"
                        Text="Mesec:" />

                    <ComboBox
                        x:Name="monthComboBox"
                        Grid.Column="3"
                        Width="180"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        FontSize="18"
                        SelectionChanged="MonthComboBox_SelectionChanged">
                        <ComboBoxItem Content="Svi" IsSelected="True" />
                        <ComboBoxItem Content="Januar" />
                        <ComboBoxItem Content="Februar" />
                        <ComboBoxItem Content="Mart" />
                        <ComboBoxItem Content="April" />
                        <ComboBoxItem Content="Maj" />
                        <ComboBoxItem Content="Jun" />
                        <ComboBoxItem Content="Jul" />
                        <ComboBoxItem Content="Avgust" />
                        <ComboBoxItem Content="Septembar" />
                        <ComboBoxItem Content="Oktobar" />
                        <ComboBoxItem Content="Novembar" />
                        <ComboBoxItem Content="Decembar" />
                    </ComboBox>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="60,40,40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <lvc:PieChart
                    x:Name="offerRequestPieChart"
                    Grid.Column="0"
                    Width="250"
                    Height="250"
                    Margin="0,0,20,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    TooltipPosition="Center" />

                <ScrollViewer
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <lvc:CartesianChart
                        x:Name="categoryBarChart"
                        Width="700"
                        Height="250" />
                </ScrollViewer>

                <TextBlock
                    x:Name="noDataTextBlock"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="22"
                    Foreground="Black"
                    Text="Ne postoje kreirani oglasi za ovaj period."
                    Visibility="Collapsed" />
            </Grid>

            <Grid
                Grid.Row="3"
                Margin="0,70,0,0"
                HorizontalAlignment="Center">
                <DataGrid
                    x:Name="categoryDataGrid"
                    MaxHeight="180"
                    HorizontalAlignment="Center"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    FontSize="16"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Disabled"
                    IsReadOnly="True"
                    RowHeight="38"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="250"
                            Binding="{Binding Category}"
                            Header="Kategorija" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding OfferCount}"
                            Header="Nudi pomoć" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding RequestCount}"
                            Header="Traži pomoć" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Sum}"
                            Header="Ukupno" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <TextBlock
                Grid.Row="4"
                Margin="0,40,0,0"
                HorizontalAlignment="Center"
                FontSize="28"
                Text="Svi oglasi" />

            <Grid
                Grid.Row="5"
                Margin="30,15,30,40"
                HorizontalAlignment="Center">
                <DataGrid
                    x:Name="adsDataGrid"
                    MaxHeight="400"
                    VerticalAlignment="Top"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    FontSize="20"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Ads}"
                    RowHeight="40"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Author.Name}"
                            Header="Ime stanara" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Author.Surname}"
                            Header="Prezime stanara" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Type, Converter={StaticResource AdTypeToStringConverter}}"
                            Header="Tip pomoći" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding StartDate, StringFormat='dd.MM.yyyy.'}"
                            Header="Početni datum" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding EndDate, StringFormat='dd.MM.yyyy.'}"
                            Header="Krajnji datum" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Category, Converter={StaticResource AdCategoryToStringConverter}}"
                            Header="Kategorija" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Status, Converter={StaticResource AdStatusToStringConverter}}"
                            Header="Status" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="6" Margin="25,30,25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="200"
                    Height="200"
                    Margin="0,0,30,0"
                    BorderBrush="Black"
                    BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" HorizontalAlignment="Left">
                            <TextBlock
                                Margin="15,15,0,0"
                                FontSize="20"
                                Text="Broj trenutno&#x0a;aktivnih oglasa" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock x:Name="activeAdsTextBlock" FontSize="40" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Width="200"
                    Height="200"
                    Margin="0,0,30,0"
                    BorderBrush="Black"
                    BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" HorizontalAlignment="Left">
                            <TextBlock
                                Margin="15,15,0,0"
                                FontSize="20"
                                Text="Broj trenutno&#x0a;arhiviranih oglasa" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock x:Name="archivedAdsTextBlock" FontSize="40" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Width="500"
                    Height="200"
                    Margin="0,0,0,0"
                    BorderBrush="Black"
                    BorderThickness="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" HorizontalAlignment="Left">
                            <TextBlock
                                Margin="15,15,0,0"
                                FontSize="20"
                                Text="Stanar koji je najviše pomogao odnsosno koji&#x0a;je ponudio najviše pomoći ostalima" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock x:Name="mostHelpfulResidentTextBlock" FontSize="40" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock
                            Margin="25,30,0,20"
                            FontSize="25"
                            Text="Kategorije" />
                    </Grid>

                    <DataGrid
                        x:Name="categoryActiveAdsDataGrid"
                        Grid.Row="1"
                        MaxHeight="180"
                        Margin="35,0,0,20"
                        HorizontalAlignment="Left"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        FontSize="16"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Disabled"
                        IsReadOnly="True"
                        RowHeight="38"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="250"
                                Binding="{Binding Category}"
                                Header="Kategorija" />
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding ActiveAdsCount}"
                                Header="Trenutno aktivni oglasi" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>