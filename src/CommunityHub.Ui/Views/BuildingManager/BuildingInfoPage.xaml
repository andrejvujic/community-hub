<Page
    x:Class="CommunityHub.Ui.Views.BuildingManager.BuildingInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="BuildingInfoPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{StaticResource AppFontFamily}"
    mc:Ignorable="d">

    <Grid Margin="10,25,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Cursor="Hand"
                FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                FontSize="28"
                MouseLeftButtonDown="LeftArrow_Click"
                Text="&#xf060;" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="28"
                            MouseLeftButtonDown="PreviousImage_Click"
                            Text="&#x3c;" />
                    </Grid>

                    <Grid Grid.Column="1">
                        <Image x:Name="displayedImage" Stretch="Uniform" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            FontSize="28"
                            MouseLeftButtonDown="NextImage_Click"
                            Text="&#x3e;" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock
                        x:Name="counterTextBlock"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold" />
                </Grid>
            </Grid>
        </Grid>


        <Grid Grid.Row="2" Margin="0,50,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock FontSize="20" Text="Ulica i broj:" />
                        </Grid>

                        <Grid Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock FontSize="20">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="Address.Street.Name" />
                                        <Binding Path="Address.StreetNumber" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,10,0,10"
                        BorderBrush="Black"
                        BorderThickness="1" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="20"
                                Text="Naselje:" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                Text="{Binding Address.Neighborhood}" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Margin="0,10,0,10"
                        BorderBrush="Black"
                        BorderThickness="1" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="20"
                                Text="Grad:" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                Text="{Binding Address.City.Name}" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="5"
                        Margin="0,10,0,0"
                        BorderBrush="Black"
                        BorderThickness="1" />
                </Grid>

                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="20"
                                Text="Država:" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                Text="{Binding Address.Country.Name}" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,10,0,10"
                        BorderBrush="Black"
                        BorderThickness="1" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="20"
                                Text="Broj spratova:" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                Text="{Binding FloorCount}" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Margin="0,10,0,10"
                        BorderBrush="Black"
                        BorderThickness="1" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="20"
                                Text="Broj stanova:" />
                        </Grid>

                        <Grid Grid.Column="1">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                Text="{Binding ApartmentCount}" />
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="5"
                        Margin="0,10,0,0"
                        BorderBrush="Black"
                        BorderThickness="1" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>