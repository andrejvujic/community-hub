<Window x:Class="CommunityHub.Ui.Views.Citizen.Events.MarkVolunteersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        Title="{Binding Event.Name}" Height="420" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Padding="10">
    <Window.Resources>
        <conv:EventStatusToStringConverter x:Key="EventStatusToString" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Fill="Black"/>
                </Viewbox>
                <StackPanel>
                    <TextBlock Text="{Binding Event.Name}" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="{Binding Event.Status, Converter={StaticResource EventStatusToString}}" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                        <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Fill="#333"/>
                    </Viewbox>
                    <TextBlock Text="{Binding Event.EventStart, StringFormat=dd/MM/yyyy}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                        <Path Data="M12 20c4.418 0 8-3.582 8-8s-3.582-8-8-8-8 3.582-8 8 3.582 8 8 8zm-.5-13h1v5l4.25 2.52-.5.86L11.5 12V7z" Fill="#333"/>
                    </Viewbox>
                    <TextBlock Text="{Binding Event.EventStart, StringFormat=HH:mm}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                        <TextBlock Text="⏳" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Viewbox>
                    <TextBlock Text="{Binding Event.DurationMinutes, StringFormat={}{0} min}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding Event.Description}" TextWrapping="Wrap" Margin="10,0,10,10"/>

        <DataGrid Grid.Row="2" Margin="40,0,40,10" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"
                  ItemsSource="{Binding Event.Registrations}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Volonter" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="Citizen.Name"/>
                            <Binding Path="Citizen.Surname"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Prisustvo" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Attended, Mode=OneWay}" Click="PresenceCheckBox_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
