<Window x:Class="CommunityHub.Ui.Views.Citizen.Events.ApplyToVolunteerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        Height="500" Width="600" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Language="sr-Latn-RS">

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ToggleItemCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <helpers:CollectionInclusionToVisibilityConverter x:Key="CollectionInclusionToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="15,6,15,6" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,0,0,2" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Prijava za volontiranje" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="32" Height="32" Command="{Binding CloseCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Row="0" Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                        <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Fill="{StaticResource TextBrush}"/>
                    </Viewbox>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EventName}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Fill="{StaticResource TextBrush}"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{Binding EventStart, StringFormat=d}" FontSize="16" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M12 20c4.418 0 8-3.582 8-8s-3.582-8-8-8-8 3.582-8 8 3.582 8 8 8zm-.5-13h1v5l4.25 2.52-.5.86L11.5 12V7z" Fill="{StaticResource TextBrush}"/>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{Binding EventStart, StringFormat=t}" FontSize="16" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontSize="18" FontWeight="Bold" Margin="0,10,0,0" Foreground="{StaticResource TextBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Građanin: {0} {1}">
                                <Binding Path="Citizen.Name" TargetNullValue="N/A" FallbackValue="N/A"/>
                                <Binding Path="Citizen.Surname" TargetNullValue="" FallbackValue=""/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,12,0,8" FontSize="15" Foreground="{StaticResource TextBrush}">
                    Izaberite stavke koje možete doneti. Ako je stavka označena sa strane, to znači da već postoji volonter koji donosi tu stavku.
                </TextBlock>

                <Border Grid.Row="2" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="2" Background="{StaticResource BackgroundBrush}" Margin="0,0,0,12">
                    <ListBox x:Name="ItemsListBox" SelectionMode="Single" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Tag="{Binding AlreadyAssignedItemIds}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0" Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Item.Name}" VerticalAlignment="Center" FontSize="16" Margin="8,0,0,0" Foreground="{StaticResource TextBrush}" />

                                    <CheckBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" Style="{StaticResource PrimaryCheckBox}" />

                                    <TextBlock Grid.Column="2" Text="✔" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" Foreground="{StaticResource AccentBrush}">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource CollectionInclusionToVisibilityConverter}">
                                                <Binding Path="Item.Id" />
                                                <Binding ElementName="ItemsListBox" Path="Tag" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Height="44" Command="{Binding CancelCommand}" Style="{StaticResource PrimaryButton}" Foreground="{StaticResource TextBrush}" Padding="0">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center">Otkaži prijavu<LineBreak/>(Esc)</TextBlock>
                    </Button>
                    <Button Grid.Column="2" Height="44" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Foreground="{StaticResource TextBrush}" Padding="0">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center">Potvrdi prijavu<LineBreak/>(Enter)</TextBlock>
                    </Button>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,2,0,0" Padding="5,2,5,2" Background="{StaticResource AccentBrush}" Height="24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Listaj stavke - Strelice gore/dole" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,0,100,0"/>
                    <TextBlock Text="Dodaj/ukloni stavku - Ctrl+1" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
