<Window x:Class="CommunityHub.Ui.Views.Citizen.Events.ApplyToVolunteerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        Title="Prijava za volontiranje" Height="420" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Language="sr-Latn-RS">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:CollectionInclusionToVisibilityConverter x:Key="CollectionInclusionToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Row="0" Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Fill="Black"/>
            </Viewbox>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleTextBlock" Text="{Binding EventName}" FontSize="18" FontWeight="Bold" />
            </StackPanel>

            <Grid Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Fill="#333"/>
                    </Viewbox>
                    <TextBlock Grid.Column="1" Text="{Binding EventStart, StringFormat=d}" FontSize="12" Foreground="#333" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="M12 20c4.418 0 8-3.582 8-8s-3.582-8-8-8-8 3.582-8 8 3.582 8 8 8zm-.5-13h1v5l4.25 2.52-.5.86L11.5 12V7z" Fill="#333"/>
                    </Viewbox>
                    <TextBlock Grid.Column="1" Text="{Binding EventStart, StringFormat=t}" FontSize="12" Foreground="#333" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <TextBlock x:Name="CitizenTextBlock" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding CitizenName}" FontSize="16" FontWeight="Bold" Margin="10,10,2,-4" />
        </Grid>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="6,12,6,8">
            Izaberite stavke koje možete doneti. Možete menjati selekciju pomoću strelica za gore i dole. Pritisnite Ctrl + 1 jednom da izaberete, i ponovo da opozovete izbor. Ako je stavka označena, to znači da već postoji volonter koji donosi tu stavku.
        </TextBlock>

        <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1" CornerRadius="4" Background="White" Margin="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="ItemsListBox" Grid.Row="0" SelectionMode="Single" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0" Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Item.Name}" VerticalAlignment="Center" Margin="8,0,0,0" />

                                <CheckBox Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                <TextBlock Grid.Column="2" Text="✔" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" Foreground="#2E8B57">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource CollectionInclusionToVisibilityConverter}">
                                            <Binding Path="Item.Id" />
                                            <Binding ElementName="ItemsListBox" Path="Tag" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Height="40" Margin="0,0,12,0" BorderBrush="Black" BorderThickness="2" Click="CancelButton_Click">
                <TextBlock TextAlignment="Center">Otkazi prijavu<LineBreak/>(Esc)</TextBlock>
            </Button>
            <Button Grid.Column="1" Height="40" BorderBrush="Black" BorderThickness="2" Click="ConfirmButton_Click">
                <TextBlock TextAlignment="Center">Potvrdi prijavu<LineBreak/>(Enter)</TextBlock>
            </Button>
        </Grid>

    </Grid>
</Window>