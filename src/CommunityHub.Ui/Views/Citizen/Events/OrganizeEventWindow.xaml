<Window x:Class="CommunityHub.Ui.Views.Citizen.Events.OrganizeEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organizuj novi događaj" Height="520" Width="760" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Language="sr-Latn-RS">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Naziv događaja:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Grid>
                <TextBox x:Name="NameBox" Width="420" Height="26" HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="4,0,0,0" TextChanged="Input_Changed"/>
                    <TextBlock Text="Unesite naziv događaja" Foreground="#888" Margin="8,4,0,0" VerticalAlignment="Top" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>

            <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock Text="Opis:"/>
            <Grid>
                <TextBox x:Name="DescriptionBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="4" TextChanged="Input_Changed"/>
                <TextBlock Text="Kratko objasnite o čemu je događaj" Foreground="#888" Margin="6,6,6,6" TextWrapping="Wrap" IsHitTestVisible="False" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=DescriptionBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Datum:" VerticalAlignment="Center" Margin="0,0,8,24" HorizontalAlignment="Left" />
                <DatePicker Grid.Row="0" Grid.Column="1" x:Name="DatePicker" Width="160" Height="28" Margin="0,0,0,24" SelectedDateChanged="Input_Changed" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Vreme:" VerticalAlignment="Center" Margin="0,0,8,16" HorizontalAlignment="Left" />
                <Grid Grid.Row="1" Grid.Column="1" Width="160" Margin="0,0,0,24" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HourBox" Grid.Column="0" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,6,0" Height="28" VerticalContentAlignment="Center" TextChanged="Input_Changed" />
                    <TextBlock Text=":" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBox x:Name="MinuteBox" Grid.Column="2" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="6,0,0,0" Height="28" VerticalContentAlignment="Center" TextChanged="Input_Changed" />
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Trajanje:" VerticalAlignment="Center" Margin="0,0,8,16" HorizontalAlignment="Left" />
                <Grid Grid.Row="2" Grid.Column="1" Width="160" Margin="0,0,0,24" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DurationHourBox" Grid.Column="0" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,6,0" Height="28" VerticalContentAlignment="Center" TextChanged="Input_Changed" />
                    <TextBlock Text=":" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBox x:Name="DurationMinuteBox" Grid.Column="2" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch" Margin="6,0,0,0" Height="28" VerticalContentAlignment="Center" TextChanged="Input_Changed" />
                </Grid>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Potrebno volontera:" VerticalAlignment="Center" Margin="0,0,8,24" HorizontalAlignment="Left" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="VolunteersBox" Width="160" Height="28" HorizontalContentAlignment="Center" Margin="0,0,0,24" VerticalContentAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Potrebne stvari:" />
                <Grid>
                    <TextBox x:Name="ItemsBox" Height="160" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="4" TextChanged="Input_Changed"/>
                    <TextBlock Text="Unesite potrebne stvari, odvojene zarezom" Foreground="#888" Margin="6,6,6,6" TextWrapping="Wrap" IsHitTestVisible="False" VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ItemsBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="DiscardButton" Height="40" Margin="0,0,12,0" BorderBrush="Black" BorderThickness="2" Click="DiscardButton_Click">
                <TextBlock TextAlignment="Center">Odbaci događaj<LineBreak/>(Esc)</TextBlock>
            </Button>
            <Button Grid.Column="1" x:Name="SaveButton" Height="40" BorderBrush="Black" BorderThickness="2" Click="SaveButton_Click" IsEnabled="False">
                <TextBlock TextAlignment="Center">Sačuvaj događaj<LineBreak/>(Enter)</TextBlock>
            </Button>
        </Grid>
    </Grid>
</Window>
