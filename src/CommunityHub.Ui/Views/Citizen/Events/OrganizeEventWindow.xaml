<Window x:Class="CommunityHub.Ui.Views.Citizen.Events.OrganizeEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="625" Width="850" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Language="sr-Latn-RS">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
        <KeyBinding Key="Return" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Space" Command="{Binding AddItemCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="15,6,15,6" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,0,0,2" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Organizuj novi događaj" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="32" Height="32" Command="{Binding CloseCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Naziv događaja:" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="16" />
                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <TextBox x:Name="NameBox" Height="32" VerticalContentAlignment="Center" Padding="8,0,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="1,1,1,1" />
                        <TextBlock Text="Unesite naziv događaja" Foreground="{StaticResource GridLineBrush}" Margin="10,8,0,0" VerticalAlignment="Top" FontSize="12" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Opis:" Foreground="{StaticResource TextBrush}" FontSize="16" Margin="0,0,0,4" />
                    <Grid Height="100">
                        <TextBox x:Name="DescriptionBox" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" />
                        <TextBlock Text="Kratko objasnite o čemu je događaj" Foreground="{StaticResource GridLineBrush}" Margin="10,10,0,0" TextWrapping="Wrap" IsHitTestVisible="False" VerticalAlignment="Top" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=DescriptionBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,30,0,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Datum:" VerticalAlignment="Center" Margin="0,0,8,12" Foreground="{StaticResource TextBrush}" FontSize="16" />
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DateTextBox" 
                                     Grid.Column="0"
                                     Background="{StaticResource BackgroundBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource TextBrush}"
                                     BorderThickness="1,1,0,1"
                                     Padding="8,6"
                                     FontSize="13"
                                     Height="32"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="{StaticResource TextBrush}"/>
                            <Button x:Name="DatePickerButton" 
                                    Grid.Column="1"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource TextBrush}"
                                    BorderThickness="1"
                                    Padding="6"
                                    Width="32"
                                    Height="32"
                                    Command="{Binding ToggleCalendarCommand}"
                                    Content="▼"
                                    FontSize="10"
                                    Foreground="{StaticResource TextBrush}"/>
                            <Popup x:Name="DatePickerPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=DatePickerButton}" AllowsTransparency="True" PopupAnimation="Slide">
                                <Calendar x:Name="EventCalendar" 
                                          Background="{StaticResource BackgroundBrush}"
                                          Foreground="{StaticResource TextBrush}"
                                          BorderBrush="{StaticResource TextBrush}"
                                          BorderThickness="1"
                                          SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                          DisplayDateStart="{Binding DisplayDateStart, Mode=OneWay}"
                                          DisplayDateEnd="{Binding DisplayDateEnd, Mode=OneWay}"
                                          SelectedDatesChanged="EventCalendar_SelectedDatesChanged"/>
                            </Popup>
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vreme:" VerticalAlignment="Center" Margin="0,0,8,12" Foreground="{StaticResource TextBrush}" FontSize="16" />
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HourBox" Grid.Column="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding Hour, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" />
                            <TextBlock Text=":" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,6,0" Foreground="{StaticResource TextBrush}" />
                            <TextBox x:Name="MinuteBox" Grid.Column="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding Minute, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" />
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Trajanje:" VerticalAlignment="Center" Margin="0,0,8,12" Foreground="{StaticResource TextBrush}" FontSize="16" />
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DurationHourBox" Grid.Column="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding DurationHour, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" />
                            <TextBlock Text=":" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0,6,0" Foreground="{StaticResource TextBrush}" />
                            <TextBox x:Name="DurationMinuteBox" Grid.Column="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding DurationMinute, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" />
                        </Grid>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Potrebno volontera:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextBrush}" FontSize="16" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="VolunteersBox" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Text="{Binding Volunteers, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" />
                    </Grid>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Potrebne stvari:" Foreground="{StaticResource TextBrush}" FontSize="16" Margin="0,0,0,8" />
                        <Grid Height="180">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ItemInputBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Padding="8,0,0,0" Margin="0,0,8,0" Text="{Binding ItemInput, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" />
                                <Button Grid.Column="1" x:Name="AddItemButton" Height="32" Command="{Binding AddItemCommand}" Style="{StaticResource PrimaryButton}" Padding="8,4">
                                    <TextBlock Text="+" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <ListBox Grid.Row="1" x:Name="ItemsListBox" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding Items}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="1" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="DiscardButton" Command="{Binding CloseCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Padding="6,6">
                        <TextBlock TextAlignment="Center">Odbaci događaj<LineBreak/>(Esc)</TextBlock>
                    </Button>
                    <Button Grid.Column="1" x:Name="SaveButton" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0" Padding="6,6">
                        <TextBlock TextAlignment="Center">Sačuvaj događaj<LineBreak/>(Enter)</TextBlock>
                    </Button>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,2,0,0" Padding="5,2,5,2" Background="{StaticResource AccentBrush}" Height="24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Promeni polje za unos - Tab" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,0,200,0"/>
                    <TextBlock Text="Dodaj stavku - Space" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
