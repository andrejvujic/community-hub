<Window x:Class="CommunityHub.Ui.Views.Citizen.Events.MyEventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moji događaji" Height="480" Width="720" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="SingleBorderWindow"
        Language="sr-Latn-RS">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Button Width="170" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" BorderBrush="Black" BorderThickness="2">
                <TextBlock TextAlignment="Center">Organizuj novi događaj<LineBreak/>(Ctrl + 1)</TextBlock>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Background="Transparent">
        </Grid>
    </Grid>
</Window>
