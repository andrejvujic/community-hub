<Window x:Class="CommunityHub.Ui.Views.Citizen.Events.MyEventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        Height="550" Width="750" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Language="sr-Latn-RS">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding OrganizeEventCommand}" />
        <KeyBinding Key="NumPad1" Modifiers="Ctrl" Command="{Binding OrganizeEventCommand}" />
        <KeyBinding Key="Return" Command="{Binding OpenMarkVolunteersCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:EventStatusToStringConverter x:Key="EventStatusToString" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="15,6,15,6" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,0,0,2" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Moji događaji" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="32" Height="32" Command="{Binding CloseCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Style="{StaticResource PrimaryButton}" Command="{Binding OrganizeEventCommand}" Foreground="{StaticResource TextBrush}" Margin="15,12,15,8" Padding="6,6" HorizontalAlignment="Left" Width="200">
                    <TextBlock FontSize="13" TextAlignment="Center">Organizuj novi događaj<LineBreak/>(Ctrl+1)</TextBlock>
                </Button>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15,0,15,15">
                    <StackPanel>
                        <Border Background="{StaticResource AccentBrush}" Padding="6" Margin="0,8,0,6" CornerRadius="2" BorderBrush="{StaticResource TextBrush}" BorderThickness="1">
                            <TextBlock Text="Događaji koje organizujem:" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OrganizerEvents.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <ListBox x:Name="OrganizerEventsList" ItemsSource="{Binding OrganizerEvents}" SelectedItem="{Binding SelectedOrganizerEvent}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="2" Padding="10" Background="{StaticResource BackgroundBrush}" MinHeight="64">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Viewbox Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                                                <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Fill="{StaticResource TextBrush}"/>
                                            </Viewbox>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding Status, Converter={StaticResource EventStatusToString}}" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding EventStart, StringFormat=d}" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding EventStart, StringFormat=t}" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="{StaticResource AccentBrush}" Padding="6" Margin="0,8,0,6" CornerRadius="2" BorderBrush="{StaticResource TextBrush}" BorderThickness="1">
                            <TextBlock Text="Događaji na kojima volontiram:" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VolunteerEvents.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <ListBox x:Name="VolunteerEventsList" ItemsSource="{Binding VolunteerEvents}" SelectedItem="{Binding SelectedVolunteerEvent}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="2" Padding="10" Background="{StaticResource BackgroundBrush}" MinHeight="64">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Viewbox Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center">
                                                <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Fill="{StaticResource TextBrush}"/>
                                            </Viewbox>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding Status, Converter={StaticResource EventStatusToString}}" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding EventStart, StringFormat=d}" HorizontalAlignment="Right" FontSize="16" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding EventStart, StringFormat=t}" HorizontalAlignment="Right" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,2,0,0" Padding="5,2,5,2" Background="{StaticResource AccentBrush}" Height="24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Označi prisutnost volontera - Enter" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,0,200,0"/>
                    <TextBlock Text="Zatvori - Esc" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
