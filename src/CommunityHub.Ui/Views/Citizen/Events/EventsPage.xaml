<Page x:Class="CommunityHub.Ui.Views.Citizen.Events.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      xmlns:helpers="clr-namespace:CommunityHub.Ui.Helpers"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Language="sr-Latn-RS"
      Title="Događaji">

    <Page.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ApplyToVolunteerCommand}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding PrintReportCommand}" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding MyEventsCommand}" />
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding ShowHelpCommand}" />
    </Page.InputBindings>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:EventStatusToStringConverter x:Key="EventStatusToString" />
            <converters:TooltipVisibilityConverter x:Key="TooltipVisibilityConverter" />
            <helpers:TooltipStateProxy x:Key="TooltipStateProxy" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" Margin="30,15,30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12" Height="34" Width="500" HorizontalAlignment="Left">
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBarStyle}" 
                    ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0"
                    ToolTip="{Binding IsEnabled, Source={StaticResource TooltipStateProxy}, Converter={StaticResource TooltipVisibilityConverter}, ConverterParameter='Pretraga događaja po nazivu'}"/>
                    <Button Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" Cursor="Hand">
                        <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="EventsGrid" Grid.Column="0" AutoGenerateColumns="False" HeadersVisibility="Column" 
                          Style="{StaticResource PrimaryDataGrid}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}" CellStyle="{StaticResource DataGridCellStyle}" IsReadOnly="True" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Naziv događaja" Binding="{Binding Name}" Width="1.2*"/>
                        <DataGridTextColumn Header="Datum" Binding="{Binding EventStart, StringFormat=d}" Width="0.5*"/>
                        <DataGridTextColumn Header="Vreme" Binding="{Binding EventStart, StringFormat=t}" Width="0.5*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource EventStatusToString}}" Width="0.6*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource TextBrush}" BorderThickness="2" Background="{StaticResource AlternatingRowBrush}" Padding="16">
                        <Grid>
                            <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" Visibility="{Binding SelectedEvent, Converter={StaticResource NullToVisibility}}">
                                <TextBlock TextAlignment="Center" FontSize="14" Foreground="#333" TextWrapping="Wrap">
                                    Pritisnite Ctrl+S da pretražite događaje. Izaberite željeni događaj klikom miša ili koristeći strelice gore/dole.

                                    Detalji o izabranom događaju biće prikazani ovde.
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="DetailsPanel" Visibility="{Binding SelectedEvent, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Viewbox Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Fill="Black"/>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedEvent.Name, TargetNullValue=''}" FontSize="22" FontWeight="Bold" />
                                            <TextBlock Text="{Binding SelectedEvent.Status, Converter={StaticResource EventStatusToString}}" FontSize="15" Foreground="#666" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Width="100" HorizontalAlignment="Right" Margin="0,0,24,8">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                            <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                                <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" Fill="#333"/>
                                            </Viewbox>
                                            <TextBlock Text="{Binding SelectedEvent.EventStart, StringFormat=d}" FontSize="15" Foreground="#333" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                            <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                                <Path Data="M12 20c4.418 0 8-3.582 8-8s-3.582-8-8-8-8 3.582-8 8 3.582 8 8 8zm-.5-13h1v5l4.25 2.52-.5.86L11.5 12V7z" Fill="#333"/>
                                            </Viewbox>
                                            <TextBlock Text="{Binding SelectedEvent.EventStart, StringFormat=t}" FontSize="15" Foreground="#333" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                                <TextBlock Text="⏳" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding SelectedEvent.DurationMinutes, StringFormat={}{0} min}" FontSize="15" Foreground="#333" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SelectedEvent.Description, TargetNullValue=''}" TextWrapping="Wrap" MinHeight="80" Margin="0,8,0,12" FontSize="16" />

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,-20,12,0">
                                        <TextBlock Text="Potrebno:" FontWeight="Bold" Margin="0,0,0,4" FontSize="14" />
                                        <ListBox ItemsSource="{Binding SelectedEvent.Items}" MinHeight="275" Style="{StaticResource PrimaryListBox}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel Width="200" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedEvent.MinVolunteers, StringFormat='Volontera potrebno: {0}'}" TextAlignment="Center" FontSize="16" />
                                            <TextBlock Text="{Binding SelectedEvent.RegisteredCount, StringFormat='Prijavljeno volontera: {0}'}" TextAlignment="Center" Margin="0,6,0,0" FontSize="16" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ApplyVolunteerButton" Grid.Column="0" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding ApplyToVolunteerCommand}" IsEnabled="{Binding CanApplyToVolunteer}"
                                ToolTip="{Binding ApplyToVolunteerTooltip}" ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">Prijavi se za volontiranje<LineBreak/>(Ctrl + 1)</TextBlock>
                        </Button>

                        <Button Grid.Column="1" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Margin="4,0,4,0" Command="{Binding PrintReportCommand}"
                        ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0"
                        ToolTip="{Binding IsEnabled, Source={StaticResource TooltipStateProxy}, Converter={StaticResource TooltipVisibilityConverter}, ConverterParameter='Štampanje izveštaja o odabranom događaju'}">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">Štampaj izveštaj<LineBreak/>(Ctrl + 2)</TextBlock>
                        </Button>

                        <Button x:Name="MyEventsButton" Grid.Column="2" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding MyEventsCommand}"
                        ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0"
                        ToolTip="{Binding IsEnabled, Source={StaticResource TooltipStateProxy}, Converter={StaticResource TooltipVisibilityConverter}, ConverterParameter='Pregled vaših organizovanih događaja i volontiranja'}">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">Moji događaji<LineBreak/>(Ctrl + 3)</TextBlock>
                        </Button>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>

        <Border Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}}" Background="Transparent" Padding="40">
            <Grid>
                <TextBlock TextAlignment="Center" FontSize="20" Foreground="#333" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Width="700" Margin="0,0,0,20">
                    Da biste videli događaje u vašem kvartu, morate prvo imati članstvo u kvartu. Možete podneti zahtev za pridruživanje novom kvartu u tabu Kvartovi.
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Page>
