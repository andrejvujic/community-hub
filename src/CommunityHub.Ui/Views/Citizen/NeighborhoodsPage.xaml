<Page x:Class="CommunityHub.Ui.Views.Citizen.NeighborhoodsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Language="sr-Latn-RS"
      Title="Kvartovi">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
    </Page.Resources>

    <Grid Margin="30,15,30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20" Height="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Parametri pretrage (Ctrl+S)" Width="190" Height="34" FontWeight="Bold" Padding="10,0" Background="#F0F0F0" BorderBrush="Gray" BorderThickness="1" Click="SearchButton_Click" HorizontalAlignment="Left"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="NeighborhoodsGrid" Grid.Column="0" AutoGenerateColumns="False" HeadersVisibility="Column" 
                      BorderBrush="Black" BorderThickness="2" RowHeight="30" IsReadOnly="True" SelectionChanged="NeighborhoodsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Naziv kvarta" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="Grad" Binding="{Binding City.Name, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="Država" Binding="{Binding Country.Name, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" Background="#F9F9F9" Padding="16">
                    <Grid>
                        <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center"
                                    Visibility="{Binding SelectedItem, ElementName=NeighborhoodsGrid, Converter={StaticResource NullToVisibility}}">
                            <TextBlock TextAlignment="Center" FontSize="14" Foreground="#333" TextWrapping="Wrap">
                                Pritisnite Ctrl+S da pretražite kvartove. Izaberite željeni kvart klikom miša ili koristeći strelice gore/dole.

                                Detalji o izabranom kvartu biće prikazani ovde.
                            </TextBlock>
                        </StackPanel>

                        <StackPanel x:Name="DetailsPanel"
                                    Visibility="{Binding SelectedItem, ElementName=NeighborhoodsGrid, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding SelectedItem.Name, ElementName=NeighborhoodsGrid, TargetNullValue=''}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock FontSize="14" Foreground="#666" Margin="0,0,0,8">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}, {1}">
                                                <Binding ElementName="NeighborhoodsGrid" Path="SelectedItem.City.Name" TargetNullValue="" />
                                                <Binding ElementName="NeighborhoodsGrid" Path="SelectedItem.Country.Name" TargetNullValue="" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedItem.Description, ElementName=NeighborhoodsGrid, TargetNullValue=''}" FontSize="13" TextWrapping="Wrap" MinHeight="80" Margin="0,0,0,12" />

                                    <TextBlock Text="Ulice:" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ListBox ItemsSource="{Binding SelectedItem.StreetSections, ElementName=NeighborhoodsGrid}" MinHeight="275">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}-{2}">
                                                            <Binding Path="Street.Name" />
                                                            <Binding Path="StartNumber" />
                                                            <Binding Path="EndNumber" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding SelectedItem.Images, ElementName=NeighborhoodsGrid}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Path}" Width="240" Height="140" Margin="0,0,0,12" Stretch="UniformToFill">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,240,140" RadiusX="8" RadiusY="8" />
                                                    </Image.Clip>
                                                </Image>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="RequestAccessButton" Grid.Column="0" Height="44" HorizontalAlignment="Stretch" BorderBrush="Black" BorderThickness="2" Click="RequestAccessButton_Click"
                            Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">Zahtev za pristup kvartu<LineBreak/>(Ctrl + 1)</TextBlock>
                    </Button>

                    <Button x:Name="CoordinatorButton" Grid.Column="0" Height="44" HorizontalAlignment="Stretch" BorderBrush="Black" BorderThickness="2"
                            Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">Koordinator mog kvarta<LineBreak/>(Ctrl + 1)</TextBlock>
                    </Button>
                    <Button Grid.Column="2" Height="44" HorizontalAlignment="Stretch" BorderBrush="Black" BorderThickness="2" Click="MyAccessRequestsButton_Click">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                            Moji zahtevi za pristup<LineBreak/>(Ctrl + 2)
                        </TextBlock>
                    </Button>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Page>
