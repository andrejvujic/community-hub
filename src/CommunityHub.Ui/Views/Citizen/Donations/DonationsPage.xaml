<Page x:Class="CommunityHub.Ui.Views.Citizen.Donations.DonationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
	  xmlns:helpers="clr-namespace:CommunityHub.Ui.Helpers"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Language="sr-Latn-RS"
      Title="Donacije">

    <Page.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ViewExpenseHistoryCommand}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding MakeDonationCommand}" />
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding ShowHelpCommand}" />
    </Page.InputBindings>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
			<converters:TooltipVisibilityConverter x:Key="TooltipVisibilityConverter" />
			<helpers:TooltipStateProxy x:Key="TooltipStateProxy" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" Margin="30,15,30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="34" Margin="0,0,0,12"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="580"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="CategoriesGrid" Grid.Column="0" AutoGenerateColumns="False" HeadersVisibility="Column" 
                          Style="{StaticResource PrimaryDataGrid}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}" CellStyle="{StaticResource DataGridCellStyle}" IsReadOnly="True" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kategorija" Binding="{Binding Category.Name}" Width="1*"/>
                        <DataGridTextColumn Header="Budžet" Binding="{Binding AvailableDisplay}" Width="0.8*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource TextBrush}" BorderThickness="2" Background="{StaticResource AlternatingRowBrush}" Padding="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock TextAlignment="Center" FontSize="20" Foreground="#333" TextWrapping="Wrap">
                                Ako želite, možete dati doprinos svojem kvartu tako što ostavite donaciju za kategoriju po svojem izboru.<LineBreak/>
                            </TextBlock>
                            <TextBlock TextAlignment="Center" FontSize="20" Foreground="#333" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding NeighborhoodBudgetTotal, StringFormat='Kvart trenutno ima budžet od {0:N2} RSD raspoređen kroz sve kategorije'}"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Height="Auto" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding ViewExpenseHistoryCommand}"
						ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0"
                        ToolTip="{Binding IsEnabled, Source={StaticResource TooltipStateProxy}, Converter={StaticResource TooltipVisibilityConverter}, ConverterParameter='Pregled istorije svih troškova za izabranu kategoriju'}">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">Istorija troškova kategorije<LineBreak/>(Ctrl + 1)</TextBlock>
                        </Button>
                        <Button Grid.Column="1" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding MakeDonationCommand}"
						ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0"
                        ToolTip="{Binding IsEnabled, Source={StaticResource TooltipStateProxy}, Converter={StaticResource TooltipVisibilityConverter}, ConverterParameter='Ostavi donaciju za izabranu kategoriju'}">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">Ostavi donaciju za kategoriju<LineBreak/>(Ctrl + 2)</TextBlock>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}}" Background="Transparent" Padding="40">
            <Grid>
                <TextBlock TextAlignment="Center" FontSize="20" Foreground="#333" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Width="700" Margin="0,0,0,20">
                    Da biste videli budžete i donirali sredstva za svoj kvart, morate prvo imati članstvo u kvartu. Možete podneti zahtev za pridruživanje novom kvartu u tabu Kvartovi.
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Page>
