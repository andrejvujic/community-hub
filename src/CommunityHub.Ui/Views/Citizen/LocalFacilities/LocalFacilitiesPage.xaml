<Page x:Class="CommunityHub.Ui.Views.Citizen.LocalFacilities.LocalFacilitiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      xmlns:helpers="clr-namespace:CommunityHub.Ui.Helpers"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Language="sr-Latn-RS"
      Title="Lokalni objekti">

    <Page.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ViewHistoryCommand}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding ViewStatisticsCommand}" />
        <KeyBinding Key="Space" Command="{Binding ToggleVoteCommand}" />
    </Page.InputBindings>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
            <converters:BooleanToCheckmarkConverter x:Key="BooleanToCheckmark" />
            <converters:TooltipVisibilityConverter x:Key="TooltipVisibilityConverter" />
            <helpers:TooltipStateProxy x:Key="TooltipStateProxy" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Border Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}}" Background="Transparent" Padding="40">
            <Grid>
                <TextBlock TextAlignment="Center" FontSize="20" Foreground="#333" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Width="700" Margin="0,0,0,20">
                    Da biste videli lokalne objekte u vašem kvartu, morate prvo imati članstvo u kvartu. Možete podneti zahtev za pridruživanje novom kvartu u tabu Kvartovi.
                </TextBlock>
            </Grid>
        </Border>

        <Grid Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" Margin="30,15,30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5.5*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="3.5*"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="FacilitiesGrid" Grid.Column="0"
                      ItemsSource="{Binding Facilities}"
                      SelectedItem="{Binding SelectedFacility}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      Style="{StaticResource PrimaryDataGrid}"
                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Naziv objekta" Binding="{Binding Name, Mode=OneWay}" Width="1.1*" />
                        <DataGridTextColumn Header="Poslednja poseta" Binding="{Binding LastVisitDateDisplay, Mode=OneWay}" Width="1*" />
                        <DataGridTextColumn Header="Ukupno glasova" Binding="{Binding VoteCount, Mode=OneWay}" Width="0.7*" />
                        <DataGridTextColumn Header="Ima moj glas" Binding="{Binding VotedByMe, Converter={StaticResource BooleanToCheckmark}, Mode=OneWay}" Width="0.6*" CellStyle="{StaticResource CenteredDataGridCellStyle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource TextBrush}" BorderThickness="2" Background="{StaticResource AlternatingRowBrush}" Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Visibility="{Binding SelectedFacility, Converter={StaticResource NullToVisibility}}">
                                <TextBlock TextAlignment="Center" FontSize="20" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                    Odaberite objekat da biste videli detaljne informacije.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedFacility, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                                <StackPanel Visibility="{Binding SelectedFacility.VotedByMe, Converter={StaticResource InverseBooleanToVisibility}}">
                                    <TextBlock TextAlignment="Center" FontSize="20" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12">
                                        Niste još glasali za posetu ovog objekta. Ako glasate, kasnije možete ukloniti svoj glas. Imate pravo da date glas za više objekata. <LineBreak/>
                                    </TextBlock>
                                    <Button Height="52" Width="200" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Padding="16,0,16,0" Command="{Binding ToggleVoteCommand}"
                                    ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0"
                                    ToolTip="{Binding IsEnabled, Source={StaticResource TooltipStateProxy}, Converter={StaticResource TooltipVisibilityConverter}, ConverterParameter='Glasajte za posetu odabranog objekta'}">
                                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12">
                                            Dodaj glas<LineBreak/>(Space)
                                        </TextBlock>
                                    </Button>
                                </StackPanel>

                                <StackPanel Visibility="{Binding SelectedFacility.VotedByMe, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock TextAlignment="Center" FontSize="20" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12">
                                        Već ste glasali za posetu ovog objekta. Ako želite, možete ukloniti svoj glas. Imate pravo da date glas za više objekata. <LineBreak/>
                                    </TextBlock>
                                    <Button Height="52" Width="200" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Padding="16,0,16,0" Command="{Binding ToggleVoteCommand}"
                                    ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0"
                                    ToolTip="{Binding IsEnabled, Source={StaticResource TooltipStateProxy}, Converter={StaticResource TooltipVisibilityConverter}, ConverterParameter='Uklonite glas za posetu odabranog objekta'}">
                                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12">
                                            Ukloni glas<LineBreak/>(Space)
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Command="{Binding ViewHistoryCommand}"
                        ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0"
                        ToolTip="{Binding IsEnabled, Source={StaticResource TooltipStateProxy}, Converter={StaticResource TooltipVisibilityConverter}, ConverterParameter='Pregled datuma svih poseta izabranog objekta'}">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">
                                Istorija poseta objekta<LineBreak/>(Ctrl + 1)
                            </TextBlock>
                        </Button>

                        <Button Grid.Column="2" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Command="{Binding ViewStatisticsCommand}"
                        ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0"
                        ToolTip="{Binding IsEnabled, Source={StaticResource TooltipStateProxy}, Converter={StaticResource TooltipVisibilityConverter}, ConverterParameter='Mesečna i godišnja statistika rezervacija objekata u vašem kvartu'}">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">
                                Statistika rezervacija<LineBreak/>(Ctrl + 2)
                            </TextBlock>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
