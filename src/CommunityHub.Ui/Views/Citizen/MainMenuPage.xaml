<Page x:Class="CommunityHub.Ui.Views.Citizen.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Language="sr-Latn-RS"
      Title="Glavni Meni">

    <Page.InputBindings>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding WizardHelperCommand}" />
    </Page.InputBindings>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="40,20,40,40">
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="Dobro došli nazad!" FontSize="60" Margin="0,50,0,40" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>

            <TextBlock FontSize="28" Margin="0,0,0,5" Foreground="{StaticResource TextBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Korisnik: {0} {1}">
                        <Binding Path="CurrentUser.Name" TargetNullValue="N/A" FallbackValue="N/A" />
                        <Binding Path="CurrentUser.Surname" TargetNullValue="" FallbackValue="" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock FontSize="28" Margin="0,0,0,5" Foreground="{StaticResource TextBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Adresa: {0} {1}">
                        <Binding Path="CurrentUser.Address.Street.Name" TargetNullValue="N/A" FallbackValue="N/A" />
                        <Binding Path="CurrentUser.Address.StreetNumber" TargetNullValue="" FallbackValue="" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentUser.Membership}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding CurrentUser.Membership.Neighborhood.Name, StringFormat='Kvart: \{0\}'}" FontSize="28" Margin="0,0,0,5" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding CurrentUser.Membership.AcceptanceDate, StringFormat='Član od \{0:d.M.yyyy.\}'}" FontSize="28" Margin="0,0,0,5" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
            <TextBlock Text="Nema registrovanih članstava u kvartovima" FontSize="28" Foreground="{StaticResource TextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentUser.Membership}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,120,0" BorderBrush="{StaticResource TextBrush}" BorderThickness="3" Background="{StaticResource AlternatingRowBrush}" Padding="30">
            <StackPanel Width="280" VerticalAlignment="Center">
                <TextBlock Text="Ponovo pokreni čarobnjaka&#10;za pomoć&#10;(Ctrl + W)" TextAlignment="Center" FontSize="20" Margin="0,0,0,20" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                <Button Content="Čarobnjak za pomoć" Style="{StaticResource LargeButton}" Command="{Binding WizardHelperCommand}" />
            </StackPanel>
        </Border>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding CurrentDate}" FontSize="22" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="{Binding CurrentTime}" FontSize="22" Foreground="{StaticResource TextBrush}"/>
        </StackPanel>
    </Grid>
</Page>
