<Window x:Class="CommunityHub.Ui.Views.Citizen.SelectCountryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izaberite državu" Height="420" Width="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="SearchTextBox" Width="220" Height="26" VerticalContentAlignment="Center"/>
            <Button Content="Pretraži" Width="80" Height="26" Margin="8,0,0,0" Click="SearchButton_Click"/>
        </StackPanel>

        <ListBox x:Name="CountriesList" Grid.Row="2" DisplayMemberPath="Name" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Potvrdi" Width="100" Margin="0,0,8,0" Click="Confirm_Click"/>
            <Button Content="Otkaži" Width="100" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
