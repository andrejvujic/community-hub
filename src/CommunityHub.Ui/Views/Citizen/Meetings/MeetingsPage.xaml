<Page x:Class="CommunityHub.Ui.Views.Citizen.Meetings.MeetingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Language="sr-Latn-RS"
      Title="Sastanci">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:MeetingStatusToStringConverter x:Key="MeetingStatusToString" />
            <converters:MeetingThemeToStringConverter x:Key="MeetingThemeToString" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Border Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}}" Background="{StaticResource AlternatingRowBrush}" Padding="40" BorderBrush="{StaticResource TextBrush}" BorderThickness="2">
            <TextBlock TextAlignment="Center" FontSize="20" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Width="700" Margin="0,0,0,20">
                Da biste videli sastanke u vašem kvartu, morate prvo imati članstvo u kvartu. Možete podneti zahtev za pridruživanje novom kvartu u tabu Kvartovi.
            </TextBlock>
        </Border>

        <Grid Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" Margin="30,15,30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="MeetingsGrid" Grid.Column="0"
                      ItemsSource="{Binding Meetings}"
                      SelectedItem="{Binding SelectedMeeting}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      Style="{StaticResource PrimaryDataGrid}"
                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tema" Binding="{Binding Theme, Converter={StaticResource MeetingThemeToString}}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource MeetingStatusToString}}" Width="*" />
                        <DataGridTextColumn Header="Datum/Opseg" Binding="{Binding DisplayDate}" Width="*" />
                        <DataGridTextColumn Header="Vreme" Binding="{Binding MeetingTimeDisplay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource TextBrush}" BorderThickness="2" Background="{StaticResource AlternatingRowBrush}" Padding="16">
                        <StackPanel VerticalAlignment="Center">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding SelectedItem, ElementName=MeetingsGrid, Converter={StaticResource NullToVisibility}}">
                                <TextBlock TextAlignment="Center" FontSize="20" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                    Odaberite sastanak da biste počeli.
                                </TextBlock>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center" Visibility="{Binding SelectedItem, ElementName=MeetingsGrid, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                                <TextBlock TextAlignment="Center" FontSize="20" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.Status, ElementName=MeetingsGrid}" Value="Cancelled">
                                                    <Setter Property="Text" Value="Ovaj sastanak je otkazan." />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding SelectedItem.Status, ElementName=MeetingsGrid}" Value="Scheduled">
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="Ovaj sastanak će se održati {0}">
                                                                <Binding Path="SelectedItem.DisplayDate" ElementName="MeetingsGrid" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedItem.Status, ElementName=MeetingsGrid}" Value="InPreparation" />
                                                        <Condition Binding="{Binding HasVoted}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text" Value="Još uvek niste glasali za vreme ovog sastanka. Možete glasati do 24h pre sastanka." />
                                                </MultiDataTrigger>

                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedItem.Status, ElementName=MeetingsGrid}" Value="InPreparation" />
                                                        <Condition Binding="{Binding HasVoted}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="Glasali ste da ovaj sastanak bude održan {0:dd.MM.yyyy.} Možete promeniti svoj glas do 24h pre sastanka.">
                                                                <Binding Path="CurrentVote.VotedDate" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="1" Height="56" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="VoteButton_Click">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">
                            Glasaj za vreme sastanka<LineBreak/>(Ctrl + 1)
                        </TextBlock>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>