<Page x:Class="CommunityHub.Ui.Views.Citizen.Meetings.MeetingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Language="sr-Latn-RS"
      Title="Sastanci">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
    </Page.Resources>

    <Grid>
        <Border Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}}" Background="Transparent" Padding="40">
            <TextBlock TextAlignment="Center" FontSize="20" Foreground="#333" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Width="700" Margin="0,0,0,20">
                Da biste videli sastanke u vašem kvartu, morate prvo imati članstvo u kvartu. Možete podneti zahtev za pridruživanje novom kvartu u tabu Kvartovi.
            </TextBlock>
        </Border>

        <Grid Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" Margin="30,15,30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="MeetingsGrid" Grid.Column="0"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      BorderBrush="Black"
                      BorderThickness="2"
                      RowHeight="30"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Margin="0,0,0,0">
                </DataGrid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" Background="#F9F9F9" Padding="16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock TextAlignment="Center" FontSize="14" Foreground="#333" TextWrapping="Wrap">
                                Odaberite sastanak da biste počeli.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="1" Height="44" HorizontalAlignment="Stretch" BorderBrush="Black" BorderThickness="2" Margin="25,12,25,0">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                            Glasaj za vreme sastanka<LineBreak/>(Ctrl + 1)
                        </TextBlock>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>