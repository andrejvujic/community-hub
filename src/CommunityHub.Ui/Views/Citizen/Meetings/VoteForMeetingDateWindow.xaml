<Window x:Class="CommunityHub.Ui.Views.Citizen.Meetings.VoteForMeetingDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        Height="375" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Language="sr-Latn-RS">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:MeetingThemeToStringConverter x:Key="MeetingThemeToString" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="15,6,15,6" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,0,0,2" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Glasaj za vreme sastanka" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="32" Height="32" Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,10,0,20">
                    <TextBlock FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" Text="{Binding Meeting.Theme, Converter={StaticResource MeetingThemeToString}, StringFormat='Tema: {0}'}" />
                    <TextBlock FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" Text="{Binding Meeting.DisplayDate, StringFormat='Opseg datuma: {0}'}" />
                    <TextBlock FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" Text="{Binding Meeting.MeetingTime, StringFormat='Vreme: {0}'}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Glasam za:" FontSize="14" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Grid Width="150">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="VoteDateTextBox" 
                                 Grid.Column="0"
                                 Background="{StaticResource BackgroundBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource TextBrush}"
                                 BorderThickness="2,2,0,2"
                                 Padding="8,6"
                                 FontSize="13"
                                 Height="32"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{StaticResource TextBrush}"
                                 Text="{Binding SelectedDate, StringFormat='d', UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="VoteDateTextBox_TextChanged"/>
                        <Button x:Name="CalendarButton" 
                                Grid.Column="1"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{StaticResource TextBrush}"
                                BorderThickness="2"
                                Padding="6"
                                Width="32"
                                Height="32"
                                Command="{Binding ToggleCalendarCommand}"
                                Content="▼"
                                FontSize="10"
                                Foreground="{StaticResource TextBrush}"/>
                        <Popup x:Name="CalendarPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=CalendarButton}" AllowsTransparency="True" PopupAnimation="Slide">
                            <Calendar x:Name="VoteCalendar" 
                                      Background="{StaticResource BackgroundBrush}"
                                      Foreground="{StaticResource TextBrush}"
                                      BorderBrush="{StaticResource TextBrush}"
                                      BorderThickness="2"
                                      SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                      DisplayDateStart="{Binding DisplayDateStart, Mode=OneWay}"
                                      DisplayDateEnd="{Binding DisplayDateEnd, Mode=OneWay}"
                                      SelectedDatesChanged="VoteCalendar_SelectedDatesChanged"/>
                        </Popup>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton" Grid.Column="0" Height="44" Style="{StaticResource PrimaryButton}" IsCancel="True" Command="{Binding CancelCommand}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">Otkaži glas<LineBreak/>(Esc)</TextBlock>
                    </Button>
                    <Button x:Name="ConfirmButton" Grid.Column="2" Height="44" Style="{StaticResource PrimaryButton}" IsDefault="True" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">Potvrdi glas<LineBreak/>(Enter)</TextBlock>
                    </Button>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,2,0,0" Padding="5,2,5,2" Background="{StaticResource AccentBrush}" Height="24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
