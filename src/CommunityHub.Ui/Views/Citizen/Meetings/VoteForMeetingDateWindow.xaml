<Window x:Class="CommunityHub.Ui.Views.Citizen.Meetings.VoteForMeetingDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glasaj za vreme sastanka" Height="300" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Language="sr-Latn-RS">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,10,0,20">
            <TextBlock x:Name="TopicTextBlock" Text="Tema: " FontSize="16" Margin="0,0,0,5"/>
            <TextBlock x:Name="DateRangeTextBlock" Text="Opseg datuma: " FontSize="16" Margin="0,0,0,5"/>
            <TextBlock x:Name="TimeTextBlock" Text="Vreme: " FontSize="16" Margin="0,0,0,5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Glasam za:" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <DatePicker x:Name="VoteDatePicker" Width="150" VerticalAlignment="Center" FontSize="14" Height="28"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton" Grid.Column="0" Height="44" Background="#F0F0F0" BorderBrush="Black" BorderThickness="2" IsCancel="True" Click="CancelButton_Click">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Otkaži glas<LineBreak/>(Esc)</TextBlock>
            </Button>
            <Button x:Name="ConfirmButton" Grid.Column="2" Height="44" Background="#F0F0F0" BorderBrush="Black" BorderThickness="2" IsDefault="True" Click="ConfirmButton_Click">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Potvrdi glas<LineBreak/>(Enter)</TextBlock>
            </Button>
        </Grid>
    </Grid>
</Window>
