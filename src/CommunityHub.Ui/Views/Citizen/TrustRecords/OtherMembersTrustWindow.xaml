<Window x:Class="CommunityHub.Ui.Views.Citizen.TrustRecords.OtherMembersTrustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        Height="480" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:TrustStatusToStringConverter x:Key="TrustStatusToStringConverter" />
            <converters:TrustStatusToIconConverter x:Key="TrustStatusToIconConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="15,6,15,6" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,0,0,2" MouseDown="Header_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Evidencije poverenja ostalih članova kvarta" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Width="32" Height="32" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="15">
            <DataGrid x:Name="TrustRecordsGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  Style="{StaticResource PrimaryDataGrid}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}" CellStyle="{StaticResource DataGridCellStyle}"
                  IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,4" ItemsSource="{Binding TrustRecords}">

            <DataGrid.Resources>
                <Style x:Key="CenterAligned" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="5,0,5,0"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Ime i prezime" Width="1*">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="Citizen.Name" />
                            <Binding Path="Citizen.Surname" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Organizovani događaji" Width="1.1*" Binding="{Binding Organized}" ElementStyle="{StaticResource CenterAligned}"/>
                <DataGridTextColumn Header="Broj volontiranja" Width="0.9*" Binding="{Binding Volunteered}" ElementStyle="{StaticResource CenterAligned}"/>
                <DataGridTextColumn Header="Datum pridruživanja" Width="1.1*" Binding="{Binding Citizen.Membership.AcceptanceDate, StringFormat=d}" ElementStyle="{StaticResource CenterAligned}"/>
                <DataGridTextColumn Header="Status" Width="1*" Binding="{Binding TrustStatus, Converter={StaticResource TrustStatusToStringConverter}}" ElementStyle="{StaticResource CenterAligned}"/>

                <DataGridTemplateColumn Header="Nivo" Width="0.5*" CellStyle="{StaticResource CenteredDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding TrustStatus, Converter={StaticResource TrustStatusToIconConverter}}"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="18" Margin="1,0,1,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="★"/>
                                                        <Setter Property="Foreground" Value="Gold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StarType}" Value="Empty">
                                                                <Setter Property="Text" Value="☆"/>
                                                                <Setter Property="Foreground" Value="Gray"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StarType}" Value="Black">
                                                                <Setter Property="Text" Value="★"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Grid>
        </Grid>
    </Border>
</Window>
