<Window x:Class="CommunityHub.Ui.Views.Citizen.TrustRecords.OtherMembersTrustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        Title="Evidencije poverenja ostalih članova kvarta" Height="480" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <converters:TrustStatusToStringConverter x:Key="TrustStatusToStringConverter" />
        <converters:TrustStatusToIconConverter x:Key="TrustStatusToIconConverter" />
    </Window.Resources>
    <Grid Margin="15">
        <DataGrid x:Name="TrustRecordsGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,4" ItemsSource="{Binding TrustRecords}">

            <DataGrid.Resources>
                <Style x:Key="CenterAligned" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="5,0,5,0"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Ime i prezime" Width="1.2*">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="Citizen.Name" />
                            <Binding Path="Citizen.Surname" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Organizovani događaji" Width="1.1*" Binding="{Binding Organized}" ElementStyle="{StaticResource CenterAligned}"/>
                <DataGridTextColumn Header="Broj volontiranja" Width="1*" Binding="{Binding Volunteered}" ElementStyle="{StaticResource CenterAligned}"/>
                <DataGridTextColumn Header="Datum pridruživanja" Width="1.1*" Binding="{Binding Citizen.Membership.AcceptanceDate, StringFormat=d}" ElementStyle="{StaticResource CenterAligned}"/>
                <DataGridTextColumn Header="Status" Width="1.2*" Binding="{Binding TrustStatus, Converter={StaticResource TrustStatusToStringConverter}}" ElementStyle="{StaticResource CenterAligned}"/>

                <DataGridTemplateColumn Header="Nivo" Width="0.7*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding TrustStatus, Converter={StaticResource TrustStatusToIconConverter}}"
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="18" Margin="1,0,1,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="★"/>
                                                    <Setter Property="Foreground" Value="Gold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StarType}" Value="Empty">
                                                            <Setter Property="Text" Value="☆"/>
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StarType}" Value="Black">
                                                            <Setter Property="Text" Value="★"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
