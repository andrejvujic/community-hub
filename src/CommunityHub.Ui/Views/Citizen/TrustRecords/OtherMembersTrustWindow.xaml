<Window x:Class="CommunityHub.Ui.Views.Citizen.TrustRecords.OtherMembersTrustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidencije poverenja ostalih članova kvarta" Height="480" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <DataGrid x:Name="TrustRecordsGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ime i prezime" Width="1.2*"/>
                <DataGridTextColumn Header="Organizovani događaji" Width="1.2*"/>
                <DataGridTextColumn Header="Broj volontiranja" Width="1.1*"/>
                <DataGridTextColumn Header="Datum pridruživanja" Width="1.2*"/>
                <DataGridTextColumn Header="Status" Width="1*"/>
                <DataGridTextColumn Header="Nivo" Width="1.2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
