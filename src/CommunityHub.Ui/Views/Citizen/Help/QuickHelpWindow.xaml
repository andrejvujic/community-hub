<Window x:Class="CommunityHub.Ui.Views.Citizen.Help.QuickHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" 
        d:DesignHeight="500" d:DesignWidth="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Height="500" Width="400">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" 
            BorderBrush="{StaticResource TextBrush}" 
            BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="{StaticResource AccentBrush}" 
                    Padding="15,6" 
                    BorderBrush="{StaticResource TextBrush}" 
                    BorderThickness="0,0,0,2"
                    MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="{Binding PageName}" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextBrush}" 
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" 
                            Width="32" Height="32" 
                            Command="{Binding CloseCommand}" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Padding="0" 
                            Cursor="Hand">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" 
                              Fill="{StaticResource TextBrush}" 
                              Stretch="Uniform" 
                              Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Description}" 
                                   FontSize="14" 
                                   Foreground="{StaticResource TextBrush}" 
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,20"/>

                        <Border BorderBrush="{StaticResource TextBrush}" 
                                BorderThickness="0,1,0,0" 
                                Padding="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="Prečice sa tastature:" 
                                           FontWeight="Bold" 
                                           FontSize="15" 
                                           Foreground="{StaticResource TextBrush}" 
                                           Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding Shortcuts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" 
                                                        Background="{StaticResource AccentBrush}" 
                                                        CornerRadius="4" 
                                                        Padding="4,2" 
                                                        HorizontalAlignment="Left"
                                                        Width="60">
                                                    <TextBlock Text="{Binding Keys}" 
                                                               FontWeight="Bold" 
                                                               FontSize="14" 
                                                               Foreground="{StaticResource TextBrush}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Description}" 
                                                           FontSize="14" 
                                                           Foreground="{StaticResource TextBrush}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="6,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" 
                    BorderBrush="{StaticResource TextBrush}" 
                    BorderThickness="0,2,0,0" 
                    Padding="5,2" 
                    Background="{StaticResource AccentBrush}" 
                    Height="24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Esc - Zatvori" 
                               VerticalAlignment="Center" 
                               FontSize="13" 
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>