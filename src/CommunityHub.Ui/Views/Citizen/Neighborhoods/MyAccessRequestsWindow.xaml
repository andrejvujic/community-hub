<Window x:Class="CommunityHub.Ui.Views.Citizen.Neighborhoods.MyAccessRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        xmlns:domain="clr-namespace:CommunityHub.Application.Domain;assembly=CommunityHub.Application"
        Title="Moji zahtevi za pristup" Height="560" Width="720" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="SingleBorderWindow"
        Language="sr-Latn-RS">

    <Window.Resources>
        <conv:StatusToStringConverter x:Key="StatusToStringConverter" />
        <conv:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="0,10,0,10" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">Sortiraj po (Ctrl + 1):</TextBlock>
                <RadioButton x:Name="NewestToggle" Content="Najnovije" IsChecked="True" GroupName="SortGroup" Width="96" Margin="0,0,6,0" Checked="Toggle_Changed">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bd" CornerRadius="6" BorderBrush="Black" BorderThickness="1" Background="White" Padding="6,4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3388FF" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F0F8FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>

                <RadioButton x:Name="OldestToggle" Content="Najstarije" GroupName="SortGroup" Width="96" Checked="Toggle_Changed">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bd" CornerRadius="6" BorderBrush="Black" BorderThickness="1" Background="White" Padding="6,4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3388FF" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F0F8FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">Filtriraj po statusu (Ctrl + 2):</TextBlock>
                <CheckBox x:Name="GroupByStatusToggle" VerticalAlignment="Center" IsChecked="False" Cursor="Hand" Checked="Toggle_Changed" Unchecked="Toggle_Changed">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="Track" Width="50" Height="26" CornerRadius="13" BorderBrush="Black" BorderThickness="2" Background="White">
                                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" Stroke="Black" StrokeThickness="2" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Track" Property="Background" Value="#3388FF"/>
                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="2" x:Name="RequestsList" ItemsSource="{Binding Requests}" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#F3F6FA" Padding="6" Margin="0,0,0,6" CornerRadius="4">
                                <TextBlock Text="{Binding Name, Converter={StaticResource StatusToStringConverter}}" FontWeight="Bold" />
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8" Background="White" HorizontalAlignment="Stretch" MinHeight="80">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Width="36" Height="36">
                                <Path Data="M246.125,195.063v-82.688h-63v82.688h-7.875V17.823h-23.625V2.125h-47.25v15.698H80.75v177.24h-7.875V80.875h-63v114.188H2v11.813h252v-11.813H246.125z
                                      M47.281,177.344H35.469v-11.813h11.813V177.344z M47.281,145.844H35.469v-11.813h11.813V145.844zM47.281,114.344H35.469v-11.813h11.813V114.344z
                                      M119.141,174.391h-11.813v-11.813h11.813V174.391z M119.141,142.891h-11.813 v-11.813h11.813V142.891z M119.141,111.391h-11.813V99.578h11.813V111.391z M119.141,
                                      79.891h-11.813V68.078h11.813V79.891zM150.641,174.391h-11.813v-11.813h11.813V174.391z M150.641,142.891h-11.813v-11.813h11.813V142.891z M150.641,111.391h-11.813 V99.578h11.813V111.391z
                                      M150.641,79.891h-11.813V68.078h11.813V79.891z M220.531,177.344h-11.813v-11.813h11.813V177.344z M220.531,145.844h-11.813v-11.813h11.813V145.844z" Fill="Black"/>
                            </Viewbox>

                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Neighborhood.Name}" FontWeight="Bold" FontSize="14" />
                                    <TextBlock FontSize="12" Foreground="#666">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}, {1}">
                                                <Binding Path="Neighborhood.City.Name" TargetNullValue="" />
                                                <Binding Path="Neighborhood.Country.Name" TargetNullValue="" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Comment}" FontSize="12" Foreground="#444" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="2" Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToStringConverter}, StringFormat='Status: {0}', TargetNullValue='', FallbackValue=''}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CreationDate, StringFormat='Datum: {0:d}', TargetNullValue=''}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <Button Grid.Row="1" Width="36" Height="36" Margin="0,8,0,0" HorizontalAlignment="Right" Click="DeleteRequest_Click"
                                        Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}}" ToolTip="Brisanje zahteva">
                                    <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
