<Window x:Class="CommunityHub.Ui.Views.Citizen.Neighborhoods.CoordinatorReviews.WriteNewReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        xmlns:helpers="clr-namespace:CommunityHub.Ui.Helpers"
        Height="470" Width="600" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:RatingToStarsConverter x:Key="RatingToStars" />
            <converters:RatingToIsStarFilledConverter x:Key="RatingToIsStarFilled" />
			<converters:TooltipVisibilityConverter x:Key="TooltipVisibilityConverter" />
			<helpers:TooltipStateProxy x:Key="TooltipStateProxy" />

            <Style x:Key="StarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="15,6,15,6" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,0,0,2" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Napišite novu recenziju" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="32" Height="32" Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock FontSize="16" Foreground="{StaticResource TextBrush}" Text="Kvart: " />
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="{Binding NeighborhoodName}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock FontSize="16" Foreground="{StaticResource TextBrush}" Text="Koordinator: " />
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="{Binding CoordinatorName}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock FontSize="16" Foreground="{StaticResource TextBrush}" Text="Datum: " />
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="{Binding ReviewDate}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ocena (1-5):" FontSize="16" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="RatingTextBox" Width="50" Height="32" Padding="8,4" FontSize="16" Foreground="{StaticResource TextBrush}" Background="{StaticResource BackgroundBrush}" 
                                 BorderBrush="{StaticResource TextBrush}" BorderThickness="2" TextAlignment="Center" Text="{Binding RatingText, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" MaxLength="1" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,32,0">
                            <Button Command="{Binding SetRatingCommand}" CommandParameter="1" Style="{StaticResource StarButtonStyle}" Margin="0,0,6,0">
                                <TextBlock Text="★" FontSize="32">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Setters>
                                                <Setter Property="Foreground" Value="#000000" />
                                            </Style.Setters>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rating, Converter={StaticResource RatingToIsStarFilled}, ConverterParameter=1}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFD700" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding SetRatingCommand}" CommandParameter="2" Style="{StaticResource StarButtonStyle}" Margin="0,0,6,0">
                                <TextBlock Text="★" FontSize="32">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Setters>
                                                <Setter Property="Foreground" Value="#000000" />
                                            </Style.Setters>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rating, Converter={StaticResource RatingToIsStarFilled}, ConverterParameter=2}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFD700" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding SetRatingCommand}" CommandParameter="3" Style="{StaticResource StarButtonStyle}" Margin="0,0,6,0">
                                <TextBlock Text="★" FontSize="32">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Setters>
                                                <Setter Property="Foreground" Value="#000000" />
                                            </Style.Setters>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rating, Converter={StaticResource RatingToIsStarFilled}, ConverterParameter=3}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFD700" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding SetRatingCommand}" CommandParameter="4" Style="{StaticResource StarButtonStyle}" Margin="0,0,6,0">
                                <TextBlock Text="★" FontSize="32">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Setters>
                                                <Setter Property="Foreground" Value="#000000" />
                                            </Style.Setters>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rating, Converter={StaticResource RatingToIsStarFilled}, ConverterParameter=4}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFD700" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding SetRatingCommand}" CommandParameter="5" Style="{StaticResource StarButtonStyle}" Margin="0,0,0,0">
                                <TextBlock Text="★" FontSize="32">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Setters>
                                                <Setter Property="Foreground" Value="#000000" />
                                            </Style.Setters>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rating, Converter={StaticResource RatingToIsStarFilled}, ConverterParameter=5}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFD700" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding CommentLabel}" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                    <TextBox Grid.Row="1" MinHeight="100" MaxHeight="150" Padding="8,6" FontSize="12" Foreground="{StaticResource TextBrush}" Background="{StaticResource BackgroundBrush}" 
                             BorderBrush="{StaticResource TextBrush}" BorderThickness="2" TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Grid.Row="3" Margin="0,0,0,20" FontSize="14" Foreground="{StaticResource TextBrush}" Opacity="0.8" TextWrapping="Wrap">
                    <Run Text="Napomena: Recenzije se ne mogu pisati više od jednom mesečno" />
                </TextBlock>

                <Grid Grid.Row="4" />

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Height="44" Command="{Binding CancelCommand}" Style="{StaticResource PrimaryButton}" Padding="0">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center">Otkaži<LineBreak/>(Esc)</TextBlock>
                    </Button>
                    <Button Grid.Column="2" Height="44" Command="{Binding ConfirmCommand}" Padding="0" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsValid}"
				        ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ConfirmTooltip}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center">Potvrdi<LineBreak/>(Enter)</TextBlock>
                    </Button>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,2,0,0" Padding="5,2,5,2" Background="{StaticResource AccentBrush}" Height="24">
            </Border>
        </Grid>
    </Border>
</Window>
