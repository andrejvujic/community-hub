<Window x:Class="CommunityHub.Ui.Views.Citizen.Neighborhoods.CoordinatorReviews.MyNeighborhoodCoordinatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
        xmlns:helpers="clr-namespace:CommunityHub.Ui.Helpers"
        Height="600" Width="900" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Language="sr-Latn-RS">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ReportSelectedReviewCommand}" />
        <KeyBinding Key="NumPad1" Modifiers="Ctrl" Command="{Binding ReportSelectedReviewCommand}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding WriteNewReviewCommand}" />
        <KeyBinding Key="NumPad2" Modifiers="Ctrl" Command="{Binding WriteNewReviewCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:RatingToStarsConverter x:Key="RatingToStarsConverter" />
            <converters:TooltipVisibilityConverter x:Key="TooltipVisibilityConverter" />
            <helpers:TooltipStateProxy x:Key="TooltipStateProxy" />
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="15,6,15,6" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,0,0,2" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Koordinator mog kvarta" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="32" Height="32" Command="{Binding CloseCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Vertical">
                    <TextBlock Margin="0,0,0,4" FontSize="18" Foreground="{StaticResource TextBrush}">
                        <Run Text="Kvart: " />
                        <Run Text="{Binding SelectedNeighborhoodName, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock FontSize="18" Foreground="{StaticResource TextBrush}">
                        <Run Text="Koordinator: " />
                        <Run Text="{Binding CoordinatorName, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="0,18,0,0" Text="Recenzije:" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />

                <DataGrid Grid.Row="3" 
                          AutoGenerateColumns="False" 
                          HeadersVisibility="Column"
                          Style="{StaticResource PrimaryDataGrid}" 
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" 
                          RowStyle="{StaticResource DataGridRowStyle}" 
                          CellStyle="{StaticResource DataGridCellStyle}" 
                          IsReadOnly="True"
                          ItemsSource="{Binding Reviews}" 
                          SelectedItem="{Binding SelectedReview}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Recenzent" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Reviewer.Name" />
                                                <Binding Path="Reviewer.Surname" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ocena" Width="0.6*" CellStyle="{StaticResource CenteredDataGridCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Rating, Converter={StaticResource RatingToStarsConverter}}"
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="★" FontSize="18" Margin="1,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="Gold"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFilled}" Value="False">
                                                                        <Setter Property="Foreground" Value="Black"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy', Mode=OneWay}" Width="0.6*"/>
                        <DataGridTextColumn Header="Komentar" Binding="{Binding Comment, Mode=OneWay}" Width="2.2*"/>
                        <DataGridTextColumn Header="Prijave" Binding="{Binding ReportCount, Mode=OneWay}" Width="0.4*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="15,0,15,16" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Width="250" Height="44" Command="{Binding ReportSelectedReviewCommand}" IsEnabled="{Binding CanReportSelectedReview}" Padding="0" Style="{StaticResource PrimaryButton}"
                        ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ReportTooltip}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center">Prijavi recenziju<LineBreak/>(Ctrl + 1)</TextBlock>
                    </Button>

                    <Button Grid.Column="2" Width="250" Height="44" Command="{Binding WriteNewReviewCommand}" IsEnabled="{Binding CanWriteNewReview}" Padding="0" Style="{StaticResource PrimaryButton}"
                        ToolTipService.InitialShowDelay="150" ToolTipService.BetweenShowDelay="0" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding WriteReviewTooltip}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center">Napišite novu recenziju<LineBreak/>(Ctrl + 2)</TextBlock>
                    </Button>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,2,0,0" Padding="5,2,5,2" Background="{StaticResource AccentBrush}" Height="24">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Listaj recenzije - Strelice gore/dole" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,0,250,0"/>
                        <TextBlock Text="Zatvori - Esc" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="20,0,60,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
