<Page x:Class="CommunityHub.Ui.Views.Citizen.Neighborhoods.NeighborhoodsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Language="sr-Latn-RS"
      Title="Kvartovi">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="30,15,30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12" Height="34" Width="500" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox Style="{StaticResource SearchBarStyle}"/>
                <Button Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" Cursor="Hand">
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
            <Button Grid.Column="2" Content="Parametri pretrage (Ctrl+S)" Height="34" Style="{StaticResource CompactButton}" Click="SearchButton_Click" HorizontalAlignment="Stretch" Foreground="{StaticResource TextBrush}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="NeighborhoodsGrid" Grid.Column="0" AutoGenerateColumns="False" HeadersVisibility="Column" 
                      Style="{StaticResource PrimaryDataGrid}" ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}" RowStyle="{StaticResource DataGridRowStyle}" CellStyle="{StaticResource DataGridCellStyle}" IsReadOnly="True"
                      ItemsSource="{Binding Neighborhoods}"
                      SelectedItem="{Binding SelectedNeighborhood}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Naziv kvarta" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="Grad" Binding="{Binding City.Name, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="Država" Binding="{Binding Country.Name, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource TextBrush}" BorderThickness="2" Background="{StaticResource AlternatingRowBrush}" Padding="16">
                    <Grid>
                        <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center"
                                    Visibility="{Binding SelectedNeighborhood, Converter={StaticResource NullToVisibility}}">
                            <TextBlock TextAlignment="Center" FontSize="18" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                Pritisnite Ctrl+S da pretražite kvartove. Izaberite željeni kvart klikom miša ili koristeći strelice gore/dole.

                                Detalji o izabranom kvartu biće prikazani ovde.
                            </TextBlock>
                        </StackPanel>

                        <StackPanel x:Name="DetailsPanel"
                                    Visibility="{Binding SelectedNeighborhood, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding SelectedNeighborhood.Name, TargetNullValue=''}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" Opacity="0.7">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}, {1}">
                                                <Binding Path="SelectedNeighborhood.City.Name" TargetNullValue="" />
                                                <Binding Path="SelectedNeighborhood.Country.Name" TargetNullValue="" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedNeighborhood.Description, TargetNullValue=''}" FontSize="16" TextWrapping="Wrap" MinHeight="80" Margin="0,0,0,12" Foreground="{StaticResource TextBrush}" />

                                    <TextBlock Text="Ulice:" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                                    <ListBox ItemsSource="{Binding SelectedNeighborhood.StreetSections}" MinHeight="275" Style="{StaticResource PrimaryListBox}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} {1}-{2}">
                                                            <Binding Path="Street.Name" />
                                                            <Binding Path="StartNumber" />
                                                            <Binding Path="EndNumber" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <ItemsControl ItemsSource="{Binding SelectedNeighborhood.Images}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Path}" Width="240" Height="140" Margin="0,0,0,12" Stretch="UniformToFill">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,240,140" RadiusX="8" RadiusY="8" />
                                                    </Image.Clip>
                                                </Image>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="RequestAccessButton" Grid.Column="0" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Click="RequestAccessButton_Click"
                            Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">Zahtev za pristup kvartu<LineBreak/>(Ctrl + 1)</TextBlock>
                    </Button>

                    <Button x:Name="CoordinatorButton" Grid.Column="0" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding Membership, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">Koordinator mog kvarta<LineBreak/>(Ctrl + 1)</TextBlock>
                    </Button>
                    <Button Grid.Column="2" Height="52" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Click="MyAccessRequestsButton_Click">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13">
                            Moji zahtevi za pristup<LineBreak/>(Ctrl + 2)
                        </TextBlock>
                    </Button>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Page>
