<Window x:Class="CommunityHub.Ui.Views.Citizen.Neighborhoods.SearchCriteriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="420" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Language="sr-Latn-RS">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding ClearCommand}" />
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="15,6,15,6" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,0,0,2" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Parametri pretrage" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="32" Height="32" Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Naziv kvarta:" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                <TextBox x:Name="NameTextBox" Grid.Row="0" Grid.Column="2" Height="40" FontSize="14" Padding="8,6" VerticalContentAlignment="Center" Text="{Binding NameFilter}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2" CaretBrush="{StaticResource TextBrush}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Adresa:" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                <TextBox x:Name="AddressTextBox" Grid.Row="2" Grid.Column="2" Height="40" FontSize="14" Padding="8,6" VerticalContentAlignment="Center" Text="{Binding AddressFilter}" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2" CaretBrush="{StaticResource TextBrush}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Država:" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                <Button x:Name="SelectCountryButton" Grid.Row="4" Grid.Column="2" Height="40" FontSize="14" Padding="8,6" Click="SelectCountryButton_Click" Content="{Binding CountryButtonContent}" Style="{StaticResource PrimaryButton}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Grad:" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                <Button x:Name="SelectCityButton" Grid.Row="6" Grid.Column="2" Height="40" FontSize="14" Padding="8,6" Click="SelectCityButton_Click" Content="{Binding CityButtonContent}" IsEnabled="{Binding IsCityEnabled}" Style="{StaticResource PrimaryButton}"/>

                <Grid Grid.Row="8" Grid.ColumnSpan="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Height="44" Command="{Binding CancelCommand}" Style="{StaticResource PrimaryButton}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">Otkaži<LineBreak/>(Esc)</TextBlock>
                    </Button>
                    <Button Grid.Column="2" Height="44" Command="{Binding ClearCommand}" Style="{StaticResource PrimaryButton}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">Očisti<LineBreak/>(Ctrl+X)</TextBlock>
                    </Button>
                    <Button Grid.Column="4" Height="44" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">Potvrdi<LineBreak/>(Enter)</TextBlock>
                    </Button>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,2,0,0" Padding="5,2,5,2" Background="{StaticResource AccentBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Promeni selekciju - Tab" VerticalAlignment="Center" Margin="0,0,100,0" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Biraj grad/državu - Space" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
