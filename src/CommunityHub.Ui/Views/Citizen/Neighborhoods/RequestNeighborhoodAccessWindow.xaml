<Window x:Class="CommunityHub.Ui.Views.Citizen.Neighborhoods.RequestNeighborhoodAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="280" Width="580" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles/CitizenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource TextBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="15,6,15,6" BorderBrush="{StaticResource TextBrush}" BorderThickness="0,0,0,2" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Zahtev za pristup kvartu" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="32" Height="32" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41Z" Fill="{StaticResource TextBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="18" TextAlignment="Center" Foreground="{StaticResource TextBrush}">
                    <Run Text="Da li ste sigurni da želite da pošaljete zahtev za pristup kvartu" />
                    <LineBreak />
                    <Run Text="{Binding NeighborhoodName, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="?" />
                    <LineBreak />
                    <Run Text="Ako je vaša adresa u kvartu, automatski ćete se pridružiti. U suprotnom, status zahteva možete proveriti u sekciji 'Moji zahtevi za pristup'." />
                </TextBlock>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Click="Cancel_Click" IsCancel="True" Foreground="{StaticResource TextBrush}" Margin="0,0,4,0" Padding="12,14">
                        <TextBlock TextAlignment="Center">Otkaži zahtev</TextBlock>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" IsDefault="True" Foreground="{StaticResource TextBrush}" Margin="4,0,0,0" Padding="12,14">
                        <TextBlock TextAlignment="Center">Potvrdi zahtev</TextBlock>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
