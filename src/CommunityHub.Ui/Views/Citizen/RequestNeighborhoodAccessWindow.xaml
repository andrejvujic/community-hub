<Window x:Class="CommunityHub.Ui.Views.Citizen.RequestNeighborhoodAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zahtev za pristup kvartu" Height="220" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="SingleBorderWindow">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" TextAlignment="Center">
            <Run Text="Zahtev za pristup kvartu - " />
            <Run Text="{Binding NeighborhoodName, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="6" FontSize="13" TextAlignment="Center">
            <Run Text="Da li ste sigurni da želite da pošaljete zahtev za pristup kvartu " />
            <Run Text="{Binding NeighborhoodName, Mode=OneWay}" FontWeight="Bold" />
            <Run Text="?" />
            <LineBreak />
            <Run Text="Ako je vaša adresa u kvartu, automatski ćete se pridružiti. U suprotnom, status zahteva možete proveriti u sekciji 'Moji zahtevi za pristup'." />
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Width="180" Height="44" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                    Otkaži zahtev<LineBreak/>(Esc)
                </TextBlock>
            </Button>
            <Button Width="180" Height="44" Click="Confirm_Click" IsDefault="True">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                    Potvrdi zahtev<LineBreak/>(Enter)
                </TextBlock>
            </Button>
        </StackPanel>
    </Grid>
</Window>
