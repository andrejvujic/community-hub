<Window
    x:Class="CommunityHub.Ui.Views.LogInForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Prijava"
    Width="300"
    Height="400"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,5"
            FontSize="14"
            Text="Korisničko ime:" />
        <TextBox
            x:Name="UsernameTextBox"
            Grid.Row="0"
            Margin="0,30,0,0"
            Padding="5"
            FontSize="14" />

        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,5"
            FontSize="14"
            Text="Lozinka:" />
        <PasswordBox
            x:Name="PasswordBox"
            Grid.Row="2"
            Margin="0,30,0,0"
            Padding="5"
            FontSize="14" />

        <TextBlock
            x:Name="ErrorMessageTextBlock"
            Grid.Row="4"
            FontSize="12"
            Foreground="Red"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <Button
            Grid.Row="6"
            Padding="6"
            Click="LoginButton_Click"
            Content="Prijavi se"
            FontSize="14" />
    </Grid>
</Window>
