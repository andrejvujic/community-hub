<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.BuildingResident.SearchBuildingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingResident"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      mc:Ignorable="d" 
      Title="Pretraživanje zgrada"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigatorConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </navigation:MainNavigatorConsumerPage.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#dedede">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                MouseLeftButtonDown="BackButton_Click"
                Background="Transparent">
                <TextBlock
                    Text="&#xf177;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Column="1">
                <TextBlock
                    Text="Pretraživanje zgrada"
                    FontSize="20"
                    VerticalAlignment="Center"/>
            </Grid>

            <Grid
                Grid.Column="2"
                MouseLeftButtonDown="SearchButton_Click"
                Background="Transparent">
                <TextBlock
                    Text="&#xf002;"
                    FontSize="24"
                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="MainContent" Visibility="Hidden" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="{Binding Buildings.Count}" ContentStringFormat="Broj rezultata — {0}"  VerticalContentAlignment="Center" FontSize="18"/>
                        <Button
                            x:Name="ResetSearchButton"
                            Content="Poništi pretragu"
                            Height="48"
                            Padding="8"
                            Grid.Column="2"
                            FontSize="16"
                            Click="ResetSearchButton_Click"
                        />
                    </Grid>
                    
                    <Separator Grid.Row="2"/>
                </Grid>

                <ScrollViewer x:Name="BuildingsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BuildingsItemsControl" ItemsSource="{Binding Buildings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                     Padding="8"
                                     Margin="0,0,0,8"
                                     Background="#dedede"
                                     BorderBrush="Gray"
                                     BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- size of cover image: 144 -->
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Image
                                            Grid.Row="0"
                                            Source="{Binding CoverImage.Path}"
                                            Height="144"
                                            Stretch="UniformToFill"
                                            Visibility="{Binding HasImages, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        />

                                        <StackPanel Grid.Row="2">
                                            <TextBlock
                                                 FontSize="18"
                                                 FontWeight="Bold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Address.Street.Name"/>
                                                        <Binding Path="Address.StreetNumber"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <Separator Opacity="0" Height="2"/>

                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Text="&#xf64f;"
                                                        Foreground="#4a4a4a"
                                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Margin="0,0,4,0"
                                                        Padding="0"/>

                                                    <TextBlock                                                
                                                         Foreground="#4a4a4a"
                                                         FontSize="14">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}, {1}">
                                                                <Binding Path="Address.City.Name"/>
                                                                <Binding Path="Address.Country.Name"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Separator Opacity="0" Width="8"/>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        Text="&#xf3c5;"
                                                        Foreground="#4a4a4a"
                                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                        VerticalAlignment="Center"
                                                        FontSize="16"
                                                        Margin="0,0,4,0"
                                                        Padding="0"/>
                                                    <TextBlock
                                                         Foreground="#4a4a4a"
                                                         Text="{Binding Address.Neighborhood}"
                                                         FontSize="14"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                Background="#ffffff"
                                                Height="48"
                                                Padding="8"
                                                Grid.Column="0" 
                                                FontSize="16"
                                                Content="Prikaži detalje"
                                                Click="ShowBuildingDetails_Click"/>

                                            <Button
                                                Background="#ffffff"
                                                Height="48"
                                                Padding="8"
                                                Grid.Column="2"
                                                FontSize="16"
                                                Content="Pridruži se"/>
                                        </Grid>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="EmptyContent" Visibility="Hidden" Margin="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="{Binding Buildings.Count}" ContentStringFormat="Broj rezultata — {0}"  VerticalContentAlignment="Center" FontSize="18"/>
                                <Button
                                    Content="Poništi pretragu"
                                    Height="48"
                                    Padding="8"
                                    Grid.Column="2"
                                    FontSize="16"
                                    Click="ResetSearchButton_Click"
                                />
                            </Grid>

                            <Separator Grid.Row="2"/>
                        </Grid>
                    </Grid>

                    <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="Nema rezultata" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock
                             Text="Ne postoji nijedna zgrada koja odgovara zadanom kriterijumu pretrage. Provjerite zadani kriterijum i pokušajte ponovo."
                             TextWrapping="Wrap" 
                             TextAlignment="Center"
                             FontSize="16"
                             HorizontalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigatorConsumerPage>
