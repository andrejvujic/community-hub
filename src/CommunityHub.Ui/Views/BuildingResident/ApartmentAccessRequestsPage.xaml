<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.BuildingResident.ApartmentAccessRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingResident"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Helpers.Converters"
      mc:Ignorable="d" 
      Title="Zahtjevi"
      FontFamily="{StaticResource AppFontFamily}">
    <navigation:MainNavigatorConsumerPage.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:StatusToStringConverter x:Key="StatusToStringConverter"/>
    </navigation:MainNavigatorConsumerPage.Resources>
    <Grid>
        <Grid x:Name="MainContent" Visibility="{Binding HasRequests, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Moji zahtjevi" FontSize="20"/>
            <Separator Grid.Row="1"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl x:Name="RequestsItemsControl" ItemsSource="{Binding Requests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="8"
                                Margin="0,0,0,8"
                                Background="#dedede"
                                BorderBrush="Gray"
                                BorderThickness="1">
                                <Grid Background="Transparent" MouseLeftButtonDown="OpenRequestDetailsPageButton_Click"> 
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="Bold">

                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="Apartment.Building.Address.Street.Name"/>
                                                    <Binding Path="Apartment.Building.Address.StreetNumber"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <Separator Opacity="0" Height="2"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                               Text="&#xf133;"
                                               Foreground="#4a4a4a"
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Margin="0,0,8,0"
                                               Padding="0"/>
                                            <TextBlock
                                                Text="{Binding CreationDate, StringFormat='{}{0:d. MMMM yyyy.}', ConverterCulture=sr-Latn-RS}"
                                                Foreground="#4a4a4a"
                                                FontSize="14"/>
                                        </StackPanel>

                                        <Separator Opacity="0" Height="2"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                               Text="&#xf52a;"
                                               Foreground="#4a4a4a"
                                               FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Margin="0,0,8,0"
                                               Padding="0"/>
                                            <TextBlock
                                                Foreground="#4a4a4a"
                                                Text="{Binding Apartment.Number, StringFormat='Stan broj {0}'}"
                                                FontSize="14"/>
                                        </StackPanel>

                                        <Separator Opacity="0" Height="2"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                 Text="&#xf017;"
                                                 FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                                 VerticalAlignment="Center"
                                                 FontSize="16"
                                                 Margin="0,0,8,0"
                                                 Padding="0"/>
                                            <TextBlock
                                                Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                                FontSize="14"
                                                FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="&#xf178;"
                                        FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                        VerticalAlignment="Center"
                                        FontSize="24"
                                        Margin="0,0,8,0"
                                        Padding="0"/>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="EmptyContent" Visibility="{Binding HasRequests, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="8">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="Moji zahtjevi" FontSize="20"/>
                    <Separator Grid.Row="1"/>
                </Grid>
                
                <StackPanel Margin="32, 0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Nemate nijedan zahtjev" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock
                        Text="Još uvijek niste podnijeli zahtjev za pridruživanje nekoj zgradi."
                        TextWrapping="Wrap" 
                        TextAlignment="Center"
                        FontSize="16"
                        HorizontalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</navigation:MainNavigatorConsumerPage>
