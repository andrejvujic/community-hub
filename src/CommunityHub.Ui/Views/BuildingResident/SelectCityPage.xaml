<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.BuildingResident.SelectCityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingResident"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      mc:Ignorable="d" 
      Title="Izaberite grad"
      FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#dedede">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                 Grid.Column="0"
                 MouseLeftButtonDown="BackButton_Click"
                 Background="Transparent">
                <TextBlock
                     Text="&#xf177;"
                     FontSize="24"
                     FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Column="1">
                <TextBlock
                     Text="Biranje grada"
                     FontSize="20"
                     VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Pretraži gradove..." FontSize="18"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Height="48"
                        Padding="4"
                        FontSize="16"
                        Text="{Binding SearchText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="CitySearchTextBox_TextChanged"
                        VerticalContentAlignment="Center"/>

                    <Grid
                        Grid.Column="1"
                        MouseLeftButtonDown="SearchButton_Click"
                        Background="Transparent">
                        <TextBlock
                            Text="&#xf002;"
                            FontSize="24"
                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>

            <Separator Grid.Row="2"/>

            <Grid Grid.Row="4">
                <ScrollViewer x:Name="MainContent" Visibility="Hidden" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CitiesItemsControl" ItemsSource="{Binding Cities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8"
                                    Background="#dedede"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Margin="0,0,0,8">
                                    <Grid Height="48" MouseLeftButtonDown="CityItem_Click" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding Name}"
                                            FontSize="18"
                                            VerticalAlignment="Center"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="&#xf178;"
                                            FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Margin="0,0,8,0"
                                            Padding="0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid x:Name="EmptyContent" Visibility="Hidden" Margin="8">
                    <StackPanel Margin="32,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label Content="Nema rezultata" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock
                            Text="Ne postoji nijedan grad koji odgovara zadanom kriterijumu pretrage. Provjerite zadani kriterijum i pokušajte ponovo."
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            FontSize="16"
                            HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigatorConsumerPage>