<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.BuildingResident.CreateApartmentAccessRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingResident"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      mc:Ignorable="d" 
      Title="Podnošenje zahtjeva"
      FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#dedede">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid
                     Grid.Column="0"
                     MouseLeftButtonDown="BackButton_Click"
                     Background="Transparent">
                    <TextBlock
                         Text="&#xf177;"
                         FontSize="24"
                         FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                </Grid>

                <TextBlock
                     Grid.Column="1"
                     Text="Podnošenje zahtjeva"
                     FontSize="20"
                     VerticalAlignment="Center">
                </TextBlock>
            </Grid>

            <Grid Grid.Row="1" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="20" Padding="4" VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="Zahtjev za pridruživanje zgradi"/>
                    <Run FontWeight="Bold">
                        <Run.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Building.Address.Street.Name" Mode="OneWay"/>
                                <Binding Path="Building.Address.StreetNumber" Mode="OneWay"/>
                            </MultiBinding>
                        </Run.Text>
                    </Run>
                </TextBlock>

                <Separator Grid.Row="2"/>

                <Label Content="Broj stana" FontSize="18" Grid.Row="4"/>
                <TextBox
                    x:Name="ApartmentNumberTextBox"
                    TextChanged="ApartmentNumberTextBox_TextChanged"
                    Height="48"
                    FontSize="16"
                    Text="{Binding ApartmentNumberText, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center"
                    Padding="4"
                    Grid.Row="5"/>

                <Grid Grid.Row="7">
                    <TextBlock
                        x:Name="ApartmentNumberInvalidError"
                        Visibility="Collapsed"
                        Foreground="#4a4a4a"
                        FontSize="16"
                        TextWrapping="Wrap">
                    <Run Text="&#xf071;" FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"/>
                    <Run Text="Uneseni broj stana nije ispravan. Provjerite Vaš unos i pokušajte ponovo."/>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>

        <Button
            Click="CreateRequestButton_Click"
            IsEnabled="{Binding IsApartmentNumberValid}"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Content="Podnesi zahtjev"
            FontSize="18"
            Width="192"
            Height="72"/>

        <Grid
            x:Name="ApartmentDoesntExistAlert"
            Background="#bb000000"
            Visibility="Collapsed">

            <Grid
                Background="White"
                Margin="16"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                        Grid.Row="0"
                        FontSize="18"
                        Margin="8,8,8,0"
                        TextWrapping="Wrap">
                            <Run Text="&#xf071;" FontSize="16" FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"/>
                            <Run Text="Stan sa brojem"/>
                            <Run FontWeight="Bold" Text="{Binding ApartmentNumber, Mode=OneWay}" />
                            <Run Text="ne postoji u zgradi"/>
                            <Run FontWeight="Bold">
                                <Run.Text>
                                    <MultiBinding StringFormat="{}{0} {1}.">
                                        <Binding Path="Building.Address.Street.Name" Mode="OneWay"/>
                                        <Binding Path="Building.Address.StreetNumber" Mode="OneWay"/>
                                    </MultiBinding>
                                </Run.Text>
                            </Run>
                        <Run Text="Provjerite Vaš unos i pokušajte ponovo."/>
                </TextBlock>

                <Button
                    Grid.Row="2"
                    Click="CloseApartmentDoesntExistAlertButton_Click"
                    IsEnabled="{Binding IsApartmentNumberValid}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="8,0,8,8"
                    Content="U redu"
                    FontSize="18"
                    Width="192"
                    Height="36"/>
            </Grid>
        </Grid>

        <Grid
            x:Name="ApartmentOccupiedAlert"
            Background="#bb000000"
            Visibility="Collapsed">
            <Grid
                Background="White"
                Margin="16"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    FontSize="18"
                    Margin="8,8,8,0"
                    TextWrapping="Wrap">
                            <Run Text="&#xf071;" FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"/>
                            <Run Text="Da li ste sigurni da ste unijeli ispravan broj stana? Već postoji član koji je pridružen stanu broj"/>
                            <Run FontWeight="Bold" Text="{Binding ApartmentNumber, Mode=OneWay}" />
                            <Run Text="u zgradi"/>
                            <Run FontWeight="Bold">
                                <Run.Text>
                                    <MultiBinding StringFormat="{}{0} {1}.">
                                        <Binding Path="Building.Address.Street.Name" Mode="OneWay"/>
                                        <Binding Path="Building.Address.StreetNumber" Mode="OneWay"/>
                                    </MultiBinding>
                                </Run.Text>
                            </Run>
                </TextBlock>


                <Button
                    Grid.Row="2"
                    Click="CloseApartmentOccupiedAlertButton_Click"
                    IsEnabled="{Binding IsApartmentNumberValid}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="8,0,8,8"
                    Content="U redu"
                    FontSize="18"
                    Width="192"
                    Height="36"/>
            </Grid>
        </Grid>
    </Grid>
</navigation:MainNavigatorConsumerPage>
