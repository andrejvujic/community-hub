<navigation:MainNavigatorConsumerPage x:Class="CommunityHub.Ui.Views.BuildingResident.SelectCountryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CommunityHub.Ui.Views.BuildingResident"
      xmlns:navigation="clr-namespace:CommunityHub.Ui.Helpers.Navigation"
      mc:Ignorable="d" 
      Title="Izabrite državu"
      FontFamily="{StaticResource AppFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#dedede">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid
                 Grid.Column="0"
                 MouseLeftButtonDown="BackButton_Click"
                 Background="Transparent">
                <TextBlock
                     Text="&#xf177;"
                     FontSize="24"
                     FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            </Grid>

            <Grid
                Grid.Column="1">
                <TextBlock
                     Text="Biranje države"
                     FontSize="20"
                     VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8">
            <ItemsControl x:Name="CountriesItemsControl" ItemsSource="{Binding Countries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="8"
                            Background="#dedede"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Margin="0,0,0,8">
                            <Grid Height="48" MouseLeftButtonDown="CountryItem_Click" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding Name}"
                                        FontSize="18"
                                        VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="&#xf178;"
                                    FontFamily="/Resources/Fonts/Icons.otf#Font Awesome 7 Free"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Margin="0,0,8,0"
                                    Padding="0"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</navigation:MainNavigatorConsumerPage>
