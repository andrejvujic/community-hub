<Application
    x:Class="CommunityHub.Ui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    StartupUri="/Views/LogInForm.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFontFamily">
                /Resources/Fonts/GoogleSans.ttf#Google Sans
            </FontFamily>

            <FontFamily x:Key="InterFontFamily">/Resources/Inter/#Inter</FontFamily>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EBEBEB" />

            <SolidColorBrush x:Key="NavBarDefaultBackgroundBrush" Color="#0F5AA6" />
            <SolidColorBrush x:Key="NavBarDefaultForegroundBrush" Color="#F4F7FA" />

            <SolidColorBrush x:Key="NavBarHoverBackgroundBrush" Color="#DCE8D8" />
            <SolidColorBrush x:Key="NavBarHoverForegroundBrush" Color="#123B63" />

            <SolidColorBrush x:Key="SideBarDefaultBackgroundBrush" Color="#E8EEF5" />
            <SolidColorBrush x:Key="SideBarDefaultForegroundBrush" Color="#1E3A5F" />

            <SolidColorBrush x:Key="SideBarHoverBackgroundBrush" Color="#BAD7F5" />
            <SolidColorBrush x:Key="SideBarHoverForegroundBrush" Color="#0F3E7D" />

            <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#0F5AA6" />
            <SolidColorBrush x:Key="FooterForegroundBrush" Color="#F4F7FA" />

            <SolidColorBrush x:Key="ErrorMessageBrush" Color="#C43D5A" />
            <SolidColorBrush x:Key="PageTitleBrush" Color="#000000" />

            <!-- Resident area: calm neighborhood-inspired palette -->
            <Color x:Key="ResidentPageBackgroundColor">#F3F7F7</Color>
            <Color x:Key="ResidentCardBackgroundColor">#FFFFFF</Color>
            <Color x:Key="ResidentPrimaryColor">#147A7E</Color>
            <Color x:Key="ResidentPrimaryHoverColor">#106367</Color>
            <Color x:Key="ResidentPrimaryPressedColor">#0C5054</Color>
            <Color x:Key="ResidentSecondaryColor">#E4F0EF</Color>
            <Color x:Key="ResidentTextPrimaryColor">#17333D</Color>
            <Color x:Key="ResidentTextSecondaryColor">#526B73</Color>
            <Color x:Key="ResidentBorderColor">#CEDDDB</Color>
            <Color x:Key="ResidentDangerColor">#BF4554</Color>
            <Color x:Key="ResidentWarningColor">#B77718</Color>

            <SolidColorBrush x:Key="ResidentPageBackgroundBrush" Color="{StaticResource ResidentPageBackgroundColor}" />
            <SolidColorBrush x:Key="ResidentCardBackgroundBrush" Color="{StaticResource ResidentCardBackgroundColor}" />
            <SolidColorBrush x:Key="ResidentHeaderBackgroundBrush" Color="#E4F0EF" />
            <SolidColorBrush x:Key="ResidentNavigationBackgroundBrush" Color="#DFECEB" />
            <SolidColorBrush x:Key="ResidentSurfaceBrush" Color="#EDF4F3" />
            <SolidColorBrush x:Key="ResidentInputBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ResidentInputHoverBrush" Color="#E8F3F2" />
            <SolidColorBrush x:Key="ResidentPrimaryBrush" Color="{StaticResource ResidentPrimaryColor}" />
            <SolidColorBrush x:Key="ResidentPrimaryHoverBrush" Color="{StaticResource ResidentPrimaryHoverColor}" />
            <SolidColorBrush x:Key="ResidentPrimaryPressedBrush" Color="{StaticResource ResidentPrimaryPressedColor}" />
            <SolidColorBrush x:Key="ResidentOnPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ResidentSecondaryBrush" Color="{StaticResource ResidentSecondaryColor}" />
            <SolidColorBrush x:Key="ResidentSecondaryHoverBrush" Color="#D2E6E4" />
            <SolidColorBrush x:Key="ResidentTextPrimaryBrush" Color="{StaticResource ResidentTextPrimaryColor}" />
            <SolidColorBrush x:Key="ResidentTextSecondaryBrush" Color="{StaticResource ResidentTextSecondaryColor}" />
            <SolidColorBrush x:Key="ResidentBorderBrush" Color="{StaticResource ResidentBorderColor}" />
            <SolidColorBrush x:Key="ResidentDangerBrush" Color="{StaticResource ResidentDangerColor}" />
            <SolidColorBrush x:Key="ResidentDangerHoverBrush" Color="#A93847" />
            <SolidColorBrush x:Key="ResidentWarningBrush" Color="{StaticResource ResidentWarningColor}" />
            <SolidColorBrush x:Key="ResidentOverlayBrush" Color="#85182D36" />

            <Style x:Key="ResidentPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ResidentPrimaryBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ResidentOnPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ResidentPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ResidentButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ResidentButtonBorder" Property="Background" Value="{StaticResource ResidentPrimaryHoverBrush}" />
                                    <Setter TargetName="ResidentButtonBorder" Property="BorderBrush" Value="{StaticResource ResidentPrimaryHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ResidentButtonBorder" Property="Background" Value="{StaticResource ResidentPrimaryPressedBrush}" />
                                    <Setter TargetName="ResidentButtonBorder" Property="BorderBrush" Value="{StaticResource ResidentPrimaryPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.52" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ResidentSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ResidentSecondaryBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ResidentTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ResidentBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ResidentButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ResidentButtonBorder" Property="Background" Value="{StaticResource ResidentSecondaryHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.52" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ResidentDangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ResidentDangerBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ResidentOnPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ResidentDangerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ResidentButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ResidentButtonBorder" Property="Background" Value="{StaticResource ResidentDangerHoverBrush}" />
                                    <Setter TargetName="ResidentButtonBorder" Property="BorderBrush" Value="{StaticResource ResidentDangerHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.52" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/LightTheme.xaml" />
                <ResourceDictionary Source="/Resources/Styles/NeighborhoodListStyles.xaml" />
                <ResourceDictionary Source="/Resources/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/InputStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/TabControlStyles.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/DataGridStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
